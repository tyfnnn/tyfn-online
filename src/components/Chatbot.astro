---
import { useTranslations, type Lang } from '../i18n/t';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const webhookUrl = 'https://n8n.tyfn.online/webhook/tyfn-website-chatbot/chat';

const i18nStrings = {
  title: t('chat.title'),
  subtitle: t('chat.subtitle'),
  footer: t('chat.footer'),
  getStarted: t('chat.get_started'),
  inputPlaceholder: t('chat.input_placeholder'),
  closeButtonTooltip: t('chat.close_button_tooltip'),
};

const initialMessage = t('chat.initial_message');
---
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/@n8n/chat@0.45/dist/style.css"
/>

<style is:inline>
  /* Cosmetic-only customization. Library defaults handle all layout, flex,
     overflow, anchoring and scrolling. The only library-internal value we
     set explicitly is --chat--messages-list--padding (the library's own
     `padding: var(...)` rule has no fallback, so without this the bubbles
     flush to the panel edges). */
  #n8n-chat {
    --chat--color-primary: rgba(255, 255, 255, 0.95);
    --chat--color-primary-shade-50: rgba(220, 220, 220, 0.95);
    --chat--color-primary-shade-100: rgba(200, 200, 200, 0.95);
    --chat--color-secondary: rgba(255, 255, 255, 0.7);
    --chat--color-secondary-shade-50: rgba(255, 255, 255, 0.6);
    --chat--color-white: rgba(255, 255, 255, 0.95);
    --chat--color-light: rgba(255, 255, 255, 0.06);
    --chat--color-light-shade-50: rgba(255, 255, 255, 0.1);
    --chat--color-light-shade-100: rgba(255, 255, 255, 0.14);
    --chat--color-medium: rgba(255, 255, 255, 0.4);
    --chat--color-dark: rgba(20, 20, 20, 0.95);
    --chat--color-disabled: rgba(255, 255, 255, 0.3);
    --chat--color-typing: rgba(255, 255, 255, 0.6);

    --chat--toggle--width: 56px;
    --chat--toggle--height: 56px;
    --chat--toggle--background: transparent;
    --chat--toggle--hover--background: transparent;
    --chat--toggle--active--background: transparent;
    --chat--toggle--color: rgba(255, 255, 255, 0.9);

    --chat--header--background: transparent;
    --chat--header--color: rgba(255, 255, 255, 0.95);
    --chat--header--border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    --chat--heading--font-size: 1rem;
    --chat--subtitle--font-size: 0.8125rem;
    --chat--subtitle--line-height: 1.45;

    --chat--body--background: transparent;
    --chat--footer--background: transparent;
    --chat--footer--color: rgba(255, 255, 255, 0.7);

    --chat--input--background: rgba(255, 255, 255, 0.06);
    --chat--input--text-color: rgba(255, 255, 255, 0.95);
    --chat--input--border: 1px solid rgba(255, 255, 255, 0.12);
    --chat--input--border-active: 1px solid rgba(255, 255, 255, 0.25);
    --chat--input--border-radius: 12px;
    --chat--input--placeholder--font-color: rgba(255, 255, 255, 0.4);
    --chat--input--send--button--background: rgba(255, 255, 255, 0.95);
    --chat--input--send--button--color: rgba(20, 20, 20, 0.95);
    --chat--input--send--button--background-hover: rgba(255, 255, 255, 1);
    --chat--input--send--button--color-hover: rgba(20, 20, 20, 1);

    --chat--message--bot--background: rgba(255, 255, 255, 0.08);
    --chat--message--bot--color: rgba(255, 255, 255, 0.95);
    --chat--message--bot--border: 1px solid rgba(255, 255, 255, 0.1);
    --chat--message--user--background: rgba(255, 255, 255, 0.95);
    --chat--message--user--color: rgba(20, 20, 20, 0.95);
    --chat--message--user--border: none;

    /* The one layout var that's required: the library writes
       `padding: var(--chat--messages-list--padding)` with no fallback,
       so bubbles touch the panel edges if we don't set this. */
    --chat--messages-list--padding: 1rem;

    /* Fixed panel width; height clamped against the viewport so the
       wrapper stack (window + toggle + margin + bottom-anchor) always
       fits. Without the clamp, on viewports below ~716px the window's
       top edge ends up above the viewport — header invisible, input
       seemingly mid-screen. */
    --chat--window--width: 380px;
    --chat--window--height: min(580px, calc(100vh - 9rem));

    --chat--font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  /* Cursor handling under the global cursor:none rule */
  #n8n-chat,
  #n8n-chat * { cursor: auto !important; }
  #n8n-chat button,
  #n8n-chat a,
  #n8n-chat [role="button"] { cursor: pointer !important; }
  #n8n-chat input,
  #n8n-chat textarea { cursor: text !important; }

  /* Wrapper position: bottom-left instead of bottom-right (FabMenu owns the
     right side). align-items: flex-start left-aligns the toggle and window
     inside the wrapper. The reveal animation lives here too — applying
     transform to the wrapper itself keeps `position: fixed` resolving to
     the viewport (transform on .chat-host would re-anchor the wrapper to
     the document end). */
  #n8n-chat .chat-window-wrapper {
    bottom: 4rem !important;
    left: 1.25rem !important;
    right: auto !important;
    align-items: flex-start !important;
    z-index: 9998;
    max-height: none !important;

    opacity: 0;
    transform: translateY(20px) scale(0.85);
    transform-origin: bottom left;
    pointer-events: none;
    transition:
      opacity 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  body.fabs-visible #n8n-chat .chat-window-wrapper {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* Toggle bubble — match FabMenu glass material */
  #n8n-chat .chat-window-wrapper .chat-window-toggle {
    margin-left: 0 !important;
    margin-right: auto !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.12) 0%,
      rgba(255, 255, 255, 0.04) 100%
    ) !important;
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 -1px 0 rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.9) !important;
    overflow: hidden;
    position: relative;
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.3s ease,
      background 0.3s ease !important;
  }
  #n8n-chat .chat-window-wrapper .chat-window-toggle::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.3) 0%,
      transparent 50%,
      rgba(255, 255, 255, 0.05) 100%
    );
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: xor;
    padding: 1px;
    pointer-events: none;
  }
  #n8n-chat .chat-window-wrapper .chat-window-toggle:hover {
    transform: scale(1.08) !important;
    border-color: rgba(255, 255, 255, 0.4) !important;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0.08) 100%
    ) !important;
  }
  #n8n-chat .chat-window-wrapper .chat-window-toggle:active {
    transform: scale(0.95) !important;
  }
  #n8n-chat .chat-window-wrapper .chat-window-toggle svg {
    width: 22px;
    height: 22px;
    color: rgba(255, 255, 255, 0.9);
  }

  /* Open chat panel — same glass material as the toggle. NO height /
     max-height / flex overrides: the library's own dimensions handle that. */
  #n8n-chat .chat-window-wrapper .chat-window {
    border: 1px solid rgba(255, 255, 255, 0.2) !important;
    border-radius: 18px !important;
    background: linear-gradient(
      160deg,
      rgba(20, 20, 20, 0.85) 0%,
      rgba(10, 10, 10, 0.92) 100%
    ) !important;
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    box-shadow:
      0 12px 48px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      inset 0 -1px 0 rgba(255, 255, 255, 0.05) !important;
    overflow: hidden;
    position: relative;
    /* Library default is `bottom right` (toggle is bottom-right). Our
       toggle is bottom-left, so the open/close scale animation should
       originate there. */
    transform-origin: bottom left !important;
  }
  #n8n-chat .chat-window-wrapper .chat-window::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 30% 20%,
      rgba(255, 255, 255, 0.06) 0%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 0;
  }
  #n8n-chat .chat-window-wrapper .chat-window > * {
    position: relative;
    z-index: 1;
  }

  /* Window / layout sizing — Grid replaces the library's three-level flex
     stretch chain (wrapper → window → layout → body), which was failing
     to propagate full height down to the body. With grid on chat-layout
     and a hard-pinned chat-window height, the body's row is arithmetic:
     window height − header auto − footer auto. No flex algorithm to
     misbehave, no min-height: 100px floor, no scroll-the-layout bug. */
  #n8n-chat .chat-window-wrapper .chat-window {
    /* No `display` override — Vue's v-show toggles inline `display: none`
       to close the panel; `!important` here would block that. */
    height: var(--chat--window--height) !important;
    min-height: var(--chat--window--height) !important;
    max-height: var(--chat--window--height) !important;
  }
  #n8n-chat .chat-window-wrapper .chat-window .chat-layout {
    display: grid !important;
    grid-template-rows: auto 1fr auto !important;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
    overscroll-behavior: contain;
  }
  #n8n-chat .chat-layout .chat-header,
  #n8n-chat .chat-layout .chat-footer {
    min-height: 0 !important;
  }
  #n8n-chat .chat-layout .chat-body {
    min-height: 0 !important;
    height: 100% !important;
    overflow-y: auto !important;
  }
  /* Footer breathing room — the library's default sits the textarea flush
     against the panel edges. */
  #n8n-chat .chat-layout .chat-footer {
    padding: 0.75rem 1rem 1rem !important;
  }

  /* Top-anchor the messages list. The library default is `margin-top: auto`
     (bottom-anchor), which makes the greeting move up by one bubble each
     time a message arrives — exactly the "shift" the user keeps seeing.
     Top-anchor pins the greeting at the top of the body permanently;
     new messages append below; the body's overflow-y handles the scroll
     once the conversation overflows. Same flow as Intercom / HubSpot. */
  #n8n-chat .chat-messages-list {
    margin-top: 0 !important;
  }

  /* Scrollbar styling on the body — pure cosmetic, no layout effect.
     Reserve gutter so the column doesn't jump left when the scrollbar
     first appears. */
  #n8n-chat .chat-body {
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
  }
  #n8n-chat .chat-body::-webkit-scrollbar { width: 6px; }
  #n8n-chat .chat-body::-webkit-scrollbar-track { background: transparent; }
  #n8n-chat .chat-body::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
  }
  #n8n-chat .chat-body::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  /* Header polish — title + subtitle + close button */
  #n8n-chat .chat-layout .chat-header h1,
  #n8n-chat .chat-heading > * {
    font-family: var(--chat--font-family) !important;
    font-weight: 600 !important;
    letter-spacing: 0.01em !important;
    color: rgba(255, 255, 255, 0.95) !important;
    margin: 0 !important;
  }
  #n8n-chat .chat-layout .chat-header p {
    color: rgba(255, 255, 255, 0.65) !important;
    margin: 0.25rem 0 0 !important;
  }
  #n8n-chat .chat-close-button {
    color: rgba(255, 255, 255, 0.7) !important;
    transition: color 0.2s ease, transform 0.2s ease !important;
  }
  #n8n-chat .chat-close-button:hover {
    color: rgba(255, 255, 255, 1) !important;
    transform: scale(1.1) !important;
  }

  /* Input field + send button polish */
  #n8n-chat .chat-inputs textarea {
    border-radius: 12px !important;
    transition: border-color 0.2s ease, background 0.2s ease !important;
  }
  #n8n-chat .chat-inputs textarea:focus,
  #n8n-chat .chat-inputs textarea:hover {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: rgba(255, 255, 255, 0.25) !important;
    outline: none !important;
  }
  #n8n-chat .chat-input-send-button {
    border-radius: 10px !important;
    margin-left: 0.5rem !important;
    transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease !important;
  }
  #n8n-chat .chat-input-send-button:not([disabled]):hover {
    transform: scale(1.05) !important;
  }

  @media (max-width: 479px) {
    #n8n-chat .chat-window-wrapper {
      bottom: 4.5rem !important;
      left: 0.75rem !important;
    }
    #n8n-chat {
      --chat--toggle--width: 48px;
      --chat--toggle--height: 48px;
      --chat--window--width: calc(100vw - 1.5rem);
      --chat--window--height: min(560px, calc(100vh - 9rem));
    }
    #n8n-chat .chat-window-wrapper .chat-window-toggle svg {
      width: 20px;
      height: 20px;
    }
  }
</style>

<div id="n8n-chat" class="chat-host"></div>

<script type="module" define:vars={{ webhookUrl, i18nStrings, initialMessage }}>
  import { createChat } from 'https://cdn.jsdelivr.net/npm/@n8n/chat@0.45/dist/chat.bundle.es.js';

  createChat({
    webhookUrl,
    target: '#n8n-chat',
    mode: 'window',
    showWelcomeScreen: false,
    defaultLanguage: 'en',
    initialMessages: [initialMessage],
    i18n: { en: i18nStrings },
  });

  /* Keep .chat-layout pinned at scrollTop=0 even if the library
     programmatically scrolls it. CSS `overflow: hidden` should already
     prevent this, but on some browsers `el.scrollTop = N` still works
     during the brief moment between message-DOM insertion and our CSS
     applying. A MutationObserver on the layout subtree resets it after
     every DOM mutation. */
  const host = document.getElementById('n8n-chat');
  if (host) {
    const pinScrollContainers = () => {
      const layout = host.querySelector('.chat-layout');
      const window_ = host.querySelector('.chat-window');
      if (layout && layout.scrollTop !== 0) layout.scrollTop = 0;
      if (window_ && window_.scrollTop !== 0) window_.scrollTop = 0;
    };
    const mo = new MutationObserver(pinScrollContainers);
    mo.observe(host, { childList: true, subtree: true });
    host.addEventListener('scroll', pinScrollContainers, true);
    host.addEventListener('focusin', pinScrollContainers, true);
  }
</script>

