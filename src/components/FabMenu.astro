---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/t';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const homeHref = getRelativeLocaleUrl(lang, '/');
const portfolioHref = getRelativeLocaleUrl(lang, '/portfolio/');
const blogHref = getRelativeLocaleUrl(lang, '/blog/');
---

<div class="fab-menu" id="fab-menu">
  <button class="fab-trigger" id="fab-trigger" type="button" aria-label="Navigation menu" aria-expanded="false">
    <svg class="fab-icon fab-icon--menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
    </svg>
    <svg class="fab-icon fab-icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="18" y1="6" x2="6" y2="18" />
    </svg>
  </button>

  <nav class="fab-panel" id="fab-panel" aria-hidden="true">
    <a href={homeHref} class="fab-link" data-fab-link>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l9-8 9 8"/><path d="M5 10v9a1 1 0 001 1h4v-5h4v5h4a1 1 0 001-1v-9"/></svg>
      <span>{t('fab.home')}</span>
    </a>
    <a href={portfolioHref} class="fab-link" data-fab-link>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 8h20"/><circle cx="6" cy="6" r=".5" fill="currentColor"/><circle cx="9" cy="6" r=".5" fill="currentColor"/></svg>
      <span>{t('fab.portfolio')}</span>
    </a>
    <a href={blogHref} class="fab-link" data-fab-link>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h12a4 4 0 014 4v12H8a4 4 0 01-4-4V4z"/><path d="M8 8h8"/><path d="M8 12h8"/><path d="M8 16h5"/></svg>
      <span>{t('fab.blog')}</span>
    </a>
    <a href={`${homeHref}#contact`} class="fab-link" data-fab-link>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 5H3a2 2 0 00-2 2v10a2 2 0 002 2h18a2 2 0 002-2V7a2 2 0 00-2-2z"/><path d="M1 7l10.4 6.5a1 1 0 001.2 0L23 7"/></svg>
      <span>{t('fab.contact')}</span>
    </a>
  </nav>
</div>

<style is:inline>
  .fab-menu {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transform: translateY(20px) scale(0.85);
    transform-origin: bottom right;
    transition:
      opacity 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  body.fabs-visible .fab-menu {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Liquid-Glass-Material: leerer ::before-Linsen-Layer mit
     backdrop-filter (Refraktion via #liquid-glass-filter) + die volle
     Box-Shadow-Stapelung aus dem Glass-Button-CodePen. Der Trigger selbst
     bleibt für Icons/Text zuständig. */
  .fab-trigger {
    --lg-light: 1;
    --lg-dark: 1;
    pointer-events: auto;
    position: relative;
    isolation: isolate;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: none;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: visible;
  }

  .fab-trigger::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background-color: rgba(230, 230, 221, 0.06);
    backdrop-filter: blur(8px) url(#liquid-glass-filter) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(180%);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, white calc(var(--lg-light) * 10%), transparent),
      inset 1.8px 3px 0px -2px color-mix(in srgb, white calc(var(--lg-light) * 90%), transparent),
      inset -2px -2px 0px -2px color-mix(in srgb, white calc(var(--lg-light) * 80%), transparent),
      inset -3px -8px 1px -6px color-mix(in srgb, white calc(var(--lg-light) * 60%), transparent),
      inset -0.3px -1px 4px 0px color-mix(in srgb, black calc(var(--lg-dark) * 12%), transparent),
      inset -1.5px 2.5px 0px -2px color-mix(in srgb, black calc(var(--lg-dark) * 20%), transparent),
      inset 0px 3px 4px -2px color-mix(in srgb, black calc(var(--lg-dark) * 20%), transparent),
      inset 2px -6.5px 1px -4px color-mix(in srgb, black calc(var(--lg-dark) * 10%), transparent),
      0px 1px 5px 0px color-mix(in srgb, black calc(var(--lg-dark) * 10%), transparent),
      0px 6px 16px 0px color-mix(in srgb, black calc(var(--lg-dark) * 8%), transparent);
    transition:
      background-color 400ms cubic-bezier(1, 0, 0.4, 1),
      box-shadow 400ms cubic-bezier(1, 0, 0.4, 1);
  }

  .fab-trigger:hover {
    transform: scale(1.08);
  }
  .fab-trigger:hover::before {
    --lg-light: 1.2;
    background-color: rgba(230, 230, 221, 0.1);
  }

  .fab-trigger:active {
    transform: scale(0.95);
  }

  .fab-icon {
    width: 22px;
    height: 22px;
    transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: absolute;
  }

  .fab-icon--menu {
    opacity: 1;
    transform: rotate(0deg);
  }

  .fab-icon--close {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .fab-menu.is-open .fab-icon--menu {
    opacity: 0;
    transform: rotate(90deg);
  }

  .fab-menu.is-open .fab-icon--close {
    opacity: 1;
    transform: rotate(0deg);
  }

  /* Panel selbst: trägt die Glas-Refraktion (backdrop-filter) und die
     äußere Drop-Shadow. `overflow: hidden` clippt nur die Kinder am
     border-radius – die outer box-shadow bleibt sichtbar, weil sie
     außerhalb der Box gezeichnet wird. */
  .fab-panel {
    --lg-light: 1;
    --lg-dark: 1;
    pointer-events: none;
    position: absolute;
    isolation: isolate;
    bottom: calc(100% + 0.75rem);
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-radius: 18px;
    border: 0;
    background-color: rgba(20, 20, 20, 0.22);
    backdrop-filter: blur(14px) url(#liquid-glass-filter-soft) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    padding: 8px;
    box-shadow:
      /* heller Top-/Linken-Rand des Glases */
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 1px 0 0 rgba(255, 255, 255, 0.18),
      /* dunkler Bottom-/Right-Rand für die Refraktions-Tiefe */
      inset 0 -1px 0 rgba(0, 0, 0, 0.35),
      inset -1px 0 0 rgba(0, 0, 0, 0.18),
      /* feiner Außenkanten-Highlight */
      0 0 0 1px rgba(255, 255, 255, 0.12),
      /* schwebender Schatten */
      0 1px 5px rgba(0, 0, 0, 0.18),
      0 18px 48px rgba(0, 0, 0, 0.42);
    opacity: 0;
    transform: translateY(12px) scale(0.92);
    transition: opacity 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
  }

  /* Glanz-Bogen oben links – das "wet glass"-Highlight.
     ::before steht im Stacking unter den Kindern (fab-link), bleibt also
     hinter den Klick-Targets, deckt aber die backdrop-filter-Refraktion mit
     einem zusätzlichen Lichtbogen oben. */
  .fab-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(
        140% 70% at 20% 0%,
        rgba(255, 255, 255, 0.22) 0%,
        rgba(255, 255, 255, 0.05) 35%,
        transparent 70%
      ),
      radial-gradient(
        ellipse at 30% 20%,
        rgba(255, 255, 255, 0.06) 0%,
        transparent 60%
      );
  }
  .fab-panel > * {
    position: relative;
    z-index: 1;
  }

  .fab-menu.is-open .fab-panel {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .fab-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px 12px 16px;
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: background 0.2s ease, color 0.15s ease;
    position: relative;
    white-space: nowrap;
  }

  .fab-link:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .fab-link svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .fab-link:hover svg {
    opacity: 1;
  }

  .fab-link span {
    transition: transform 0.2s ease;
  }

  .fab-link:hover span {
    transform: translateX(2px);
  }

  @media (max-width: 479px) {
    .fab-menu {
      bottom: 0.75rem;
      right: 0.75rem;
    }
    .fab-trigger {
      width: 48px;
      height: 48px;
    }
    .fab-icon {
      width: 20px;
      height: 20px;
    }
    .fab-link {
      padding: 10px 16px 10px 14px;
      font-size: 13px;
    }
  }
</style>

<script is:inline>
  (function () {
    // Sichtbarkeit der FABs an Scrollposition koppeln:
    // versteckt am Seitenanfang und am Seitenende,
    // sichtbar im mittleren Bereich.
    var topThreshold = 80;
    var bottomThreshold = 120;
    var body = document.body;
    function syncFabs() {
      var y = window.scrollY || window.pageYOffset || 0;
      var viewport = window.innerHeight || document.documentElement.clientHeight;
      var docHeight = Math.max(
        document.body.scrollHeight,
        document.documentElement.scrollHeight,
        document.body.offsetHeight,
        document.documentElement.offsetHeight
      );
      var distanceToBottom = docHeight - (y + viewport);
      var visible = y > topThreshold && distanceToBottom > bottomThreshold;
      body.classList.toggle('fabs-visible', visible);
    }
    syncFabs();
    window.addEventListener('scroll', syncFabs, { passive: true });
    window.addEventListener('resize', syncFabs, { passive: true });

    var menu = document.getElementById('fab-menu');
    var trigger = document.getElementById('fab-trigger');
    var panel = document.getElementById('fab-panel');
    if (!menu || !trigger || !panel) return;

    trigger.addEventListener('click', function () {
      var open = menu.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
    });

    var links = panel.querySelectorAll('[data-fab-link]');
    for (var i = 0; i < links.length; i++) {
      links[i].addEventListener('click', function () {
        menu.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
      });
    }

    document.addEventListener('click', function (e) {
      if (!menu.contains(e.target)) {
        menu.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        menu.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
        trigger.focus();
      }
    });
  })();
</script>
