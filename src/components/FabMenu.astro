---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/t';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const homeHref = getRelativeLocaleUrl(lang, '/');
const portfolioHref = getRelativeLocaleUrl(lang, '/portfolio/');
---

<div class="fab-menu" id="fab-menu">
  <button class="fab-trigger" id="fab-trigger" type="button" aria-label="Navigation menu" aria-expanded="false">
    <svg class="fab-icon fab-icon--menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
    </svg>
    <svg class="fab-icon fab-icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="18" y1="6" x2="6" y2="18" />
    </svg>
  </button>

  <nav class="fab-panel" id="fab-panel" aria-hidden="true">
    <a href={homeHref} class="fab-link" data-fab-link>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l9-8 9 8"/><path d="M5 10v9a1 1 0 001 1h4v-5h4v5h4a1 1 0 001-1v-9"/></svg>
      <span>{t('fab.home')}</span>
    </a>
    <a href={`${homeHref}#about`} class="fab-link" data-fab-link>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5 20c0-3.87 3.13-7 7-7s7 3.13 7 7"/></svg>
      <span>{t('fab.about')}</span>
    </a>
    <a href={`${homeHref}#projects`} class="fab-link" data-fab-link>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      <span>{t('fab.projects')}</span>
    </a>
    <a href={portfolioHref} class="fab-link" data-fab-link>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 8h20"/><circle cx="6" cy="6" r=".5" fill="currentColor"/><circle cx="9" cy="6" r=".5" fill="currentColor"/></svg>
      <span>{t('fab.portfolio')}</span>
    </a>
    <a href={`${homeHref}#process`} class="fab-link" data-fab-link>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>
      <span>{t('fab.process')}</span>
    </a>
    <a href={`${homeHref}#contact`} class="fab-link" data-fab-link>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 5H3a2 2 0 00-2 2v10a2 2 0 002 2h18a2 2 0 002-2V7a2 2 0 00-2-2z"/><path d="M1 7l10.4 6.5a1 1 0 001.2 0L23 7"/></svg>
      <span>{t('fab.contact')}</span>
    </a>
  </nav>
</div>

<style is:inline>
  .fab-menu {
    position: fixed;
    bottom: 4rem;
    right: 1.25rem;
    z-index: 9999;
    pointer-events: none;
  }

  .fab-trigger {
    pointer-events: auto;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.12) 0%,
      rgba(255, 255, 255, 0.04) 100%
    );
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 -1px 0 rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: none;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
                border-color 0.3s ease,
                background 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .fab-trigger::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.3) 0%,
      transparent 50%,
      rgba(255, 255, 255, 0.05) 100%
    );
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: xor;
    padding: 1px;
    pointer-events: none;
  }

  .fab-trigger:hover {
    transform: scale(1.08);
    border-color: rgba(255, 255, 255, 0.4);
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.18) 0%,
      rgba(255, 255, 255, 0.08) 100%
    );
  }

  .fab-trigger:active {
    transform: scale(0.95);
  }

  .fab-icon {
    width: 22px;
    height: 22px;
    transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: absolute;
  }

  .fab-icon--menu {
    opacity: 1;
    transform: rotate(0deg);
  }

  .fab-icon--close {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .fab-menu.is-open .fab-icon--menu {
    opacity: 0;
    transform: rotate(90deg);
  }

  .fab-menu.is-open .fab-icon--close {
    opacity: 1;
    transform: rotate(0deg);
  }

  .fab-panel {
    pointer-events: none;
    position: absolute;
    bottom: calc(100% + 0.75rem);
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: linear-gradient(
      160deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.03) 100%
    );
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    box-shadow:
      0 12px 48px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      inset 0 -1px 0 rgba(255, 255, 255, 0.05);
    padding: 8px;
    opacity: 0;
    transform: translateY(12px) scale(0.92);
    transition: opacity 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
  }

  .fab-panel::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(
      ellipse at 30% 20%,
      rgba(255, 255, 255, 0.08) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .fab-menu.is-open .fab-panel {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .fab-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px 12px 16px;
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: background 0.2s ease, color 0.15s ease;
    position: relative;
    white-space: nowrap;
  }

  .fab-link:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .fab-link svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .fab-link:hover svg {
    opacity: 1;
  }

  .fab-link span {
    transition: transform 0.2s ease;
  }

  .fab-link:hover span {
    transform: translateX(2px);
  }

  @media (max-width: 479px) {
    .fab-menu {
      bottom: 0.75rem;
      right: 0.75rem;
    }
    .fab-trigger {
      width: 48px;
      height: 48px;
    }
    .fab-icon {
      width: 20px;
      height: 20px;
    }
    .fab-link {
      padding: 10px 16px 10px 14px;
      font-size: 13px;
    }
  }
</style>

<script is:inline>
  (function () {
    var menu = document.getElementById('fab-menu');
    var trigger = document.getElementById('fab-trigger');
    var panel = document.getElementById('fab-panel');
    if (!menu || !trigger || !panel) return;

    trigger.addEventListener('click', function () {
      var open = menu.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(open));
      panel.setAttribute('aria-hidden', String(!open));
    });

    var links = panel.querySelectorAll('[data-fab-link]');
    for (var i = 0; i < links.length; i++) {
      links[i].addEventListener('click', function () {
        menu.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
      });
    }

    document.addEventListener('click', function (e) {
      if (!menu.contains(e.target)) {
        menu.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        menu.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        panel.setAttribute('aria-hidden', 'true');
        trigger.focus();
      }
    });
  })();
</script>
