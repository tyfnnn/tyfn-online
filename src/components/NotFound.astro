---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/t';
import PortfolioNav from './portfolio/PortfolioNav.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const homeHref = getRelativeLocaleUrl(lang, '/');
const portfolioHref = getRelativeLocaleUrl(lang, '/portfolio/');
---
<PortfolioNav lang={lang} pathname="/" back="home" />

<section class="nf">
  <div class="nf-stars" aria-hidden="true"></div>
  <div class="nf-stars nf-stars--slow" aria-hidden="true"></div>

  <div class="nf-inner">
    <p class="nf-pill" data-scramble>
      <span class="nf-pill-dot" aria-hidden="true"></span>
      <span>{t('notfound.eyebrow')}</span>
    </p>

    <div class="nf-display" aria-hidden="true">
      <span class="nf-debris nf-debris--a">// signal lost</span>
      <span class="nf-debris nf-debris--b">[ drift: +0.42 AU ]</span>
      <span class="nf-debris nf-debris--c">// rerouting…</span>

      <span class="nf-digit nf-digit--four-l">4</span>
      <span class="nf-digit nf-digit--zero">
        <span class="nf-planet">
          <span class="nf-planet-bands"></span>
          <span class="nf-planet-ring"></span>
        </span>
      </span>
      <span class="nf-digit nf-digit--four-r">4</span>

      <div class="nf-orbit">
        <div class="nf-astronaut">
          <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <radialGradient id="nf-visor" cx="35%" cy="32%" r="85%">
                <stop offset="0%" stop-color="#7FB3FF" />
                <stop offset="55%" stop-color="#1E3A6B" />
                <stop offset="100%" stop-color="#0A1426" />
              </radialGradient>
              <linearGradient id="nf-suit" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#F4F4F6" />
                <stop offset="100%" stop-color="#C8C8D0" />
              </linearGradient>
            </defs>

            <rect x="38" y="50" width="44" height="36" rx="6" fill="#A3A3AC" />
            <rect x="42" y="54" width="6" height="12" rx="1" fill="#E5534B" />
            <rect x="50" y="54" width="6" height="12" rx="1" fill="#3ECF8E" />

            <path d="M 38 56 Q 38 48 46 48 L 74 48 Q 82 48 82 56 L 82 86 Q 82 96 72 96 L 48 96 Q 38 96 38 86 Z"
                  fill="url(#nf-suit)" stroke="#9A9AA3" stroke-width="1" />

            <rect x="52" y="62" width="16" height="10" rx="2" fill="#19191C" stroke="#E5534B" stroke-width="1.2" />
            <text x="60" y="70" font-family="Archivo Black, sans-serif" font-size="6" fill="#E5534B" text-anchor="middle" letter-spacing="0.5">404</text>

            <path d="M 38 60 Q 22 64 18 78 Q 16 86 22 90 L 28 84 Q 30 76 38 74 Z"
                  fill="url(#nf-suit)" stroke="#9A9AA3" stroke-width="1" />
            <path d="M 82 60 Q 98 60 102 50 Q 104 42 98 38 L 92 44 Q 88 52 82 54 Z"
                  fill="url(#nf-suit)" stroke="#9A9AA3" stroke-width="1" />
            <circle cx="22" cy="92" r="6" fill="#19191C" stroke="#E5534B" stroke-width="1" />
            <circle cx="100" cy="36" r="6" fill="#19191C" stroke="#E5534B" stroke-width="1" />

            <rect x="46" y="92" width="10" height="14" rx="3" fill="url(#nf-suit)" stroke="#9A9AA3" stroke-width="1" />
            <rect x="64" y="92" width="10" height="14" rx="3" fill="url(#nf-suit)" stroke="#9A9AA3" stroke-width="1" />
            <rect x="44" y="103" width="14" height="6" rx="2" fill="#19191C" />
            <rect x="62" y="103" width="14" height="6" rx="2" fill="#19191C" />

            <circle cx="60" cy="38" r="24" fill="#E8E8EE" stroke="#9A9AA3" stroke-width="1" />
            <circle cx="60" cy="38" r="18" fill="url(#nf-visor)" />
            <ellipse cx="53" cy="32" rx="6" ry="4" fill="#FFFFFF" opacity="0.45" />
            <ellipse cx="66" cy="42" rx="2.5" ry="1.5" fill="#FFFFFF" opacity="0.35" />

            <line x1="76" y1="22" x2="82" y2="14" stroke="#9A9AA3" stroke-width="1.5" />
            <circle cx="82" cy="14" r="2" fill="#E5534B" />
          </svg>
        </div>
      </div>
    </div>

    <h1 class="nf-title" data-scramble set:html={t('notfound.title')}></h1>
    <p class="nf-subtitle" data-scramble set:html={t('notfound.subtitle')}></p>
    <p class="nf-joke" data-scramble>{t('notfound.joke')}</p>

    <div class="nf-actions">
      <a href={homeHref} class="nf-btn nf-btn--primary">
        <span data-scramble>{t('notfound.cta_home')}</span>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
      <a href={portfolioHref} class="nf-btn">
        <span data-scramble>{t('notfound.cta_portfolio')}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .nf {
    position: relative;
    min-height: calc(100vh - 80px);
    padding: 4rem 1.5rem 6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
      radial-gradient(1100px 700px at 78% 28%, rgba(229, 83, 75, 0.18), transparent 60%),
      radial-gradient(900px 800px at 18% 88%, rgba(137, 87, 229, 0.16), transparent 60%),
      radial-gradient(700px 600px at 92% 92%, rgba(33, 136, 255, 0.10), transparent 60%),
      var(--bg-primary, #2B2B2B);
  }

  .nf::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 50%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 50%, transparent 100%);
  }

  .nf-stars,
  .nf-stars--slow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      radial-gradient(1px 1px at 12% 18%, #fff, transparent 60%),
      radial-gradient(1px 1px at 27% 64%, #fff, transparent 60%),
      radial-gradient(1.5px 1.5px at 41% 22%, #fff, transparent 60%),
      radial-gradient(1px 1px at 58% 81%, #fff, transparent 60%),
      radial-gradient(1.5px 1.5px at 71% 32%, #fff, transparent 60%),
      radial-gradient(1px 1px at 84% 70%, #fff, transparent 60%),
      radial-gradient(1px 1px at 92% 12%, #fff, transparent 60%),
      radial-gradient(1px 1px at 9% 88%, #fff, transparent 60%),
      radial-gradient(1.5px 1.5px at 50% 50%, #fff, transparent 60%),
      radial-gradient(1px 1px at 33% 8%, #fff, transparent 60%),
      radial-gradient(1px 1px at 65% 95%, #fff, transparent 60%),
      radial-gradient(1px 1px at 19% 47%, #fff, transparent 60%);
    opacity: 0.55;
    animation: nf-twinkle 4s ease-in-out infinite alternate;
  }

  .nf-stars--slow {
    background-image:
      radial-gradient(1px 1px at 4% 30%, #ffd9c8, transparent 60%),
      radial-gradient(1.5px 1.5px at 22% 92%, #c8e2ff, transparent 60%),
      radial-gradient(1px 1px at 47% 14%, #fff, transparent 60%),
      radial-gradient(2px 2px at 76% 56%, #ffd9c8, transparent 60%),
      radial-gradient(1px 1px at 88% 84%, #c8e2ff, transparent 60%),
      radial-gradient(1.5px 1.5px at 14% 72%, #fff, transparent 60%);
    opacity: 0.7;
    animation-duration: 7s;
    animation-delay: -2s;
  }

  @keyframes nf-twinkle {
    0% { opacity: 0.25; }
    100% { opacity: 0.85; }
  }

  .nf-inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .nf-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-family: 'JetBrains Mono', ui-monospace, "SF Mono", Menlo, monospace;
    color: var(--text-secondary, #B8B8B0);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }

  .nf-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-color, #DB4A2B);
    box-shadow: 0 0 12px var(--accent-color, #DB4A2B);
    animation: nf-flicker 3.4s ease-in-out infinite;
  }

  @keyframes nf-flicker {
    0%, 18%, 22%, 25%, 53%, 57%, 100% { opacity: 1; }
    20%, 24%, 55% { opacity: 0.3; }
  }

  .nf-display {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 2vw, 1.25rem);
    margin: 1.5rem 0 2.5rem;
    line-height: 1;
  }

  .nf-digit {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(7rem, 22vw, 14rem);
    color: var(--text-light, #E6E6DD);
    display: inline-block;
    transform-origin: center bottom;
  }

  .nf-digit--four-l { animation: nf-tilt-l 5s ease-in-out infinite; }
  .nf-digit--four-r { animation: nf-tilt-r 5s ease-in-out infinite; }

  @keyframes nf-tilt-l {
    0%, 100% { transform: rotate(-4deg) translateY(0); }
    50% { transform: rotate(-1deg) translateY(-6px); }
  }
  @keyframes nf-tilt-r {
    0%, 100% { transform: rotate(4deg) translateY(0); }
    50% { transform: rotate(1deg) translateY(-6px); }
  }

  .nf-digit--zero {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 0.72em;
    height: 0.72em;
    margin: 0 -0.04em;
    font-size: clamp(7rem, 22vw, 14rem);
  }

  .nf-planet {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, #FFE4A3 0%, #F2B544 26%, #E5534B 55%, #8A2D1F 88%);
    box-shadow:
      inset -0.12em -0.08em 0.26em rgba(0, 0, 0, 0.55),
      inset 0.08em 0.06em 0.18em rgba(255, 220, 160, 0.18),
      0 0 0.28em rgba(229, 83, 75, 0.35),
      0 0 0.55em rgba(229, 83, 75, 0.18);
    animation: nf-planet-breathe 6s ease-in-out infinite;
  }

  .nf-planet-bands {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      linear-gradient(110deg, transparent 38%, rgba(0, 0, 0, 0.18) 40%, transparent 44%),
      linear-gradient(110deg, transparent 58%, rgba(0, 0, 0, 0.22) 60%, transparent 66%),
      linear-gradient(110deg, transparent 72%, rgba(255, 220, 160, 0.12) 75%, transparent 80%);
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .nf-planet-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 30%;
    transform: translate(-50%, -50%) rotate(-18deg);
    border-radius: 50%;
    border: 2px solid rgba(242, 181, 68, 0.55);
    box-shadow: 0 0 12px rgba(242, 181, 68, 0.35);
    background: linear-gradient(180deg, transparent 48%, rgba(242, 181, 68, 0.10) 50%, transparent 52%);
    pointer-events: none;
    animation: nf-ring-tilt 8s ease-in-out infinite;
  }

  @keyframes nf-planet-breathe {
    0%, 100% { filter: brightness(1); }
    50% { filter: brightness(1.08); }
  }

  @keyframes nf-ring-tilt {
    0%, 100% { transform: translate(-50%, -50%) rotate(-18deg) scaleX(1); }
    50% { transform: translate(-50%, -50%) rotate(-14deg) scaleX(0.94); }
  }

  .nf-debris {
    position: absolute;
    font-family: 'JetBrains Mono', ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    opacity: 0.7;
    pointer-events: none;
    white-space: nowrap;
  }
  .nf-debris--a { top: 6%; left: 8%; color: #F2B544; }
  .nf-debris--b { bottom: 4%; left: 14%; color: #3ECF8E; }
  .nf-debris--c { top: 14%; right: 6%; color: #2188FF; }

  @media (max-width: 640px) {
    .nf-debris { display: none; }
  }

  .nf-orbit {
    position: absolute;
    inset: 0;
    pointer-events: none;
    animation: nf-orbit 12s linear infinite;
  }

  @keyframes nf-orbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .nf-astronaut {
    position: absolute;
    top: 8%;
    left: 50%;
    width: clamp(72px, 12vw, 110px);
    transform: translateX(-50%);
    animation: nf-counter-spin 12s linear infinite, nf-bob 3s ease-in-out infinite;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.4));
  }

  .nf-astronaut svg { width: 100%; height: auto; display: block; }

  @keyframes nf-counter-spin {
    from { transform: translateX(-50%) rotate(0deg); }
    to { transform: translateX(-50%) rotate(-360deg); }
  }

  @keyframes nf-bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -8px; }
  }

  .nf-title {
    font-family: 'Archivo Black', sans-serif;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: var(--text-light, #E6E6DD);
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .nf-title :global(.nf-accent) {
    background: linear-gradient(96deg, #F2B544 0%, #E5534B 55%, #8957E5 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .nf-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    color: var(--text-secondary, #B8B8B0);
    max-width: 520px;
    margin: 0 auto 0.75rem;
    line-height: 1.55;
  }

  .nf-subtitle :global(em) {
    font-style: normal;
    color: var(--accent-color, #DB4A2B);
    font-weight: 600;
  }

  .nf-subtitle :global(code) {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.92em;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.1em 0.45em;
    border-radius: 6px;
    color: var(--text-light, #E6E6DD);
  }

  .nf-joke {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: var(--text-secondary, #B8B8B0);
    max-width: 520px;
    margin: 0 auto 2.5rem;
    line-height: 1.55;
    opacity: 0.85;
  }

  .nf-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .nf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--border-color, #4A4A4A);
    color: var(--text-light, #E6E6DD);
    background: var(--card-bg, #363636);
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }

  .nf-btn:hover {
    transform: translateY(-2px);
    border-color: var(--accent-color, #DB4A2B);
    color: var(--accent-color, #DB4A2B);
  }

  .nf-btn--primary {
    background: var(--accent-color, #DB4A2B);
    border-color: var(--accent-color, #DB4A2B);
    color: #fff;
  }

  .nf-btn--primary:hover {
    background: #b9381e;
    border-color: #b9381e;
    color: #fff;
  }

  .nf-btn svg {
    width: 16px;
    height: 16px;
    transition: transform 0.25s ease;
  }

  .nf-btn:hover svg { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) {
    .nf-stars,
    .nf-stars--slow,
    .nf-pill-dot,
    .nf-digit--four-l,
    .nf-digit--four-r,
    .nf-planet,
    .nf-planet-ring,
    .nf-orbit,
    .nf-astronaut {
      animation: none !important;
    }
  }

  @media (max-width: 600px) {
    .nf { padding: 3rem 1rem 5rem; }
    .nf-actions { flex-direction: column; align-items: stretch; }
    .nf-btn { justify-content: center; }
  }
</style>
