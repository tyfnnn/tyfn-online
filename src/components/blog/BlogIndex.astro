---
import { getRelativeLocaleUrl } from 'astro:i18n';
import PortfolioNav from '../portfolio/PortfolioNav.astro';
import CrossLinkCard from '../portfolio/CrossLinkCard.astro';
import { useTranslations, type Lang } from '../../i18n/t';
import {
  getBlogPosts,
  postHref,
  formatDate,
  formatReadingTime,
} from '../../lib/blog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getBlogPosts(lang);
const readMore = t('blog.index.read_more');
const readingTimeTemplate = t('blog.reading_time');
const portfolioHref = getRelativeLocaleUrl(lang, '/portfolio/');
---
<PortfolioNav lang={lang} pathname="/blog/" back="home" />

<section class="portfolio-section">
  <div class="container">
    <div class="portfolio-header">
      <h2 class="portfolio-title" data-scramble>{t('blog.index.title')}</h2>
      <p class="portfolio-subtitle" data-scramble>
        {t('blog.index.subtitle')}
      </p>
    </div>

    {posts.length > 0 && (
      <div class="blog-sort" role="group" aria-label={t('blog.index.sort_label')}>
        <span class="blog-sort-label">{t('blog.index.sort_label')}:</span>
        <button
          type="button"
          class="blog-sort-button is-active"
          data-sort="desc"
          aria-pressed="true"
        >{t('blog.index.sort_newest')}</button>
        <button
          type="button"
          class="blog-sort-button"
          data-sort="asc"
          aria-pressed="false"
        >{t('blog.index.sort_oldest')}</button>
      </div>
    )}

    <div class="portfolio-grid" data-blog-grid>
      {posts.length === 0 && (
        <div class="blog-empty" data-scramble>{t('blog.index.empty')}</div>
      )}
      {posts.map((post) => {
        const href = postHref(lang, post);
        const heroStyle = post.data.heroImage
          ? `background-image: url('${post.data.heroImage}');`
          : '';
        return (
          <a href={href} class="project-card" data-date={post.data.pubDate.toISOString()}>
            <div class="project-image" style={heroStyle}></div>
            <div class="project-content">
              <h3 class="project-title" data-scramble>{post.data.title}</h3>
              <div class="post-meta">
                <span>{formatDate(post.data.pubDate, lang)}</span>
                <span class="post-meta-dot" aria-hidden="true">·</span>
                <span>{formatReadingTime(post.body, readingTimeTemplate)}</span>
              </div>
              <p class="project-description" data-scramble>
                {post.data.description}
              </p>
              {post.data.tags.length > 0 && (
                <div class="project-tags">
                  {post.data.tags.map((tag) => (
                    <span class="project-tag">{tag}</span>
                  ))}
                </div>
              )}
              <div class="project-link" data-scramble>
                {readMore}
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <CrossLinkCard
      href={portfolioHref}
      kicker={t('blog.index.cross_link_kicker')}
      title={t('blog.index.cross_link_title')}
      body={t('blog.index.cross_link_body')}
      cta={t('blog.index.cross_link_cta')}
    />
  </div>
</section>

<script>
  const grid = document.querySelector<HTMLElement>('[data-blog-grid]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.blog-sort-button');
  if (grid && buttons.length) {
    const apply = (dir: 'asc' | 'desc') => {
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.project-card'));
      cards.sort((a, b) => {
        const da = Date.parse(a.dataset.date ?? '');
        const db = Date.parse(b.dataset.date ?? '');
        return dir === 'desc' ? db - da : da - db;
      });
      for (const card of cards) grid.appendChild(card);
      for (const btn of buttons) {
        const active = btn.dataset.sort === dir;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      }
    };
    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        const dir = btn.dataset.sort === 'asc' ? 'asc' : 'desc';
        apply(dir);
      });
    }
  }
</script>
