<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,300;1,9..144,400;0,9..144,500&family=JetBrains+Mono:wght@400;500;600&display=swap');

  .ipad-cto {
    width: 100%;
    margin: 0 0 2rem;
    position: relative;
    z-index: 2;
  }

  .ipad-stage {
    max-width: 1180px;
    margin: 0 auto;
    perspective: 1600px;
    position: relative;
  }

  /* Hand cursor for the iPad area */
  .ipad-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 52px;
    height: 52px;
    pointer-events: none;
    will-change: transform;
    opacity: 0;
    transition: opacity 0.22s ease;
    z-index: 9999;
  }
  .ipad-cursor.is-active { opacity: 1; }

  .ipad-cursor_inner {
    width: 100%;
    height: 100%;
    /* pivot for rotation animations = the fingertip */
    transform-origin: 50% 14%;
    animation: ipadHandIdle 2.6s ease-in-out infinite;
  }
  .ipad-cursor img {
    display: block;
    width: 100%;
    height: 100%;
    /* invert the black SVG to a white pointer with a soft dark outline+shadow */
    filter:
      invert(1) brightness(1.05)
      drop-shadow(0 0 1px rgba(0, 0, 0, 0.55))
      drop-shadow(0 2px 5px rgba(0, 0, 0, 0.45));
    transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Idle: gentle bob + tilt */
  @keyframes ipadHandIdle {
    0%, 100% { transform: rotate(-4deg) translateY(0); }
    50%      { transform: rotate(2deg)  translateY(-3px); }
  }

  /* Wave: one-shot when the hand appears */
  .ipad-cursor.is-wave .ipad-cursor_inner {
    animation: ipadHandWave 0.7s ease-out;
  }
  @keyframes ipadHandWave {
    0%   { transform: rotate(-22deg); }
    25%  { transform: rotate(18deg); }
    55%  { transform: rotate(-12deg); }
    80%  { transform: rotate(8deg); }
    100% { transform: rotate(-4deg); }
  }

  /* Hover over interactive: livelier wiggle */
  .ipad-cursor.is-hover .ipad-cursor_inner {
    animation: ipadHandWiggle 0.7s ease-in-out infinite;
  }
  .ipad-cursor.is-hover img {
    transform: scale(1.08);
    filter:
      invert(1) brightness(1.1)
      drop-shadow(0 0 1px rgba(0, 0, 0, 0.55))
      drop-shadow(0 3px 8px rgba(255, 154, 110, 0.55))
      drop-shadow(0 0 12px rgba(255, 154, 110, 0.35));
  }
  @keyframes ipadHandWiggle {
    0%, 100% { transform: rotate(-8deg) translateY(0); }
    50%      { transform: rotate(10deg) translateY(-1px); }
  }

  /* Press: punch down */
  .ipad-cursor.is-down img {
    transform: scale(0.78);
    transition: transform 0.12s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .ipad-cursor.is-down .ipad-cursor_inner {
    animation-play-state: paused;
  }

  /* Hide on touch / reduced motion */
  @media (pointer: coarse), (hover: none) {
    .ipad-cursor { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ipad-cursor_inner { animation: none; }
    .ipad-cursor img { transition: none; }
  }

  /* Editorial frame markers */
  .ipad-margin {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: rgba(240, 237, 230, 0.42);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin: 0 auto clamp(20px, 2vw, 32px);
    max-width: 1100px;
    padding: 0 4px;
  }
  .ipad-marker { white-space: nowrap; }
  .ipad-marker--right { margin-left: auto; }
  .ipad-hairline {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(240, 237, 230, 0.22), rgba(240, 237, 230, 0.04));
  }

  .ipad-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    z-index: 4;
    pointer-events: none;
  }
  .ipad-corner::before,
  .ipad-corner::after {
    content: '';
    position: absolute;
    background: rgba(240, 237, 230, 0.55);
  }
  .ipad-corner::before { width: 100%; height: 1px; }
  .ipad-corner::after  { width: 1px; height: 100%; }
  .ipad-corner--tl { top: -28px; left: -28px; }
  .ipad-corner--tl::before { top: 0; left: 0; }
  .ipad-corner--tl::after  { top: 0; left: 0; }
  .ipad-corner--tr { top: -28px; right: -28px; }
  .ipad-corner--tr::before { top: 0; right: 0; }
  .ipad-corner--tr::after  { top: 0; right: 0; }
  .ipad-corner--bl { bottom: -28px; left: -28px; }
  .ipad-corner--bl::before { bottom: 0; left: 0; }
  .ipad-corner--bl::after  { bottom: 0; left: 0; }
  .ipad-corner--br { bottom: -28px; right: -28px; }
  .ipad-corner--br::before { bottom: 0; right: 0; }
  .ipad-corner--br::after  { bottom: 0; right: 0; }

  @media (max-width: 991px) {
    .ipad-corner { display: none; }
  }

  /* iPad shell — thin aluminum bezel */
  .ipad-frame {
    position: relative;
    margin: 0 auto;
    width: 100%;
    max-width: 1100px;
    aspect-ratio: 4 / 3;
    border-radius: 42px;
    padding: 11px;
    background:
      linear-gradient(180deg, #3a3a3c 0%, #1c1c1e 100%);
    box-shadow:
      /* outer edge */
      0 0 0 1px rgba(255, 255, 255, 0.06),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05),
      /* drop shadow */
      0 16px 24px rgba(0, 0, 0, 0.30),
      0 48px 64px rgba(0, 0, 0, 0.30),
      0 120px 80px rgba(0, 0, 0, 0.16);
    transform-style: preserve-3d;
    will-change: transform;
  }
  .ipad-frame::before {
    /* bezel highlight band */
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 42px;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, transparent 18%, transparent 82%, rgba(255, 255, 255, 0.04) 100%);
  }
  .ipad-camera {
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 30%, #2a2a2a 0%, #050505 70%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.10),
      0 0 0 1px rgba(0, 0, 0, 0.4);
    z-index: 3;
  }

  .ipad-frame_inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 32px;
    overflow: hidden;
    background: #0a0a0a;
    box-shadow:
      inset 0 0 0 1.5px rgba(0, 0, 0, 0.8),
      inset 0 0 0 2.5px rgba(255, 255, 255, 0.04);
  }

  /* Screen — real wallpaper photo */
  .ipad-screen {
    width: 100%;
    height: 100%;
    background:
      url('/assets/ipad-wallpaper.jpg') center / cover no-repeat,
      #0c0608;
    display: flex;
    flex-direction: column;
    color: #F0EDE6;
    position: relative;
    isolation: isolate;
  }
  /* gentle dim over the wallpaper so light text stays legible */
  .ipad-screen::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.32) 100%);
    z-index: 0;
  }
  .ipad-statusbar,
  .ipad-app,
  .ipad-home-indicator {
    position: relative;
    z-index: 1;
  }
  /* glossy reflection band */
  .ipad-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0) 28%, rgba(255, 255, 255, 0) 72%, rgba(255, 255, 255, 0.02) 100%);
    z-index: 2;
  }

  .ipad-statusbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 10px 26px 4px;
    font-size: 12px;
    font-weight: 600;
    color: rgba(240, 237, 230, 0.92);
    position: relative;
    z-index: 2;
  }
  .ipad-statusbar_left {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }
  .ipad-time { font-variant-numeric: tabular-nums; letter-spacing: 0.02em; }
  .ipad-date {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(240, 237, 230, 0.55);
  }
  .ipad-icons { display: inline-flex; gap: 6px; align-items: center; }
  .ipad-battery_pct {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    font-weight: 500;
    margin-left: 4px;
    color: rgba(240, 237, 230, 0.75);
    font-variant-numeric: tabular-nums;
  }

  .ipad-signal,
  .ipad-wifi {
    display: inline-block;
    background: rgba(240, 237, 230, 0.92);
  }
  .ipad-signal { width: 17px; height: 10px; clip-path: polygon(0 100%, 25% 100%, 25% 60%, 50% 60%, 50% 30%, 75% 30%, 75% 0, 100% 0, 100% 100%); }
  .ipad-wifi   { width: 15px; height: 10px; clip-path: polygon(50% 0, 100% 50%, 80% 60%, 50% 30%, 20% 60%, 0 50%); }
  .ipad-battery {
    width: 25px; height: 11px;
    border: 1px solid rgba(240, 237, 230, 0.7);
    background: transparent;
    border-radius: 3px;
    position: relative;
    padding: 1px;
    box-sizing: border-box;
  }
  .ipad-battery_level {
    display: block;
    height: 100%;
    width: 75%;
    background: rgba(240, 237, 230, 0.92);
    border-radius: 1.5px;
    transition: width 0.4s ease, background 0.4s ease;
  }
  .ipad-battery::after { content: ''; position: absolute; right: -3px; top: 50%; transform: translateY(-50%); width: 2px; height: 5px; background: rgba(240, 237, 230, 0.6); border-radius: 1px; }

  /* App container inside screen */
  .ipad-app {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(14px, 1.6vw, 22px);
    gap: clamp(12px, 1.4vw, 18px);
    min-height: 0;
  }
  .ipad-app_head {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: clamp(8px, 1vw, 14px);
    padding: 8px 12px;
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0) 100%),
      linear-gradient(180deg, rgba(15, 18, 24, 0.55) 0%, rgba(8, 10, 14, 0.62) 100%);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 -1px 0 rgba(0, 0, 0, 0.30),
      0 4px 24px rgba(0, 0, 0, 0.28);
  }

  /* Tabs */
  .ipad-tabs {
    position: relative;
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow:
      inset 0 1px 1px rgba(0, 0, 0, 0.35),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06);
  }
  .ipad-tab {
    position: relative;
    z-index: 1;
    padding: 5px 14px;
    border-radius: 999px;
    background: transparent;
    border: 0;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(240, 237, 230, 0.55);
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .ipad-tab:hover { color: rgba(240, 237, 230, 0.9); }
  .ipad-tab.is-active { color: #fff; }
  .ipad-tab_pill {
    position: absolute;
    top: 3px;
    left: 3px;
    height: calc(100% - 6px);
    background:
      linear-gradient(180deg, #ff8e5c 0%, #ff5b50 55%, #ee3b3b 100%);
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -1px 0 rgba(0, 0, 0, 0.18),
      0 6px 14px rgba(255, 116, 72, 0.42),
      0 1px 1px rgba(0, 0, 0, 0.2);
    transition: left 0.32s cubic-bezier(0.45, 0.05, 0.2, 1),
                width 0.32s cubic-bezier(0.45, 0.05, 0.2, 1);
    pointer-events: none;
    z-index: 0;
  }

  /* Search */
  .ipad-searchbar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 999px;
    min-width: 0;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    box-shadow:
      inset 0 1px 1px rgba(0, 0, 0, 0.25),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06);
  }
  .ipad-searchbar:focus-within {
    border-color: rgba(255, 154, 110, 0.55);
    background: rgba(0, 0, 0, 0.38);
    box-shadow:
      inset 0 1px 1px rgba(0, 0, 0, 0.3),
      0 0 0 3px rgba(255, 154, 110, 0.18);
  }
  .ipad-searchbar_icon { color: rgba(240, 237, 230, 0.55); font-size: 13px; }
  .ipad-searchbar_input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: 0;
    color: #F0EDE6;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.02em;
    padding: 0;
  }
  .ipad-searchbar_input::placeholder { color: rgba(240, 237, 230, 0.4); }
  .ipad-searchbar_input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .ipad-searchbar_kbd {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    color: rgba(240, 237, 230, 0.5);
    padding: 2px 6px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom-width: 2px;
  }

  /* Sort toggle */
  .ipad-sort {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.04) 100%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: rgba(240, 237, 230, 0.85);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.18);
  }
  .ipad-sort:hover {
    color: #ff9b6e;
    border-color: rgba(255, 154, 110, 0.4);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      0 0 0 3px rgba(255, 154, 110, 0.12);
  }
  .ipad-sort_arrow {
    display: inline-block;
    transition: transform 0.3s ease;
    color: #ff9b6e;
  }
  .ipad-sort[data-sort="oldest"] .ipad-sort_arrow { transform: rotate(180deg); }

  /* Tab-driven column visibility */
  .ipad-app[data-tab-active="projects"] .ipad-col[data-list="writing"],
  .ipad-app[data-tab-active="writing"]  .ipad-col[data-list="projects"] {
    display: none;
  }
  .ipad-app[data-tab-active="projects"] .ipad-app_body,
  .ipad-app[data-tab-active="writing"]  .ipad-app_body {
    grid-template-columns: 1fr;
  }

  /* Empty state */
  .ipad-empty {
    display: none;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(240, 237, 230, 0.4);
    padding: 18px 8px;
    text-align: center;
    margin: 0;
  }
  .ipad-col.is-empty .ipad-list { display: none; }
  .ipad-col.is-empty .ipad-empty { display: block; }
  .ipad-item.is-hidden { display: none; }

  /* =================================================================
     APP WINDOWS (mock IDE/app overlays inside the iPad)
     ================================================================= */
  .ipad-windows {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }
  .ipad-win {
    position: absolute;
    inset: clamp(36px, 4vw, 60px) clamp(12px, 1.6vw, 22px) clamp(74px, 8vw, 100px);
    border-radius: 14px;
    overflow: hidden;
    background: #1a1a1a;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06),
      0 20px 60px rgba(0, 0, 0, 0.55),
      0 60px 120px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: translateY(18px) scale(0.97);
    transition: opacity 0.32s ease, transform 0.32s cubic-bezier(0.32, 0.72, 0.24, 1);
    pointer-events: none;
    display: flex;
    flex-direction: column;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    color: #d8d6d2;
  }
  .ipad-app[data-open-window="xcode"]          .ipad-win--xcode,
  .ipad-app[data-open-window="android-studio"] .ipad-win--android,
  .ipad-app[data-open-window="webstorm"]       .ipad-win--webstorm,
  .ipad-app[data-open-window="figma"]          .ipad-win--figma,
  .ipad-app[data-open-window="obsidian"]       .ipad-win--obsidian,
  .ipad-app[data-open-window="messages"]       .ipad-win--messages,
  .ipad-app[data-open-window="snake"]          .ipad-win--snake {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  /* dim the underlying app contents while a window is open */
  .ipad-app[data-open-window] .ipad-app_head,
  .ipad-app[data-open-window] .ipad-app_body {
    opacity: 0.35;
    filter: blur(2px);
    pointer-events: none;
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  /* Shared window chrome: traffic lights bar */
  .ipad-win_chrome {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(0, 0, 0, 0.25);
  }
  .ipad-win_lights {
    display: inline-flex;
    gap: 7px;
    align-items: center;
  }
  .ipad-light {
    width: 11px; height: 11px;
    border-radius: 50%;
    display: inline-block;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.3);
  }
  .ipad-light--r { background: #ff5f57; cursor: pointer; transition: filter 0.2s ease; }
  .ipad-light--r:hover { filter: brightness(1.15); }
  .ipad-light--y { background: #ffbd2e; }
  .ipad-light--g { background: #28c840; }

  /* ============== XCODE 26 ============== */
  .ipad-win--xcode {
    background: linear-gradient(180deg, #1e1e1e 0%, #161616 100%);
    color: #e7e6e3;
  }
  .ipad-win_chrome--xcode {
    background: linear-gradient(180deg, #2c2c2e 0%, #232325 100%);
    border-bottom-color: rgba(0, 0, 0, 0.4);
  }
  .xc-toolbar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #d0cfcb;
    font-size: 11px;
  }
  .xc-btn {
    display: inline-grid;
    place-items: center;
    width: 22px; height: 22px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    color: #d0cfcb;
    font-size: 10px;
  }
  .xc-divider { width: 1px; height: 16px; background: rgba(255, 255, 255, 0.08); }
  .xc-scheme {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    font-size: 11px;
    color: #e7e6e3;
  }
  .xc-scheme_dot { width: 8px; height: 8px; border-radius: 50%; background: #0a84ff; box-shadow: 0 0 6px rgba(10, 132, 255, 0.6); }
  .xc-scheme_caret { opacity: 0.5; }
  .xc-status { margin-left: auto; font-size: 11px; color: rgba(231, 230, 227, 0.5); }

  .xc-body { flex: 1; display: grid; grid-template-columns: 180px 1fr 180px; min-height: 0; }
  .xc-nav, .xc-inspector {
    background: #1c1c1d;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    padding: 8px;
    overflow: auto;
    font-size: 11px;
  }
  .xc-inspector { border-right: 0; border-left: 1px solid rgba(255, 255, 255, 0.05); }
  .xc-nav_head, .xc-insp_head {
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: rgba(231, 230, 227, 0.45);
    padding: 4px 6px 8px;
  }
  .xc-tree, .xc-tree ul { list-style: none; padding: 0; margin: 0; }
  .xc-tree ul { padding-left: 14px; }
  .xc-tree_label { display: block; padding: 3px 6px; color: #d0cfcb; cursor: default; font-size: 11px; }
  .xc-file { display: inline-block; padding: 3px 6px; border-radius: 4px; color: #c8c7c4; font-size: 11px; }
  .xc-file.is-active { background: #0a84ff; color: #fff; }

  .xc-editor { display: flex; flex-direction: column; min-width: 0; background: #1e1e1e; }
  .xc-tabbar {
    display: flex;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: #232325;
    flex-shrink: 0;
  }
  .xc-tab {
    padding: 6px 12px;
    font-size: 11px;
    color: rgba(231, 230, 227, 0.5);
    border-right: 1px solid rgba(255, 255, 255, 0.05);
  }
  .xc-tab.is-active { color: #fff; background: #1e1e1e; }
  .xc-code {
    flex: 1;
    margin: 0;
    padding: 12px 14px;
    overflow: auto;
    font-size: 11.5px;
    line-height: 1.55;
    color: #e7e6e3;
    background: #1e1e1e;
    white-space: pre;
  }
  .xc-code code { font-family: inherit; }
  .xc-ln { display: inline-block; width: 22px; color: rgba(231, 230, 227, 0.28); user-select: none; }
  .xc-kw { color: #ff7ab2; }
  .xc-ty { color: #d0a8ff; }
  .xc-id { color: #e7e6e3; }
  .xc-s  { color: #fc6a5d; }
  .xc-c  { color: #6c7986; font-style: italic; }
  .xc-at { color: #ffa14f; }
  .xc-fn { color: #67b7a4; }
  .xc-note {
    padding: 10px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(10, 132, 255, 0.06);
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-size: 13px;
    line-height: 1.5;
    color: #e7e6e3;
  }
  .xc-note strong { font-weight: 500; color: #fff; font-style: normal; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 4px; color: #ff9b6e; }
  .xc-note p { margin: 0; }

  .xc-insp_grid {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    gap: 8px;
  }
  .xc-insp_grid dt { font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(231, 230, 227, 0.45); margin-bottom: 2px; }
  .xc-insp_grid dd { margin: 0; font-size: 11px; color: #e7e6e3; }

  /* ============== ANDROID STUDIO ============== */
  .ipad-win--android {
    background: linear-gradient(180deg, #2b2b2b 0%, #1f1f1f 100%);
    color: #e0e0e0;
  }
  .ipad-win_chrome--android {
    background: #3c3f41;
  }
  .as-toolbar { display: flex; align-items: center; gap: 10px; flex: 1; font-size: 11px; color: #d2d2d2; }
  .as-app { display: inline-flex; align-items: center; gap: 6px; }
  .as-app img { width: 16px; height: 16px; border-radius: 4px; }
  .as-app strong { font-weight: 500; }
  .as-divider { width: 1px; height: 14px; background: rgba(255, 255, 255, 0.1); }
  .as-scheme { padding: 3px 10px; border-radius: 4px; background: rgba(255, 255, 255, 0.06); }
  .as-spacer { flex: 1; }
  .as-run { color: #3DDC84; font-weight: 600; padding: 3px 10px; border-radius: 4px; background: rgba(61, 220, 132, 0.12); }
  .as-status { font-size: 11px; color: rgba(255, 255, 255, 0.45); }

  .as-body { flex: 1; display: grid; grid-template-columns: 180px 1fr 200px; min-height: 0; }
  .as-nav { background: #2b2b2b; border-right: 1px solid #1a1a1a; padding: 8px; overflow: auto; font-size: 11px; }
  .as-nav_head { color: #bbbbbb; padding: 4px 6px; margin-bottom: 4px; }
  .as-tree, .as-tree ul { list-style: none; padding: 0; margin: 0; }
  .as-tree ul { padding-left: 14px; }
  .as-tree > li > span, .as-tree li > span { display: block; padding: 3px 6px; color: #bbbbbb; font-size: 11px; }
  .as-file { color: #cccccc; }
  .as-file.is-active { background: #2a4d6e; color: #fff; border-radius: 3px; }

  .as-editor { display: flex; flex-direction: column; min-width: 0; background: #2b2b2b; }
  .as-tabbar { background: #3c3f41; display: flex; border-bottom: 1px solid #1a1a1a; }
  .as-tab { padding: 5px 12px; font-size: 11px; color: rgba(255, 255, 255, 0.5); }
  .as-tab.is-active { background: #2b2b2b; color: #fff; border-bottom: 2px solid #3DDC84; }
  .as-code {
    flex: 1; margin: 0; padding: 12px 14px; overflow: auto;
    font-size: 11.5px; line-height: 1.55; color: #a9b7c6; background: #2b2b2b;
    white-space: pre; font-family: inherit;
  }
  .as-ln { display: inline-block; width: 22px; color: #606366; user-select: none; }
  .as-kw { color: #cc7832; font-weight: 600; }
  .as-ty { color: #ffc66d; }
  .as-id { color: #a9b7c6; }
