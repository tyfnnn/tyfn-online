<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;
    var prefersReduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var lang = document.documentElement.lang === 'de' ? 'de' : 'en';

    function initScroll(stage, frame, header) {
      if (prefersReduce) return;
      if (!window.gsap || !window.ScrollTrigger) return;
      try { window.gsap.registerPlugin(window.ScrollTrigger); } catch (e) {}

      var isMobile = window.matchMedia('(max-width: 768px)').matches;
      var fromScale = isMobile ? 0.82 : 0.9;
      var fromRotate = isMobile ? 20 : 28;

      window.gsap.set(frame, { rotateX: fromRotate, scale: fromScale, transformOrigin: '50% 100%' });

      window.gsap.to(frame, {
        rotateX: 0, scale: 1, ease: 'none',
        scrollTrigger: {
          trigger: frame, start: 'top bottom', end: 'center 55%', scrub: 0.6,
          onLeave: function () { frame.style.willChange = 'auto'; },
          onEnterBack: function () { frame.style.willChange = 'transform'; },
        },
      });

      window.gsap.to(header, {
        opacity: 1, y: 0, ease: 'power2.out',
        scrollTrigger: { trigger: frame, start: 'bottom 85%', end: 'bottom 50%', scrub: 0.8 },
      });
    }

    // ---------- Live clock & date ----------
    function initClock(stage) {
      var timeEl = stage.querySelector('[data-clock-time]');
      var dateEl = stage.querySelector('[data-clock-date]');
      if (!timeEl || !dateEl) return;
      var dateOpts = { weekday: 'short', day: '2-digit', month: 'short' };
      var locale = lang === 'de' ? 'de-DE' : 'en-US';
      function tick() {
        var now = new Date();
        var hh = String(now.getHours()).padStart(2, '0');
        var mm = String(now.getMinutes()).padStart(2, '0');
        timeEl.textContent = hh + ':' + mm;
        dateEl.textContent = now.toLocaleDateString(locale, dateOpts);
      }
      tick();
      var msToNextMin = (60 - new Date().getSeconds()) * 1000;
      setTimeout(function () { tick(); setInterval(tick, 60000); }, msToNextMin);
    }

    // ---------- Notification center ----------
    function initNotif(app) {
      var screen = app.querySelector('[data-ipad-screen]');
      var notif = app.querySelector('[data-ipad-notif]');
      var toggle = app.querySelector('[data-toggle="notif"]');
      var close = app.querySelector('[data-notif-close]');
      if (!screen || !notif || !toggle) return;

      function setOpen(open) {
        screen.classList.toggle('is-notif-open', open);
        notif.setAttribute('aria-hidden', open ? 'false' : 'true');
      }
      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        setOpen(!screen.classList.contains('is-notif-open'));
      });
      if (close) close.addEventListener('click', function () { setOpen(false); });
      // ESC or click outside
      window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && screen.classList.contains('is-notif-open')) setOpen(false);
      });
      screen.addEventListener('click', function (e) {
        if (!screen.classList.contains('is-notif-open')) return;
        if (e.target.closest('.ipad-notif_card')) return;
        if (e.target.closest('.ipad-statusbar_left')) return;
        if (e.target.closest('.ipad-notif_clear')) return;
        if (!e.target.closest('.ipad-notif_list')) setOpen(false);
      });
    }

    // ---------- Snake / Bug Hunt ----------
    function initSnake(app) {
      var win = app.querySelector('.ipad-win--snake');
      if (!win) return;
      var canvas = win.querySelector('[data-snake-canvas]');
      var stage = win.querySelector('[data-snake-stage]');
      var overlay = win.querySelector('[data-snake-overlay]');
      var statusEl = win.querySelector('[data-snake-status]');
      var scoreEl = win.querySelector('[data-snake-score]');
      var bestEl = win.querySelector('[data-snake-best]');
      var restartBtn = win.querySelector('[data-snake-restart]');
      var restartLabel = win.querySelector('[data-snake-restart-label]');
      if (!canvas || !ctx_safe(canvas)) return;

      var COLS = 24, ROWS = 16;
      var CELL = 24;
      canvas.width = COLS * CELL;
      canvas.height = ROWS * CELL;
      var ctx = canvas.getContext('2d');

      var i18n = {
        idle:    win.querySelector('[data-snake-status]').textContent,
        paused:  lang === 'de' ? 'Pause — Leertaste zum Weitermachen' : 'Paused — press space to resume',
        overTpl: lang === 'de' ? 'Game Over · {n} Bug{s} gefangen'    : 'Game over · ate {n} bug{s}',
        play:    lang === 'de' ? 'Los'           : 'Play',
        pause:   lang === 'de' ? 'Pause'         : 'Pause',
        restart: lang === 'de' ? 'Neu starten'   : 'Restart',
      };

      var STORE_KEY = 'tyfn-snake-best';
      var best = 0;
      try { best = parseInt(sessionStorage.getItem(STORE_KEY) || '0', 10) || 0; } catch (e) {}
      bestEl.textContent = String(best).padStart(2, '0');

      var snake, dir, nextDir, bug, score, state, lastStep, stepInterval, raf;

      function reset() {
        snake = [{ x: 6, y: 8 }, { x: 5, y: 8 }, { x: 4, y: 8 }];
        dir = { x: 1, y: 0 };
        nextDir = { x: 1, y: 0 };
        score = 0;
        stepInterval = 130;
        spawnBug();
        updateScore();
        state = 'idle';
        statusEl.textContent = i18n.idle;
        restartLabel.textContent = i18n.play;
        stage.classList.remove('is-running');
        draw();
      }

      function spawnBug() {
        var attempts = 0;
        while (attempts < 200) {
          var x = Math.floor(Math.random() * COLS);
          var y = Math.floor(Math.random() * ROWS);
          if (!snake.some(function (s) { return s.x === x && s.y === y; })) {
            bug = { x: x, y: y, t: 0 };
            return;
          }
          attempts++;
        }
        bug = { x: 0, y: 0, t: 0 };
      }

      function updateScore() {
        scoreEl.textContent = String(score).padStart(2, '0');
        if (score > best) {
          best = score;
          bestEl.textContent = String(best).padStart(2, '0');
          try { sessionStorage.setItem(STORE_KEY, String(best)); } catch (e) {}
        }
      }

      function step() {
        dir = nextDir;
        var head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };
        if (head.x < 0 || head.x >= COLS || head.y < 0 || head.y >= ROWS) return gameOver();
        for (var i = 0; i < snake.length; i++) {
          if (snake[i].x === head.x && snake[i].y === head.y) return gameOver();
        }
        snake.unshift(head);
        if (head.x === bug.x && head.y === bug.y) {
          score++;
          updateScore();
          // speed up slightly each bug, floor 60ms
          stepInterval = Math.max(60, stepInterval - 4);
          spawnBug();
        } else {
          snake.pop();
        }
      }

      function gameOver() {
        state = 'over';
        stage.classList.remove('is-running');
        statusEl.textContent = i18n.overTpl
          .replace('{n}', String(score))
          .replace('{s}', score === 1 ? '' : 's');
        restartLabel.textContent = i18n.restart;
      }

      function drawBeetle(cx, cy, t) {
        var pulse = 1 + Math.sin(t) * 0.04;
        var bodyR = CELL * 0.34 * pulse;      // body half-width
        var bodyH = CELL * 0.42 * pulse;      // body half-height (elongated)
        var legLen = CELL * 0.22;
        var legW = 1.4;
        var legWiggle = Math.sin(t * 1.6) * 1.5;

        // Six legs (drawn first so they sit under the body)
        ctx.strokeStyle = '#1a0508';
        ctx.lineCap = 'round';
        ctx.lineWidth = legW;
        ctx.beginPath();
        for (var i = -1; i <= 1; i++) {
          var ly = cy + i * bodyH * 0.45;
          // left
          ctx.moveTo(cx - bodyR * 0.8, ly);
          ctx.lineTo(cx - bodyR - legLen, ly + legWiggle * (i === 0 ? -1 : 1));
          // right
          ctx.moveTo(cx + bodyR * 0.8, ly);
          ctx.lineTo(cx + bodyR + legLen, ly - legWiggle * (i === 0 ? -1 : 1));
        }
        ctx.stroke();

        // Black head
        var headY = cy - bodyH * 0.85;
        var headR = bodyR * 0.55;
        ctx.fillStyle = '#0a0508';
        ctx.beginPath();
        ctx.ellipse(cx, headY, headR, headR * 0.78, 0, 0, Math.PI * 2);
        ctx.fill();

        // Antennae
        ctx.strokeStyle = '#0a0508';
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.moveTo(cx - headR * 0.55, headY - headR * 0.55);
        ctx.quadraticCurveTo(cx - headR * 1.3, headY - headR * 1.4, cx - headR * 1.7, headY - headR * 1.9);
        ctx.moveTo(cx + headR * 0.55, headY - headR * 0.55);
        ctx.quadraticCurveTo(cx + headR * 1.3, headY - headR * 1.4, cx + headR * 1.7, headY - headR * 1.9);
        ctx.stroke();
        // antenna tips
        ctx.fillStyle = '#0a0508';
        ctx.beginPath();
        ctx.arc(cx - headR * 1.7, headY - headR * 1.9, 1.6, 0, Math.PI * 2);
        ctx.arc(cx + headR * 1.7, headY - headR * 1.9, 1.6, 0, Math.PI * 2);
        ctx.fill();

        // Body (elytra) — red dome
        var grad = ctx.createRadialGradient(
          cx - bodyR * 0.3, cy - bodyH * 0.4, bodyR * 0.1,
          cx, cy, bodyR * 1.4
        );
        grad.addColorStop(0, '#ff6b62');
        grad.addColorStop(0.55, '#ff3b30');
        grad.addColorStop(1, '#b71a14');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.ellipse(cx, cy, bodyR, bodyH, 0, 0, Math.PI * 2);
        ctx.fill();

        // Wing-case split
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.55)';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(cx, cy - bodyH * 0.7);
        ctx.lineTo(cx, cy + bodyH * 0.85);
        ctx.stroke();

        // Black spots
        ctx.fillStyle = '#0a0508';
        var spots = [
          [-0.45, -0.30, 0.16],
          [ 0.45, -0.30, 0.16],
          [-0.35,  0.30, 0.14],
          [ 0.35,  0.30, 0.14],
          [ 0,     0.55, 0.12],
        ];
        for (var s = 0; s < spots.length; s++) {
          ctx.beginPath();
          ctx.arc(cx + spots[s][0] * bodyR, cy + spots[s][1] * bodyH, bodyR * spots[s][2], 0, Math.PI * 2);
          ctx.fill();
        }

        // Highlight sheen
        ctx.fillStyle = 'rgba(255, 255, 255, 0.22)';
        ctx.beginPath();
        ctx.ellipse(cx - bodyR * 0.35, cy - bodyH * 0.5, bodyR * 0.25, bodyH * 0.18, -0.5, 0, Math.PI * 2);
        ctx.fill();
      }

      function draw() {
        // bg — warm terminal tone, light enough for black beetle parts to read
        ctx.fillStyle = '#2a1d20';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = 'rgba(255, 116, 72, 0.10)';
        for (var gy = 0; gy < ROWS; gy++) {
          for (var gx = 0; gx < COLS; gx++) {
            if ((gx + gy) % 2 === 0) ctx.fillRect(gx * CELL, gy * CELL, CELL, CELL);
          }
        }
        // soft vignette so the play area pops
        var vig = ctx.createRadialGradient(
          canvas.width / 2, canvas.height / 2, canvas.height * 0.3,
          canvas.width / 2, canvas.height / 2, canvas.height * 0.85
        );
        vig.addColorStop(0, 'rgba(0,0,0,0)');
        vig.addColorStop(1, 'rgba(0,0,0,0.42)');
        ctx.fillStyle = vig;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        // bug — proper beetle (ladybug-ish)
        drawBeetle(bug.x * CELL + CELL / 2, bug.y * CELL + CELL / 2, bug.t);
        // snake
        for (var s = snake.length - 1; s >= 0; s--) {
          var seg = snake[s];
          var hue = s / Math.max(1, snake.length - 1);
          // gradient from #ffb86b (head) → #ff4848 (tail end)
          var t = 1 - hue;
          var rr = Math.round(255 - (255 - 255) * (1 - t));
          var gg = Math.round(184 + (72 - 184) * (1 - t));
          var bb = Math.round(107 + (72 - 107) * (1 - t));
          ctx.fillStyle = 'rgb(' + rr + ',' + gg + ',' + bb + ')';
          ctx.fillRect(seg.x * CELL + 2, seg.y * CELL + 2, CELL - 4, CELL - 4);
        }
        // head eye
        var h = snake[0];
        var hx = h.x * CELL + CELL / 2;
        var hy = h.y * CELL + CELL / 2;
        ctx.fillStyle = '#1a0508';
        var eyeR = 2.5;
        var ex = hx + dir.x * 4, ey = hy + dir.y * 4;
        ctx.beginPath();
        ctx.arc(ex, ey, eyeR, 0, Math.PI * 2);
        ctx.fill();
      }

      function loop(ts) {
        raf = requestAnimationFrame(loop);
        if (!lastStep) lastStep = ts;
        if (state === 'running' && ts - lastStep >= stepInterval) {
          step();
          lastStep = ts;
        }
        if (bug) bug.t = (bug.t || 0) + 0.18;
        draw();
      }

      function start() {
        if (state === 'over') reset();
        state = 'running';
        stage.classList.add('is-running');
        restartLabel.textContent = i18n.restart;
        if (!raf) raf = requestAnimationFrame(loop);
        stage.focus();
      }
      function pause() {
        state = 'paused';
        stage.classList.remove('is-running');
        statusEl.textContent = i18n.paused;
      }

      function setDir(d) {
        // disallow 180° reversal
        if (d.x === -dir.x && d.y === -dir.y) return;
        nextDir = d;
        if (state === 'idle' || state === 'paused') start();
      }

      // Keyboard
      function onKey(e) {
        if (app.getAttribute('data-open-window') !== 'snake') return;
        var k = e.key.toLowerCase();
        if (k === 'arrowup'    || k === 'w') { e.preventDefault(); setDir({ x: 0, y: -1 }); }
        else if (k === 'arrowdown'  || k === 's') { e.preventDefault(); setDir({ x: 0, y:  1 }); }
        else if (k === 'arrowleft'  || k === 'a') { e.preventDefault(); setDir({ x: -1, y: 0 }); }
        else if (k === 'arrowright' || k === 'd') { e.preventDefault(); setDir({ x:  1, y: 0 }); }
        else if (k === ' ' || k === 'spacebar') {
          e.preventDefault();
          if (state === 'running') pause();
          else start();
        }
      }
      window.addEventListener('keydown', onKey);

      // Tap on stage starts/pauses
      stage.addEventListener('click', function (e) {
        if (e.target.closest('.sk-dpad_btn')) return;
        if (state === 'running') pause();
        else start();
      });

      restartBtn.addEventListener('click', function () {
        if (state === 'over') reset();
        start();
      });

      // D-pad
      win.querySelectorAll('[data-snake-dir]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var d = btn.getAttribute('data-snake-dir');
          if (d === 'up')    setDir({ x: 0, y: -1 });
          if (d === 'down')  setDir({ x: 0, y:  1 });
          if (d === 'left')  setDir({ x: -1, y: 0 });
          if (d === 'right') setDir({ x:  1, y: 0 });
        });
      });

      // Swipe
      var tStart = null;
      stage.addEventListener('touchstart', function (e) {
        var t = e.touches[0];
        tStart = { x: t.clientX, y: t.clientY };
      }, { passive: true });
      stage.addEventListener('touchend', function (e) {
        if (!tStart) return;
        var t = e.changedTouches[0];
        var dx = t.clientX - tStart.x;
        var dy = t.clientY - tStart.y;
        tStart = null;
        if (Math.abs(dx) < 24 && Math.abs(dy) < 24) return;
        if (Math.abs(dx) > Math.abs(dy)) setDir({ x: dx > 0 ? 1 : -1, y: 0 });
        else setDir({ x: 0, y: dy > 0 ? 1 : -1 });
      });

      // Pause when window closes
      var mo = new MutationObserver(function () {
        if (app.getAttribute('data-open-window') !== 'snake' && state === 'running') pause();
      });
      mo.observe(app, { attributes: true, attributeFilter: ['data-open-window'] });

      reset();
    }
    function ctx_safe(c) { try { return !!c.getContext('2d'); } catch (e) { return false; } }

    // ---------- Messages → bridge to n8n chatbot ----------
    function initMessagesBridge(app) {
      var btn = app.querySelector('[data-msg-continue]');
      if (!btn) return;
      btn.addEventListener('click', function () {
        // Close the iPad window first
        app.removeAttribute('data-open-window');
        // Trigger the global n8n chat toggle
        setTimeout(function () {
          var t = document.querySelector('#n8n-chat .chat-window-toggle');
          if (t) t.click();
        }, 220);
      });
    }

    // ---------- Battery indicator ----------
    function initBattery(stage) {
      var level = stage.querySelector('[data-battery-level]');
      var pct = stage.querySelector('[data-battery-pct]');
      if (!level || !pct) return;
      function paint(value, charging) {
        var v = Math.max(0.04, Math.min(1, value));
        level.style.width = (v * 100).toFixed(0) + '%';
        pct.textContent = Math.round(v * 100) + '%';
        level.style.background = v < 0.2 ? '#ff3b30' : (charging ? '#1ED760' : 'rgba(240, 237, 230, 0.92)');
      }
      if (navigator.getBattery) {
        navigator.getBattery().then(function (b) {
          paint(b.level, b.charging);
          b.addEventListener('levelchange', function () { paint(b.level, b.charging); });
          b.addEventListener('chargingchange', function () { paint(b.level, b.charging); });
        }).catch(function () { paint(0.82, false); });
      } else {
        paint(0.82, false);
      }
    }

    // ---------- Tabs ----------
    function initTabs(app) {
      var tabs = app.querySelectorAll('.ipad-tab');
      var pill = app.querySelector('.ipad-tab_pill');
      if (!tabs.length || !pill) return;

      function movePill(target) {
        var parentRect = target.parentElement.getBoundingClientRect();
        var rect = target.getBoundingClientRect();
        pill.style.width = rect.width + 'px';
        pill.style.left = (rect.left - parentRect.left) + 'px';
      }

      function activate(target, opts) {
        opts = opts || {};
        tabs.forEach(function (t) {
          var on = t === target;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        var key = target.getAttribute('data-tab');
        if (key === 'all') app.removeAttribute('data-tab-active');
        else app.setAttribute('data-tab-active', key);
        movePill(target);
      }

      tabs.forEach(function (t) {
        t.addEventListener('click', function () { activate(t); });
      });

      // initial pill placement (after layout settles)
      var initial = app.querySelector('.ipad-tab.is-active') || tabs[0];
      requestAnimationFrame(function () { movePill(initial); });
      window.addEventListener('resize', function () {
        var active = app.querySelector('.ipad-tab.is-active') || tabs[0];
        movePill(active);
      });
    }

    // ---------- Live search filter ----------
    function initSearch(app) {
      var input = app.querySelector('[data-search]');
      if (!input) return;
      var cols = app.querySelectorAll('.ipad-col');
      var mobileMQ = window.matchMedia('(max-width: 768px)');

      function pad(n) { return (n < 10 ? '0' : '') + n; }

      function apply() {
        var q = input.value.trim().toLowerCase();
        var isMobile = mobileMQ.matches;
        cols.forEach(function (col) {
          var allItems = Array.prototype.slice.call(col.querySelectorAll('.ipad-list > li'));
          var items = isMobile ? allItems.slice(0, 2) : allItems;
          // hide items beyond the mobile limit from search interactions
          allItems.slice(items.length).forEach(function (li) {
            li.classList.remove('is-hidden');
          });
          var visible = 0;
          items.forEach(function (li) {
            var hay = li.getAttribute('data-search') || '';
            var match = !q || hay.indexOf(q) !== -1;
            li.classList.toggle('is-hidden', !match);
            if (match) visible++;
          });
          col.classList.toggle('is-empty', visible === 0);
          var count = col.querySelector('[data-count]');
          if (count) {
            var total = items.length;
            count.textContent = (q ? visible : total) + '/' + pad(total);
          }
        });
      }
      input.addEventListener('input', apply);
      mobileMQ.addEventListener
        ? mobileMQ.addEventListener('change', apply)
        : mobileMQ.addListener(apply);
      apply();

      // ⌘K / Ctrl+K to focus
      window.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          if (input.getBoundingClientRect().top > 0) {
            e.preventDefault();
            input.focus();
            input.select();
          }
        }
      });
    }

    // ---------- Sort toggle ----------
    function initSort(app) {
      var btn = app.querySelector('[data-sort]');
      var label = app.querySelector('[data-sort-label]');
      if (!btn) return;
      var labels = {
        en: { newest: 'Newest', oldest: 'Oldest' },
        de: { newest: 'Neueste', oldest: 'Älteste' },
      };
      btn.addEventListener('click', function () {
        var current = btn.getAttribute('data-sort') || 'newest';
        var next = current === 'newest' ? 'oldest' : 'newest';
        btn.setAttribute('data-sort', next);
        if (label) label.textContent = (labels[lang] || labels.en)[next];

        app.querySelectorAll('.ipad-list[data-sortable]').forEach(function (list) {
          var lis = Array.prototype.slice.call(list.children);
          lis.reverse();
          lis.forEach(function (li, i) {
            list.appendChild(li);
            var idx = li.querySelector('.ipad-item_index');
            if (idx) idx.textContent = '0' + (i + 1);
          });
        });
      });
    }

    // ---------- App windows ----------
    function initWindows(app) {
      var openers = app.querySelectorAll('[data-open]');
      var closers = app.querySelectorAll('[data-close]');

      function open(name) {
        app.setAttribute('data-open-window', name);
      }
      function close() {
        app.removeAttribute('data-open-window');
      }

      openers.forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          open(btn.getAttribute('data-open'));
        });
      });
      closers.forEach(function (el) {
        el.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          close();
        });
      });

      // ESC closes
      window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && app.hasAttribute('data-open-window')) close();
      });

      // Clicking outside the window (on the dimmed background) closes
      app.addEventListener('click', function (e) {
        if (!app.hasAttribute('data-open-window')) return;
        var win = e.target.closest('.ipad-win');
        var opener = e.target.closest('[data-open]');
        if (!win && !opener) close();
      });
    }

    // ---------- Custom hand cursor inside the iPad ----------
    function initHandCursor(stage, frame) {
      var cursor = stage.querySelector('[data-ipad-cursor]');
      if (!cursor || !frame) return;
      if (window.matchMedia('(pointer: coarse)').matches) return;

      // Hoist to <body> so no transformed ancestor (Webflow IX2 inline
      // transforms on section_home-work) breaks `position: fixed`.
      document.body.appendChild(cursor);

      var w = cursor.offsetWidth || 36;
      var h = cursor.offsetHeight || 36;
      // hot-spot offset — the SF hand points up with the index finger
      // tip near the top-centre of the SVG (~50% / 14%).
      var hotX = w * 0.5;
      var hotY = h * 0.14;

      var targetX = 0, targetY = 0;
      var x = 0, y = 0;
      var raf = null;
      var inside = false;

      function tick() {
        x += (targetX - x) * 0.32;
        y += (targetY - y) * 0.32;
        cursor.style.transform = 'translate3d(' + (x - hotX) + 'px, ' + (y - hotY) + 'px, 0)';
        raf = inside ? requestAnimationFrame(tick) : null;
      }

      frame.addEventListener('mouseenter', function (e) {
        targetX = x = e.clientX;
        targetY = y = e.clientY;
        cursor.classList.add('is-active', 'is-wave');
        setTimeout(function () { cursor.classList.remove('is-wave'); }, 720);
        inside = true;
        if (!raf) raf = requestAnimationFrame(tick);
      });
      frame.addEventListener('mouseleave', function () {
        inside = false;
        cursor.classList.remove('is-active', 'is-hover', 'is-down');
      });
      frame.addEventListener('mousemove', function (e) {
        targetX = e.clientX;
        targetY = e.clientY;
        if (!raf && inside) raf = requestAnimationFrame(tick);
      });

      var interactiveSel = 'a, button, [role="button"], input, textarea, label, [data-tooltip]';
      frame.addEventListener('mouseover', function (e) {
        if (e.target instanceof Element && e.target.closest(interactiveSel)) {
          cursor.classList.add('is-hover');
        }
      });
      frame.addEventListener('mouseout', function (e) {
        if (e.target instanceof Element && e.target.closest(interactiveSel)) {
          if (!e.relatedTarget || !(e.relatedTarget instanceof Element) || !e.relatedTarget.closest(interactiveSel)) {
            cursor.classList.remove('is-hover');
          }
        }
      });

      frame.addEventListener('mousedown', function () { cursor.classList.add('is-down'); });
      frame.addEventListener('mouseup',   function () { cursor.classList.remove('is-down'); });
    }

    function init() {
      var stage = document.querySelector('[data-ipad-stage]');
      if (!stage) return;
      var frame = stage.querySelector('[data-ipad-frame]');
      var header = stage.querySelector('[data-ipad-header]');
      var app = stage.querySelector('[data-ipad-app]');

      if (frame && header) initScroll(stage, frame, header);
      if (frame) initHandCursor(stage, frame);
      if (app) {
        initClock(stage);
        initBattery(stage);
        initTabs(app);
        initSearch(app);
        initSort(app);
        initWindows(app);
        initNotif(app);
        initMessagesBridge(app);
        initSnake(app);
      }
    }

    if (document.readyState === 'complete') init();
    else window.addEventListener('load', init, { once: true });
  })();
</script>
