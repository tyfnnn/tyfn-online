  /* ============== NOTIFICATION CENTER ============== */
  .ipad-notif {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 8;
    max-height: 100%;
    padding: clamp(46px, 5.5vw, 64px) clamp(16px, 2vw, 28px) clamp(16px, 2vw, 24px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
    transition: opacity 0.32s ease, transform 0.42s cubic-bezier(0.32, 0.72, 0.24, 1);
    overflow-y: auto;
  }
  .ipad-notif::before {
    /* full-screen scrim with strong blur */
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(32px) saturate(160%);
    -webkit-backdrop-filter: blur(32px) saturate(160%);
    z-index: -1;
  }
  .ipad-screen.is-notif-open .ipad-notif {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .ipad-notif_head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0 4px 4px;
  }
  .ipad-notif_title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }
  .ipad-notif_clear {
    background: transparent;
    border: 0;
    color: #ff9b6e;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .ipad-notif_list { display: flex; flex-direction: column; gap: 8px; }
  .ipad-notif_card {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 12px 14px;
    border-radius: 14px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.05) 100%);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.26);
    text-decoration: none;
    color: #fff;
    transition: transform 0.2s ease, border-color 0.2s ease;
    animation: notifSlideIn 0.45s cubic-bezier(0.32, 0.72, 0.24, 1) backwards;
  }
  .ipad-notif_card:nth-child(2) { animation-delay: 0.05s; }
  .ipad-notif_card:nth-child(3) { animation-delay: 0.10s; }
  .ipad-notif_card:nth-child(4) { animation-delay: 0.15s; }
  .ipad-notif_card:nth-child(5) { animation-delay: 0.20s; }
  @keyframes notifSlideIn {
    from { opacity: 0; transform: translateY(-12px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)     scale(1); }
  }
  .ipad-notif_card--accent {
    background:
      linear-gradient(180deg, rgba(255, 140, 90, 0.22) 0%, rgba(255, 72, 72, 0.10) 100%);
    border-color: rgba(255, 154, 110, 0.45);
  }
  .ipad-notif_card:not(.ipad-notif_card--accent):hover {
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.30);
  }
  a.ipad-notif_card:hover { transform: translateY(-2px); }
  .ipad-notif_icon {
    width: 32px; height: 32px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 14px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.32);
  }
  .ipad-notif_card_title { font-size: 13px; font-weight: 600; color: #fff; }
  .ipad-notif_card_body { font-size: 11.5px; color: rgba(255, 255, 255, 0.75); margin-top: 2px; }
  .ipad-notif_time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.55);
    align-self: flex-start;
  }

