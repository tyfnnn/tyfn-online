    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .msg-side_head {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(232, 232, 235, 0.5);
    padding: 4px 6px 2px;
  }
  .msg-thread {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s ease;
  }
  .msg-thread.is-active { background: rgba(0, 122, 255, 0.16); }
  .msg-thread:not(.is-active):hover { background: rgba(255, 255, 255, 0.04); }
  .msg-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    overflow: hidden;
    background: #2a2a2a;
    display: grid;
    place-items: center;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .msg-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .msg-avatar--lg { width: 44px; height: 44px; }
  .msg-thread_text { min-width: 0; }
  .msg-thread_name { font-size: 12px; font-weight: 600; color: #fff; }
  .msg-thread_snippet {
    font-size: 11px;
    color: rgba(232, 232, 235, 0.6);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .msg-thread_meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    color: rgba(232, 232, 235, 0.5);
  }

  .msg-thread_view {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: #0e0e0f;
    overflow: hidden;
  }
  .msg-thread_header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: center;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .msg-thread_status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: rgba(232, 232, 235, 0.6);
  }
  .msg-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 8px rgba(52, 211, 153, 0.7);
  }

  .msg-thread_stage {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .msg-day {
    align-self: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: rgba(232, 232, 235, 0.45);
    padding: 4px 0 6px;
  }
  .msg-bubble {
    max-width: 70%;
    padding: 9px 13px;
    border-radius: 18px;
    font-size: 13.5px;
    line-height: 1.4;
    word-wrap: break-word;
    animation: msgPop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  }
  .msg-bubble strong {
    font-weight: 600;
    color: inherit;
  }
  .msg-bubble--in {
    align-self: flex-start;
    background: #29292b;
    color: #fff;
    border-bottom-left-radius: 5px;
  }
  .msg-bubble--out {
    align-self: flex-end;
    background: linear-gradient(180deg, #2a8cff 0%, #0a6eff 100%);
    color: #fff;
    border-bottom-right-radius: 5px;
    box-shadow: 0 4px 12px rgba(10, 110, 255, 0.25);
  }
  .msg-bubble--typing {
    display: inline-flex;
    gap: 4px;
    padding: 12px 14px;
  }
  .msg-bubble--typing span {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.55);
    animation: msgTyping 1.2s ease-in-out infinite;
  }
  .msg-bubble--typing span:nth-child(2) { animation-delay: 0.15s; }
  .msg-bubble--typing span:nth-child(3) { animation-delay: 0.30s; }
  @keyframes msgTyping {
    0%, 60%, 100% { transform: scale(0.8); opacity: 0.5; }
    30% { transform: scale(1.2); opacity: 1; }
  }
  @keyframes msgPop {
    from { opacity: 0; transform: translateY(6px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
  }

  .msg-meta {
    margin: 0 18px;
    padding: 10px 14px;
    background: rgba(10, 110, 255, 0.08);
    border: 1px solid rgba(10, 110, 255, 0.22);
    border-radius: 10px;
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-size: 13px;
    color: #d6d6da;
  }
  .msg-meta strong {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-style: normal;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #79bfff;
    margin-bottom: 4px;
    font-weight: 500;
  }
  .msg-meta p { margin: 0; }

  .msg-continue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    margin: 12px 18px 18px;
    padding: 10px 16px;
    border-radius: 999px;
    background: #0a6eff;
    border: 0;
    color: #fff;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(10, 110, 255, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .msg-continue img { width: 16px; height: 16px; border-radius: 4px; }
  .msg-continue:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(10, 110, 255, 0.45); }
  .msg-continue_arrow { transition: transform 0.2s ease; }
  .msg-continue:hover .msg-continue_arrow { transform: translateX(3px); }

  /* ============== SNAKE / BUG HUNT ============== */
  .ipad-win--snake {
    background:
      radial-gradient(120% 60% at 0% 0%, rgba(255, 116, 72, 0.10) 0%, transparent 55%),
      linear-gradient(180deg, #1a0f0a 0%, #0a0507 100%);
    color: #f0ede6;
    --sk-accent: #ff9b6e;
  }
  .ipad-win_chrome--snake {
    background: linear-gradient(180deg, #1f1410 0%, #14080a 100%);
    border-bottom: 1px solid rgba(255, 116, 72, 0.12);
  }
  .sk-toolbar { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; color: #d9d3c8; }
  .sk-icon { width: 18px; height: 18px; border-radius: 5px; }
  .sk-brand { font-weight: 600; }
  .sk-divider { width: 1px; height: 14px; background: rgba(255, 255, 255, 0.10); }
  .sk-prompt {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10.5px;
    color: var(--sk-accent);
  }
  .sk-caret {
    display: inline-block;
    width: 7px;
    background: var(--sk-accent);
    color: transparent;
    margin-left: 4px;
    animation: skBlink 1s steps(2, end) infinite;
  }
  @keyframes skBlink { 50% { opacity: 0; } }

  .sk-body {
    flex: 1;
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: clamp(14px, 1.6vw, 22px);
    padding: clamp(14px, 1.8vw, 22px);
    min-height: 0;
  }
  .sk-stats {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .sk-stat {
    padding: 12px 14px;
    border-radius: 14px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%),
      linear-gradient(180deg, rgba(20, 14, 12, 0.65) 0%, rgba(10, 5, 7, 0.75) 100%);
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }
  .sk-stat_label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(240, 237, 230, 0.45);
    margin-bottom: 4px;
  }
  .sk-stat_value {
    font-family: 'JetBrains Mono', monospace;
    font-feature-settings: 'tnum';
    font-size: 28px;
    font-weight: 600;
    color: #fff;
    line-height: 1;
  }
  .sk-hint {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: rgba(240, 237, 230, 0.4);
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px dashed rgba(255, 255, 255, 0.08);
  }
  .sk-restart {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    cursor: pointer;
    margin-top: auto;
    padding: 10px 16px;
    border-radius: 999px;
    background: linear-gradient(180deg, #ff8e5c, #ff4848);
    color: #1a0508;
    font-weight: 700;
    font-size: 12px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      0 6px 16px rgba(255, 116, 72, 0.35);
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .sk-restart:hover { transform: translateY(-2px); filter: brightness(1.05); }

  /* Stage / canvas */
  .sk-stage {
    position: relative;
    border-radius: 14px;
    background: #2a1d20;
    border: 1px solid rgba(255, 116, 72, 0.22);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.04),
      inset 0 0 60px rgba(255, 116, 72, 0.10),
      0 6px 22px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    display: grid;
    place-items: center;
    min-height: 0;
    outline: none;
    cursor: pointer;
  }
  .sk-stage canvas {
    display: block;
    max-width: 100%;
    max-height: 100%;
    image-rendering: pixelated;
    -ms-interpolation-mode: nearest-neighbor;
  }
  .sk-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    pointer-events: none;
    background: rgba(6, 3, 4, 0.4);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 1;
    transition: opacity 0.2s ease;
  }
  .sk-stage.is-running .sk-overlay { opacity: 0; }
  .sk-overlay_message {
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: #f0ede6;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  /* D-pad — hidden on desktop, shown on touch */
  .sk-dpad {
    position: absolute;
    bottom: 8px;
    right: 8px;
    width: 96px;
    height: 96px;
    display: none;
    z-index: 3;
  }
  .sk-dpad_btn {
    position: absolute;
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    background: rgba(255, 255, 255, 0.10);
    color: #fff;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    font-size: 12px;
    cursor: pointer;
    backdrop-filter: blur(10px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }
  .sk-dpad_btn--u { top: 0;  left: 34px; }
  .sk-dpad_btn--d { bottom: 0; left: 34px; }
  .sk-dpad_btn--l { left: 0;  top: 34px; }
  .sk-dpad_btn--r { right: 0; top: 34px; }
  @media (pointer: coarse), (hover: none) {
    .sk-dpad { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sk-caret { animation: none; }
  }

  /* Hide windows on mobile — too cramped to be useful */
  @media (max-width: 768px) {
    .ipad-win { inset: 30px 8px 70px; }
    .ipad-app[data-open-window] .ipad-win .xc-body,
    .ipad-app[data-open-window] .ipad-win .as-body,
    .ipad-app[data-open-window] .ipad-win .ws-body,
    .ipad-app[data-open-window] .ipad-win .fg-body,
    .ipad-app[data-open-window] .ipad-win .ob-body,
    .ipad-app[data-open-window] .ipad-win .msg-body,
    .ipad-app[data-open-window] .ipad-win .sk-body { grid-template-columns: 1fr; }
    .xc-nav, .xc-inspector, .as-nav, .as-preview, .ws-nav, .ws-side, .fg-layers, .fg-props, .ob-nav, .ob-graph, .msg-sidebar { display: none; }
    .sk-stats { display: none; }
    .ipad-notif_card { padding: 10px 12px; }
    .msg-bubble { max-width: 82%; font-size: 12.5px; }
    .msg-meta { font-size: 11.5px; padding: 8px 10px; }
  }
  .ipad-app_title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: #F0EDE6;
    font-weight: 500;
  }
  .ipad-app_title > span:last-child::before { content: '/ '; color: rgba(240, 237, 230, 0.4); }
  .ipad-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .ipad-dot--orange { background: linear-gradient(135deg, #ff7448, #ff4848); box-shadow: 0 0 12px rgba(255, 116, 72, 0.5); }
  .ipad-search {
    width: 26px; height: 26px;
    border-radius: 8px;
    display: inline-grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(240, 237, 230, 0.7);
    font-size: 14px;
  }

  .ipad-app_body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(12px, 1.4vw, 18px);
  }

  .ipad-col {
    display: flex;
    flex-direction: column;
    min-height: 0;
    background:
      linear-gradient(180deg, rgba(20, 22, 30, 0.42) 0%, rgba(10, 12, 18, 0.55) 100%);
    backdrop-filter: blur(20px) saturate(170%);
    -webkit-backdrop-filter: blur(20px) saturate(170%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 22px;
    padding: clamp(12px, 1.2vw, 16px);
    gap: clamp(8px, 0.8vw, 12px);
    box-shadow:
      0 12px 32px rgba(0, 0, 0, 0.32);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    /* keep repaints inside the column so backdrop-filter
       recomposition can't ghost on the other column's edge */
    contain: layout paint;
  }
  .ipad-col_head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 2px 4px 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: clamp(6px, 0.6vw, 10px);
  }
  .ipad-col_index {
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.4rem, 1.6vw, 1.8rem);
    line-height: 1;
    color: #ff9b6e;
    background: linear-gradient(135deg, #ff7448, #ff4848);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    padding-right: 6px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }
  .ipad-col_title {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    min-width: 0;
  }
  .ipad-col_title-main {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(0.7rem, 0.78vw, 0.82rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #F0EDE6;
  }
  .ipad-col_title-meta {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.66rem;
    color: rgba(240, 237, 230, 0.4);
    letter-spacing: 0.08em;
  }
  .ipad-col_all {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 500;
    color: rgba(240, 237, 230, 0.55);
    text-decoration: none;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    transition: color 0.2s ease;
    white-space: nowrap;
  }
  .ipad-col_all:hover { color: #ff9b6e; }
  .ipad-col_all span { display: inline-block; transition: transform 0.2s ease; }
  .ipad-col_all:hover span { transform: translateX(3px); }

  .ipad-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 0.7vw, 10px);
    flex: 1;
    min-height: 0;
  }
  .ipad-list li { display: contents; }

  .ipad-item {
    position: relative;
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px 10px 8px;
    border-radius: 16px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0) 100%),
      linear-gradient(180deg, rgba(10, 12, 18, 0.50) 0%, rgba(6, 8, 12, 0.60) 100%);
    border: 1px solid rgba(255, 255, 255, 0.10);
    text-decoration: none;
    color: #F0EDE6;
    overflow: hidden;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    isolation: isolate;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      inset 0 -1px 0 rgba(0, 0, 0, 0.18);
    contain: layout paint;
  }
  .ipad-item_index {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 500;
    color: rgba(240, 237, 230, 0.32);
    letter-spacing: 0.06em;
    min-width: 18px;
    text-align: center;
    transition: color 0.25s ease;
  }
  .ipad-item:hover .ipad-item_index { color: #ff9b6e; }
  .ipad-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 116, 72, 0.14), rgba(124, 90, 255, 0.10));
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
  }
  .ipad-item:hover {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.02) 100%),
      linear-gradient(180deg, rgba(10, 12, 18, 0.55) 0%, rgba(6, 8, 12, 0.65) 100%);
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      inset 0 -1px 0 rgba(0, 0, 0, 0.18);
  }
  .ipad-item:hover::before { opacity: 1; }

  .ipad-item_thumb {
    width: 56px;
    height: 56px;
    border-radius: 11px;
    background-color: #1a1a1a;
    background-size: cover;
    background-position: center;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.10),
      0 6px 12px rgba(0, 0, 0, 0.35);
    position: relative;
    flex-shrink: 0;
  }
  .ipad-item_accent {
    width: 6px;
    height: 48px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .ipad-item_text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .ipad-item_title {
    font-size: clamp(0.82rem, 0.9vw, 0.95rem);
    font-weight: 600;
    line-height: 1.25;
    color: #F0EDE6;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .ipad-item_meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 0.7rem;
    color: rgba(240, 237, 230, 0.52);
  }
  .ipad-item_status {
    color: rgba(240, 237, 230, 0.52);
    letter-spacing: 0.02em;
  }
  .ipad-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0a0a0a;
  }
  .ipad-pill--ghost {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.06) 100%) !important;
    color: rgba(240, 237, 230, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }
  .ipad-item_arrow {
    color: rgba(240, 237, 230, 0.4);
    font-size: 1rem;
    transition: transform 0.25s ease, color 0.25s ease;
  }
  .ipad-item:hover .ipad-item_arrow {
    color: #ff9b6e;
    transform: translateX(3px);
  }

  /* Dock at bottom */
  .ipad-dock {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 1vw, 14px);
    padding: 8px clamp(14px, 1.6vw, 22px);
    border-radius: 26px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 100%),
      linear-gradient(180deg, rgba(14, 16, 22, 0.55) 0%, rgba(8, 10, 14, 0.65) 100%);
    backdrop-filter: blur(40px) saturate(200%);
    -webkit-backdrop-filter: blur(40px) saturate(200%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    margin: 0 auto;
    width: max-content;
    max-width: 100%;
    box-shadow:
