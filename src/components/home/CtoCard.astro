---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../../i18n/t';
import { getBlogPosts, postHref, formatDate } from '../../lib/blog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const portfolioHref = getRelativeLocaleUrl(lang, '/portfolio/');
const blogHref = getRelativeLocaleUrl(lang, '/blog/');

const projects = [
  {
    href: getRelativeLocaleUrl(lang, '/portfolio/easyngo/'),
    title: t('portfolio.easyngo.card_title'),
    tag: t('portfolio.easyngo.tag_3'),
    status: t('portfolio.easyngo.status'),
    image:
      'https://res.cloudinary.com/dmokvj08w/image/upload/v1752658414/zentrik-accounting_hqbrnv.png',
    accent: 'linear-gradient(135deg, #6e8efb, #4f6df5)',
  },
  {
    href: getRelativeLocaleUrl(lang, '/portfolio/redact/'),
    title: t('portfolio.redact.card_title'),
    tag: t('portfolio.redact.tag_5'),
    status: t('portfolio.redact.status'),
    image: '/portfolio/redact/redact-logo.png',
    accent: 'linear-gradient(135deg, #6B9FFF, #2A4FAA)',
  },
  {
    href: getRelativeLocaleUrl(lang, '/portfolio/stellar-horizon/'),
    title: t('portfolio.stellar.card_title'),
    tag: t('portfolio.stellar.tag_1'),
    status: t('portfolio.stellar.status'),
    image:
      'https://res.cloudinary.com/dmokvj08w/image/upload/v1752659137/stellar-horizon-title_h0aah5.png',
    accent: 'linear-gradient(135deg, #ff7448, #ff4848)',
  },
].slice(0, 4);

const allPosts = await getBlogPosts(lang);
const posts = allPosts.slice(0, 4).map((entry) => ({
  href: postHref(lang, entry),
  title: entry.data.title,
  description: entry.data.description,
  date: formatDate(entry.data.pubDate, lang),
  tag: entry.data.tags?.[0] ?? '',
  image: entry.data.heroImage ?? '',
}));

const accents = [
  'linear-gradient(135deg, #ff7448, #ff4848)',
  'linear-gradient(135deg, #ffb86b, #ff7448)',
  'linear-gradient(135deg, #7ad0ff, #4f8df5)',
  'linear-gradient(135deg, #c69bff, #ff6bbd)',
];
---
<section class="cto-section ipad-cto">
  <div class="padding-global-2">
    <div class="ipad-stage" data-ipad-stage>
      <!-- editorial framing -->
      <div class="ipad-margin ipad-margin--top" aria-hidden="true">
        <span class="ipad-marker">↳ index 0—1</span>
        <span class="ipad-hairline"></span>
        <span class="ipad-marker ipad-marker--right">live · runtime · v{(new Date()).getFullYear()}</span>
      </div>

      <div class="ipad-frame" data-ipad-frame data-cursor="off">
        <span class="ipad-corner ipad-corner--tl" aria-hidden="true"></span>
        <span class="ipad-corner ipad-corner--tr" aria-hidden="true"></span>
        <span class="ipad-corner ipad-corner--bl" aria-hidden="true"></span>
        <span class="ipad-corner ipad-corner--br" aria-hidden="true"></span>

        <span class="ipad-camera" aria-hidden="true"></span>

        <div class="ipad-frame_inner">
          <div class="ipad-screen" data-ipad-screen>

            <!-- NOTIFICATION CENTER -->
            <div class="ipad-notif" data-ipad-notif aria-hidden="true">
              <div class="ipad-notif_head">
                <span class="ipad-notif_title">{t('cto.notif_title')}</span>
                <button type="button" class="ipad-notif_clear" data-notif-close>{t('cto.notif_clear')}</button>
              </div>
              <div class="ipad-notif_list">
                <a class="ipad-notif_card ipad-notif_card--accent" href={`mailto:${t('common.email')}`}>
                  <span class="ipad-notif_icon" style="background:linear-gradient(135deg,#ff8e5c,#ff4848);">✉</span>
                  <div class="ipad-notif_text">
                    <div class="ipad-notif_card_title">{t('cto.notif_hire_title')}</div>
                    <div class="ipad-notif_card_body">{t('cto.notif_hire_body')}</div>
                  </div>
                  <span class="ipad-notif_time">{t('cto.notif_now')}</span>
                </a>
                <div class="ipad-notif_card">
                  <span class="ipad-notif_icon" style="background:linear-gradient(135deg,#a78bfa,#7c3aed);">●</span>
                  <div class="ipad-notif_text">
                    <div class="ipad-notif_card_title">{t('cto.notif_inquiry_title')}</div>
                    <div class="ipad-notif_card_body">{t('cto.notif_inquiry_body')}</div>
                  </div>
                  <span class="ipad-notif_time">2m</span>
                </div>
                <div class="ipad-notif_card">
                  <span class="ipad-notif_icon" style="background:linear-gradient(135deg,#86d9ff,#1f7af0);">◴</span>
                  <div class="ipad-notif_text">
                    <div class="ipad-notif_card_title">{t('cto.notif_calendar_title')}</div>
                    <div class="ipad-notif_card_body">{t('cto.notif_calendar_body')}</div>
                  </div>
                  <span class="ipad-notif_time">5m</span>
                </div>
                <div class="ipad-notif_card">
                  <span class="ipad-notif_icon" style="background:linear-gradient(180deg,#3a3a3a,#0a0a0a);">⌥</span>
                  <div class="ipad-notif_text">
                    <div class="ipad-notif_card_title">{t('cto.notif_github_title')}</div>
                    <div class="ipad-notif_card_body">{t('cto.notif_github_body')}</div>
                  </div>
                  <span class="ipad-notif_time">1h</span>
                </div>
                <div class="ipad-notif_card">
                  <span class="ipad-notif_icon" style="background:linear-gradient(135deg,#1ED760,#0d6e2c);">◉</span>
                  <div class="ipad-notif_text">
                    <div class="ipad-notif_card_title">{t('cto.notif_calm_title')}</div>
                    <div class="ipad-notif_card_body">{t('cto.notif_calm_body')}</div>
                  </div>
                  <span class="ipad-notif_time">3h</span>
                </div>
              </div>
            </div>

            <div class="ipad-statusbar">
              <button type="button" class="ipad-statusbar_left" data-toggle="notif" aria-label="Notifications">
                <span class="ipad-time" data-clock-time>9:41</span>
                <span class="ipad-date" data-clock-date></span>
              </button>
              <span class="ipad-icons" aria-hidden="true">
                <span class="ipad-signal"></span>
                <span class="ipad-wifi"></span>
                <span class="ipad-battery" data-battery>
                  <span class="ipad-battery_level" data-battery-level></span>
                </span>
                <span class="ipad-battery_pct" data-battery-pct></span>
              </span>
            </div>

            <div class="ipad-app" data-ipad-app>
              <div class="ipad-app_head">
                <div class="ipad-app_title">
                  <span class="ipad-dot ipad-dot--orange"></span>
                  <span>tyfn.online</span>
                </div>

                <div class="ipad-tabs" role="tablist">
                  <button type="button" class="ipad-tab is-active" role="tab" aria-selected="true" data-tab="all">{t('cto.tab_all')}</button>
                  <button type="button" class="ipad-tab" role="tab" aria-selected="false" data-tab="projects">{t('cto.tab_projects')}</button>
                  <button type="button" class="ipad-tab" role="tab" aria-selected="false" data-tab="writing">{t('cto.tab_writing')}</button>
                  <span class="ipad-tab_pill" aria-hidden="true"></span>
                </div>

                <label class="ipad-searchbar">
                  <span class="ipad-searchbar_icon" aria-hidden="true">⌕</span>
                  <input
                    type="search"
                    class="ipad-searchbar_input"
                    placeholder={t('cto.search_placeholder')}
                    aria-label={t('cto.search_placeholder')}
                    data-search
                  />
                  <kbd class="ipad-searchbar_kbd" aria-hidden="true">⌘K</kbd>
                </label>

                <button type="button" class="ipad-sort" data-sort="newest" aria-label="Toggle sort order">
                  <span class="ipad-sort_arrow" aria-hidden="true">↓</span>
                  <span class="ipad-sort_label" data-sort-label>{t('cto.sort_newest')}</span>
                </button>
              </div>

              <div class="ipad-app_body" data-ipad-body>
                <!-- Portfolio column -->
                <section class="ipad-col" data-list="projects">
                  <header class="ipad-col_head">
                    <span class="ipad-col_index">A</span>
                    <h3 class="ipad-col_title">
                      <span class="ipad-col_title-main">{t('cto.list_projects')}</span>
                      <span class="ipad-col_title-meta" data-count>{projects.length}/04</span>
                    </h3>
                    <a class="ipad-col_all" href={portfolioHref}>
                      {t('cto.view_all')} <span aria-hidden="true">→</span>
                    </a>
                  </header>

                  <ul class="ipad-list" data-sortable>
                    {projects.map((p, i) => (
                      <li data-search={`${p.title} ${p.tag} ${p.status}`.toLowerCase()}>
                        <a class="ipad-item ipad-item--project" href={p.href}>
                          <span class="ipad-item_index" aria-hidden="true">0{i + 1}</span>
                          <span
                            class="ipad-item_thumb"
                            style={`background-image:url('${p.image}'); --thumb-accent:${p.accent};`}
                            aria-hidden="true"
                          ></span>
                          <span class="ipad-item_text">
                            <span class="ipad-item_title">{p.title}</span>
                            <span class="ipad-item_meta">
                              <span class="ipad-pill" style={`background:${p.accent};`}>{p.tag}</span>
                              <span class="ipad-item_status">{p.status}</span>
                            </span>
                          </span>
                          <span class="ipad-item_arrow" aria-hidden="true">→</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <p class="ipad-empty" data-empty>{t('cto.empty')}</p>
                </section>

                <!-- Blog column -->
                <section class="ipad-col" data-list="writing">
                  <header class="ipad-col_head">
                    <span class="ipad-col_index">B</span>
                    <h3 class="ipad-col_title">
                      <span class="ipad-col_title-main">{t('cto.list_blog')}</span>
                      <span class="ipad-col_title-meta" data-count>{posts.length}/04</span>
                    </h3>
                    <a class="ipad-col_all" href={blogHref}>
                      {t('cto.view_all')} <span aria-hidden="true">→</span>
                    </a>
                  </header>

                  <ul class="ipad-list" data-sortable>
                    {posts.map((post, i) => (
                      <li data-search={`${post.title} ${post.tag} ${post.description}`.toLowerCase()}>
                        <a class="ipad-item ipad-item--post" href={post.href}>
                          <span class="ipad-item_index" aria-hidden="true">0{i + 1}</span>
                          {post.image ? (
                            <span
                              class="ipad-item_thumb"
                              style={`background-image:url('${post.image}');`}
                              aria-hidden="true"
                            ></span>
                          ) : (
                            <span
                              class="ipad-item_accent"
                              style={`background:${accents[i % accents.length]};`}
                              aria-hidden="true"
                            ></span>
                          )}
                          <span class="ipad-item_text">
                            <span class="ipad-item_title">{post.title}</span>
                            <span class="ipad-item_meta">
                              {post.tag && <span class="ipad-pill ipad-pill--ghost">#{post.tag}</span>}
                              <span class="ipad-item_status">{post.date}</span>
                            </span>
                          </span>
                          <span class="ipad-item_arrow" aria-hidden="true">→</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <p class="ipad-empty" data-empty>{t('cto.empty')}</p>
                </section>
              </div>

              <div class="ipad-dock">
                <button type="button" class="ipad-dock_app" data-open="xcode" data-tooltip="Xcode"><img src="/assets/xcode.svg" alt="" loading="lazy" /></button>
                <button type="button" class="ipad-dock_app" data-open="android-studio" data-tooltip="Android Studio"><img src="/assets/android-studio.svg" alt="" loading="lazy" /></button>
                <button type="button" class="ipad-dock_app" data-open="webstorm" data-tooltip="WebStorm"><img src="/assets/webstorm.svg" alt="" loading="lazy" /></button>
                <button type="button" class="ipad-dock_app" data-open="figma" data-tooltip="Figma"><img src="/assets/figma.svg" alt="" loading="lazy" /></button>
                <button type="button" class="ipad-dock_app" data-open="obsidian" data-tooltip="Obsidian"><img src="/assets/obsidian.svg" alt="" loading="lazy" /></button>
                <a class="ipad-dock_app ipad-dock_app--badge" href={`mailto:${t('common.email')}`} data-tooltip={`Mail — ${t('cto.inbox_label')}`} data-badge="1"><img src="/assets/mail.svg" alt="" loading="lazy" /></a>
                <button type="button" class="ipad-dock_app ipad-dock_app--badge" data-open="messages" data-tooltip="Messages" data-badge="3"><img src="/assets/messages.svg" alt="" loading="lazy" /></button>
                <button type="button" class="ipad-dock_app" data-open="snake" data-tooltip={t('cto.win_snake_title')}><img src="/assets/snake.svg" alt="" loading="lazy" /></button>
              </div>

              <!-- App windows (mock IDE / app overlays inside the iPad) -->
              <div class="ipad-windows" data-windows>

                <!-- ========== XCODE 26 ========== -->
                <section class="ipad-win ipad-win--xcode" data-window="xcode" aria-hidden="true">
                  <header class="ipad-win_chrome ipad-win_chrome--xcode">
                    <div class="ipad-win_lights" aria-hidden="true">
                      <span class="ipad-light ipad-light--r" data-close></span>
                      <span class="ipad-light ipad-light--y"></span>
                      <span class="ipad-light ipad-light--g"></span>
                    </div>
                    <div class="xc-toolbar">
                      <span class="xc-btn">▶</span>
                      <span class="xc-btn">■</span>
                      <span class="xc-divider"></span>
                      <span class="xc-scheme">
                        <span class="xc-scheme_dot"></span>
                        tyfn.app <span class="xc-scheme_caret">›</span> iPhone 16 Pro
                      </span>
                    </div>
                    <div class="xc-status">{t('cto.win_xcode_subtitle')}</div>
                  </header>
                  <div class="xc-body">
                    <aside class="xc-nav">
                      <div class="xc-nav_head">PROJECT</div>
                      <ul class="xc-tree">
                        <li class="xc-tree_group is-open">
                          <span class="xc-tree_label">▾ tyfn.app</span>
                          <ul>
                            <li class="xc-tree_group is-open">
                              <span class="xc-tree_label">▾ iOS</span>
                              <ul>
                                <li><span class="xc-file is-active">􀐘 tyfnApp.swift</span></li>
                                <li><span class="xc-file">􀐘 ContentView.swift</span></li>
                              </ul>
                            </li>
                            <li class="xc-tree_group">
                              <span class="xc-tree_label">▸ macOS</span>
                            </li>
                            <li class="xc-tree_group">
                              <span class="xc-tree_label">▸ watchOS</span>
                            </li>
                            <li class="xc-tree_group">
                              <span class="xc-tree_label">▸ iPadOS</span>
                            </li>
                            <li class="xc-tree_group">
                              <span class="xc-tree_label">▸ Assets.xcassets</span>
                            </li>
                          </ul>
                        </li>
                      </ul>
                    </aside>
                    <main class="xc-editor">
                      <div class="xc-tabbar">
                        <span class="xc-tab is-active">tyfnApp.swift</span>
                        <span class="xc-tab">ContentView.swift</span>
                      </div>
                      <pre class="xc-code"><code><span class="xc-ln">1</span>  <span class="xc-c">// {t('cto.win_xcode_lede')}</span>
<span class="xc-ln">2</span>  <span class="xc-kw">import</span> <span class="xc-id">SwiftUI</span>
<span class="xc-ln">3</span>
<span class="xc-ln">4</span>  <span class="xc-at">@main</span>
<span class="xc-ln">5</span>  <span class="xc-kw">struct</span> <span class="xc-ty">tyfnApp</span>: <span class="xc-ty">App</span> {'{'}
<span class="xc-ln">6</span>    <span class="xc-kw">var</span> body: <span class="xc-kw">some</span> <span class="xc-ty">Scene</span> {'{'}
<span class="xc-ln">7</span>      <span class="xc-ty">WindowGroup</span> {'{'} <span class="xc-ty">ContentView</span>() {'}'}
<span class="xc-ln">8</span>    {'}'}
<span class="xc-ln">9</span>  {'}'}
<span class="xc-ln">10</span>
<span class="xc-ln">11</span>  <span class="xc-kw">struct</span> <span class="xc-ty">ContentView</span>: <span class="xc-ty">View</span> {'{'}
<span class="xc-ln">12</span>    <span class="xc-kw">let</span> platforms = [<span class="xc-s">"iOS"</span>, <span class="xc-s">"macOS"</span>, <span class="xc-s">"watchOS"</span>, <span class="xc-s">"iPadOS"</span>]
<span class="xc-ln">13</span>
<span class="xc-ln">14</span>    <span class="xc-kw">var</span> body: <span class="xc-kw">some</span> <span class="xc-ty">View</span> {'{'}
<span class="xc-ln">15</span>      <span class="xc-ty">ForEach</span>(platforms, id: \.self) {'{'} <span class="xc-id">platform</span> <span class="xc-kw">in</span>
<span class="xc-ln">16</span>        <span class="xc-ty">Text</span>(<span class="xc-s">"Shipped on \(platform)."</span>)
<span class="xc-ln">17</span>      {'}'}
<span class="xc-ln">18</span>    {'}'}
<span class="xc-ln">19</span>  {'}'}</code></pre>
                      <div class="xc-note">
                        <strong>{t('cto.win_xcode_lede')}</strong>
                        <p>{t('cto.win_xcode_body')}</p>
                      </div>
                    </main>
                    <aside class="xc-inspector">
                      <div class="xc-insp_head">INSPECTOR</div>
                      <dl class="xc-insp_grid">
                        <dt>Target</dt><dd>tyfn.app</dd>
                        <dt>Platforms</dt><dd>iOS · macOS · watchOS · iPadOS</dd>
                        <dt>Swift</dt><dd>6.1</dd>
                        <dt>Min iOS</dt><dd>17.0</dd>
                      </dl>
                    </aside>
                  </div>
                </section>

                <!-- ========== ANDROID STUDIO ========== -->
                <section class="ipad-win ipad-win--android" data-window="android-studio" aria-hidden="true">
                  <header class="ipad-win_chrome ipad-win_chrome--android">
                    <div class="ipad-win_lights" aria-hidden="true">
                      <span class="ipad-light ipad-light--r" data-close></span>
                      <span class="ipad-light ipad-light--y"></span>
                      <span class="ipad-light ipad-light--g"></span>
                    </div>
                    <div class="as-toolbar">
                      <span class="as-app">
                        <img src="/assets/android-studio.svg" alt="" />
                        <strong>Android Studio</strong>
                      </span>
                      <span class="as-divider"></span>
                      <span class="as-scheme">▣ app · debug · 🤖 Pixel 8 Pro</span>
                      <span class="as-spacer"></span>
                      <span class="as-run">▶ Run</span>
                    </div>
                    <div class="as-status">{t('cto.win_android_subtitle')}</div>
                  </header>
                  <div class="as-body">
                    <aside class="as-nav">
                      <div class="as-nav_head">▾ TyfnLab</div>
                      <ul class="as-tree">
                        <li class="as-tree_group is-open">
                          <span>▾ composeApp</span>
                          <ul>
                            <li class="as-tree_group is-open">
                              <span>▾ commonMain</span>
                              <ul>
                                <li><span class="as-file is-active">⌨ App.kt</span></li>
                                <li><span class="as-file">⌨ HomeScreen.kt</span></li>
                                <li><span class="as-file">⌨ Theme.kt</span></li>
                              </ul>
                            </li>
                            <li class="as-tree_group">
                              <span>▸ androidMain</span>
                            </li>
                            <li class="as-tree_group">
                              <span>▸ iosMain</span>
                            </li>
                            <li class="as-tree_group">
                              <span>▸ desktopMain</span>
                            </li>
                          </ul>
                        </li>
                        <li class="as-tree_group">
                          <span>▸ gradle</span>
                        </li>
                      </ul>
                    </aside>
                    <main class="as-editor">
                      <div class="as-tabbar">
                        <span class="as-tab is-active">⌨ App.kt</span>
                        <span class="as-tab">⌨ HomeScreen.kt</span>
                      </div>
                      <pre class="as-code"><code><span class="as-ln">1</span>  <span class="as-c">// {t('cto.win_android_lede')}</span>
<span class="as-ln">2</span>  <span class="as-kw">package</span> <span class="as-id">tyfn.lab</span>
<span class="as-ln">3</span>
<span class="as-ln">4</span>  <span class="as-at">@Composable</span>
<span class="as-ln">5</span>  <span class="as-kw">fun</span> <span class="as-fn">App</span>() {'{'}
<span class="as-ln">6</span>    <span class="as-ty">MaterialTheme</span> {'{'}
<span class="as-ln">7</span>      <span class="as-ty">HomeScreen</span>(platform = <span class="as-fn">currentPlatform</span>())
<span class="as-ln">8</span>    {'}'}
<span class="as-ln">9</span>  {'}'}
<span class="as-ln">10</span>
<span class="as-ln">11</span>  <span class="as-kw">expect fun</span> <span class="as-fn">currentPlatform</span>(): <span class="as-ty">Platform</span>
<span class="as-ln">12</span>
<span class="as-ln">13</span>  <span class="as-kw">enum class</span> <span class="as-ty">Platform</span> {'{'} <span class="as-id">ANDROID</span>, <span class="as-id">IOS</span>, <span class="as-id">DESKTOP</span> {'}'}</code></pre>
                      <div class="as-note">
                        <strong>{t('cto.win_android_lede')}</strong>
                        <p>{t('cto.win_android_body')}</p>
                      </div>
                    </main>
                    <aside class="as-preview">
                      <div class="as-preview_label">PREVIEW · PIXEL 8</div>
                      <div class="as-device">
                        <div class="as-device_screen">
                          <div class="as-device_topbar"></div>
                          <div class="as-device_hero">Hi, Tayfun.</div>
                          <div class="as-device_card">📱 Android</div>
                          <div class="as-device_card">🍎 iOS</div>
                          <div class="as-device_card">🖥 Desktop</div>
                        </div>
                      </div>
                    </aside>
                  </div>
                </section>

                <!-- ========== WEBSTORM ========== -->
                <section class="ipad-win ipad-win--webstorm" data-window="webstorm" aria-hidden="true">
                  <header class="ipad-win_chrome ipad-win_chrome--webstorm">
                    <div class="ipad-win_lights" aria-hidden="true">
                      <span class="ipad-light ipad-light--r" data-close></span>
                      <span class="ipad-light ipad-light--y"></span>
                      <span class="ipad-light ipad-light--g"></span>
                    </div>
                    <div class="ws-toolbar">
                      <span class="ws-app">
