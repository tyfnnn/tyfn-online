---
import { useTranslations, type Lang } from '../../i18n/t';
import { SOCIAL_LINKS } from '../../i18n/site';
import lottieFallbackSvg from '../../snippets/home/footer-lottie-fallback.html?raw';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const email = t('common.email');
const mailtoHref = `mailto:${email}?subject=Protfolio%20Website`;
---
<footer data-w-id="0f34ce89-ed6a-accd-a6a7-e774183aacbf" class="footer">
  <div class="padding-global-3">
    <div class="footer_component">
      <div class="footer_content-wrapper">
        <div class="footer_content">
          <h2 letters-footer="" text-split="" style="opacity:1" class="heading-style-h1-4">{t('footer.cta_heading')}</h2>
          <div class="footer_contact-wrapper">
            <div class="_7x62im" data-scramble>{t('footer.email_label')}</div><a
              data-w-id="efba1a56-0058-9b53-9beb-6c12b6571525"
              href={mailtoHref}
              class="link-mail-w-inline-block w-inline-block"
            >
              <div
                data-w-id="902b49b4-a83a-aebd-9dc8-ab931c544cbf"
                style="transform:translate3d(0px, 0%, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg);transform-style:preserve-3d"
                class="link-mail_one footer-email-stagger"
              ><span class="footer-email-stagger_row" aria-hidden="true">{[...email].map((ch, i) => (
                  <span class="footer-email-stagger_letter" style={`--i:${i}`}>{ch}</span>
                ))}</span><span class="footer-email-stagger_row footer-email-stagger_row--ghost" aria-hidden="true">{[...email].map((ch, i) => (
                  <span class="footer-email-stagger_letter" style={`--i:${i}`}>{ch}</span>
                ))}</span></div>
              <div
                data-w-id="9e6c2a7e-7a49-db7d-2ea3-e8aacdeab73d"
                style="transform:translate3d(0px, 0%, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg);transform-style:preserve-3d"
                class="link-mail_two"
                data-scramble
              >{t('footer.magic_line')}</div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer_lottie-wrapper">
    <div class="footer-social-block-three">
      {SOCIAL_LINKS.map((s) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer" class="footer-social-link-three">
          <img src={s.icon} loading="lazy" width="55" alt={s.name} />
        </a>
      ))}
    </div>
    <div class="footer-bottom-2">
      <div class="footer-copyright-2">© 2026</div>
    </div>
  </div>
  <div
    data-src="/assets/animation_bupur.json"
    class="footer_lottie"
    data-default-duration="1.6666666666666667"
    data-autoplay="0"
    data-animation-type="lottie"
    data-renderer="svg"
    data-loop="0"
    data-w-id="73832888-a2be-a629-8657-06b7d197b464"
    data-duration="1.6666666666666667"
    data-is-ix2-target="1"
    data-ix2-initial-state="15"
    data-direction="1"
    set:html={lottieFallbackSvg}
  />
<style>
  .footer_contact-wrapper {
    margin-top: 2rem !important;
  }
  .link-mail-w-inline-block {
    font-size: clamp(1.25rem, 2.8vw, 2rem);
  }
  .footer-email-stagger {
    position: relative;
    display: inline-block;
    overflow: hidden;
    line-height: 1.3;
  }
  .footer-email-stagger_row {
    display: inline-flex;
    will-change: transform;
  }
  .footer-email-stagger_row--ghost {
    position: absolute;
    left: 0;
    top: 0;
    transform: translateY(100%);
  }
  .footer-email-stagger_letter {
    display: inline-block;
    transform: translateY(0);
    transition: transform 0.55s cubic-bezier(0.6, 0.05, 0.1, 1);
    transition-delay: calc(var(--i) * 22ms);
  }
  .link-mail-w-inline-block:hover .footer-email-stagger_letter {
    transform: translateY(-100%);
  }
  .footer-social-link-three {
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
  }
  .footer-social-link-three img {
    transition: filter 0.3s ease;
  }
  .footer-social-link-three:hover {
    transform: translateY(-4px) scale(1.15);
  }
  .footer-social-link-three:hover img {
    filter: brightness(0) saturate(100%) invert(30%) sepia(80%) saturate(1800%) hue-rotate(345deg) brightness(90%) contrast(90%);
  }
</style>
</footer>
