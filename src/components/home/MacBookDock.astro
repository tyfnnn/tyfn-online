<style>
  .mbd-section {
    width: 100%;
    margin: 0 0 2rem;
    position: relative;
    z-index: 2;
  }

  .mbd-stage {
    max-width: 1180px;
    margin: 0 auto;
    position: relative;
  }

  .mbd-header {
    text-align: center;
    /* the framing leaves a little air at the top of the canvas box, so the
       copy can sit closer than it looks */
    margin-bottom: clamp(18px, 2.2vw, 30px);
  }
  .mbd-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: rgba(240, 237, 230, 0.42);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .mbd-eyebrow_rule {
    width: 42px;
    height: 1px;
    background: linear-gradient(90deg, rgba(240, 237, 230, 0), rgba(240, 237, 230, 0.35));
  }
  .mbd-eyebrow_rule:last-child {
    background: linear-gradient(90deg, rgba(240, 237, 230, 0.35), rgba(240, 237, 230, 0));
  }
  .mbd-heading {
    margin-top: 12px;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.12;
    color: #f0ede6;
    font-weight: 500;
  }
  .mbd-subheading {
    margin: 12px auto 0;
    max-width: 560px;
    color: rgba(240, 237, 230, 0.62);
    font-size: 16px;
    line-height: 1.6;
  }

  .mbd-canvas-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    opacity: 0;
    transition: opacity 0.9s ease;
    overflow: hidden;
  }
  .mbd-canvas-wrap.is-ready {
    opacity: 1;
  }

  .mbd-canvas {
    display: block;
    width: 100%;
    height: 100%;
    outline: none;
  }

  .mbd-shadow {
    position: absolute;
    left: 50%;
    bottom: -4%;
    width: 72%;
    height: 9%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.55) 0%, transparent 68%);
    filter: blur(14px);
    pointer-events: none;
  }

  /*
   * Screen UI overlay — pinned to the laptop LCD by the runtime script via a
   * per-frame projective matrix3d. The script sizes this element to the
   * screen's projected aspect (base width 800px); all dock dimensions use
   * container-query units so proportions survive any projection scale.
   */
  /* While the laptop is still travelling the screen is a picture, not a UI. */
  .mbd-screen-ui:not(.is-live),
  .mbd-screen-ui:not(.is-live) * {
    pointer-events: none !important;
  }

  .mbd-screen-ui {
    position: absolute;
    top: 0;
    left: 0;
    width: 800px;
    height: 500px;
    transform-origin: 0 0;
    pointer-events: none;
    will-change: transform;
    z-index: 3;
    container-type: size;
    /* The panel it is projected onto has rounded corners; without this the
       wallpaper and menu bar cut square across them. The radius is set from
       the runtime in px — cqw here would resolve against the viewport, since
       this element is the container, not inside one. */
    overflow: hidden;
  }

  /* ---------------------------------------------------------------------
   * Desktop surface
   * ------------------------------------------------------------------ */
  .mbd-wallpaper {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 80% at 22% 8%, rgba(255, 116, 72, 0.30) 0%, transparent 58%),
      radial-gradient(110% 90% at 84% 18%, rgba(94, 132, 255, 0.28) 0%, transparent 60%),
      radial-gradient(90% 70% at 60% 100%, rgba(158, 96, 255, 0.22) 0%, transparent 62%),
      linear-gradient(168deg, #10121b 0%, #0a0b10 52%, #07080c 100%);
    overflow: hidden;
  }
  .mbd-wallpaper::after {
    content: '';
    position: absolute;
    inset: -20%;
    background:
      repeating-linear-gradient(115deg, rgba(255, 255, 255, 0.045) 0 1px, transparent 1px 46px);
    opacity: 0.5;
  }

  /* ---------------------------------------------------------------------
   * Menu bar
   * ------------------------------------------------------------------ */
  .mbd-menubar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2.85cqw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5cqw;
    background: rgba(16, 17, 23, 0.55);
    backdrop-filter: blur(1.4cqw) saturate(1.6);
    -webkit-backdrop-filter: blur(1.4cqw) saturate(1.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    color: rgba(240, 237, 230, 0.86);
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Helvetica Neue', sans-serif;
    font-size: 1.42cqw;
    letter-spacing: 0.005em;
    z-index: 40;
    pointer-events: auto;
  }
  .mbd-menubar_left,
  .mbd-menubar_right {
    display: flex;
    align-items: center;
    gap: 1.5cqw;
  }
  .mbd-menubar_right { gap: 1.25cqw; }
  .mbd-apple {
    display: inline-flex;
    align-items: center;
    color: rgba(240, 237, 230, 0.9);
  }
  .mbd-apple svg { width: 1.35cqw; height: auto; }
  .mbd-menu { opacity: 0.72; white-space: nowrap; }
  .mbd-menu--app { font-weight: 600; opacity: 1; }
  .mbd-tray-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45cqw;
    opacity: 0.8;
  }
  .mbd-search-glyph { font-size: 1.8cqw; line-height: 1; }
  .mbd-wifi svg { width: 1.7cqw; height: auto; }
  .mbd-battery {
    position: relative;
    display: inline-block;
    width: 3cqw;
    height: 1.45cqw;
    border: 1px solid rgba(240, 237, 230, 0.55);
    border-radius: 0.42cqw;
    padding: 0.16cqw;
  }
  .mbd-battery::after {
    content: '';
    position: absolute;
    right: -0.42cqw;
    top: 50%;
    transform: translateY(-50%);
    width: 0.24cqw;
    height: 0.55cqw;
    border-radius: 0 0.2cqw 0.2cqw 0;
    background: rgba(240, 237, 230, 0.55);
  }
  .mbd-battery_level {
    display: block;
    height: 100%;
    width: 82%;
    border-radius: 0.2cqw;
    background: rgba(240, 237, 230, 0.9);
    transition: width 0.4s ease, background 0.4s ease;
  }
  .mbd-battery.is-low .mbd-battery_level { background: #ff6b5c; }
  .mbd-battery.is-charging .mbd-battery_level { background: #34d15b; }
  .mbd-battery_pct { font-size: 1.28cqw; opacity: 0.75; }
  .mbd-tray-clock {
    display: inline-flex;
    align-items: center;
    gap: 0.7cqw;
    padding: 0.2cqw 0.7cqw;
    margin-right: -0.7cqw;
    border: 0;
    border-radius: 0.7cqw;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .mbd-tray-clock:hover { background: rgba(255, 255, 255, 0.12); }
  .mbd-screen-ui.is-notif-open .mbd-tray-clock { background: rgba(255, 255, 255, 0.18); }
  .mbd-date { opacity: 0.72; }

  /* ---------------------------------------------------------------------
   * Notification centre
   * ------------------------------------------------------------------ */
  .mbd-notif {
    position: absolute;
    top: 3.4cqw;
    right: 1.2cqw;
    width: 26cqw;
    max-height: calc(100cqh - 16cqw);
    display: flex;
    flex-direction: column;
    gap: 0.9cqw;
    padding: 1.4cqw;
    border-radius: 1.8cqw;
    background: rgba(20, 21, 27, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 2cqw 5cqw rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2.2cqw) saturate(1.6);
    -webkit-backdrop-filter: blur(2.2cqw) saturate(1.6);
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Helvetica Neue', sans-serif;
    opacity: 0;
    transform: translateX(3cqw);
    transition: opacity 0.32s ease, transform 0.42s cubic-bezier(0.32, 0.72, 0.24, 1);
    pointer-events: none;
    z-index: 35;
    overflow: hidden;
  }
  .mbd-screen-ui.is-notif-open .mbd-notif {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }
  .mbd-notif_head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(240, 237, 230, 0.9);
  }
  .mbd-notif_title { font-size: 1.5cqw; font-weight: 600; }
  .mbd-notif_clear {
    border: 0;
    background: none;
    color: rgba(240, 237, 230, 0.5);
    font: inherit;
    font-size: 1.25cqw;
    cursor: pointer;
  }
  .mbd-notif_clear:hover { color: rgba(240, 237, 230, 0.85); }
  .mbd-notif_list {
    display: flex;
    flex-direction: column;
    gap: 0.75cqw;
    overflow: hidden;
  }
  .mbd-notif_card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 0.9cqw;
    padding: 1cqw;
    border-radius: 1.1cqw;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: inherit;
    text-decoration: none;
  }
  .mbd-notif_card--accent {
    background: rgba(255, 116, 72, 0.14);
    border-color: rgba(255, 116, 72, 0.32);
  }
  a.mbd-notif_card:hover { background: rgba(255, 255, 255, 0.13); }
  .mbd-notif_icon {
    display: grid;
    place-items: center;
    width: 2.9cqw;
    height: 2.9cqw;
    border-radius: 0.75cqw;
    color: #fff;
    font-size: 1.5cqw;
  }
  .mbd-notif_text { min-width: 0; }
  .mbd-notif_card_title {
    font-size: 1.32cqw;
    font-weight: 600;
    color: #f0ede6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mbd-notif_card_body {
    margin-top: 0.15cqw;
    font-size: 1.22cqw;
    line-height: 1.35;
    color: rgba(240, 237, 230, 0.6);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .mbd-notif_time { font-size: 1.1cqw; color: rgba(240, 237, 230, 0.42); }

  /* ---------------------------------------------------------------------
   * Desktop window — the portfolio / writing browser
   * ------------------------------------------------------------------ */
  .mbd-deskwin {
    position: absolute;
    top: 4.6cqw;
    left: 3cqw;
    right: 3cqw;
    bottom: 13.4cqw;
    display: flex;
    flex-direction: column;
    border-radius: 1.4cqw;
    overflow: hidden;
    background: rgba(14, 15, 20, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 2.5cqw 6cqw rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2cqw) saturate(1.4);
    -webkit-backdrop-filter: blur(2cqw) saturate(1.4);
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Helvetica Neue', sans-serif;
    pointer-events: auto;
    z-index: 4;
    transition: opacity 0.3s ease, transform 0.3s ease, filter 0.3s ease;
  }
  .mbd-screen-ui[data-open-window] .mbd-deskwin {
    transform: scale(0.985);
    filter: brightness(0.6) saturate(0.8);
  }
  .mbd-deskwin_chrome {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 1.76cqw;
    padding: 1.20cqw 1.64cqw;
    background: rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .mbd-deskwin_title {
    display: inline-flex;
    align-items: center;
    gap: 0.76cqw;
    font-size: 1.70cqw;
    font-weight: 600;
    color: rgba(240, 237, 230, 0.9);
    white-space: nowrap;
  }
  .mbd-dot {
    width: 0.95cqw;
    height: 0.95cqw;
    border-radius: 50%;
    display: inline-block;
  }
  .mbd-dot--orange {
    background: #ff7448;
    box-shadow: 0 0 1.01cqw rgba(255, 116, 72, 0.8);
  }
  .mbd-tabs {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25cqw;
    padding: 0.32cqw;
    border-radius: 1.13cqw;
    background: rgba(255, 255, 255, 0.06);
  }
  .mbd-tab {
    position: relative;
    z-index: 1;
    border: 0;
    background: none;
    padding: 0.44cqw 1.26cqw;
    border-radius: 0.88cqw;
    color: rgba(240, 237, 230, 0.55);
    font: inherit;
    font-size: 1.57cqw;
    cursor: pointer;
    transition: color 0.2s ease;
    white-space: nowrap;
  }
  .mbd-tab.is-active { color: #f0ede6; }
  .mbd-tab_pill {
    position: absolute;
    top: 0.32cqw;
    bottom: 0.32cqw;
    left: 0;
    width: 0;
    border-radius: 0.88cqw;
    background: rgba(255, 255, 255, 0.14);
    transition: transform 0.34s cubic-bezier(0.32, 0.72, 0.24, 1), width 0.34s cubic-bezier(0.32, 0.72, 0.24, 1);
  }
  .mbd-searchbar {
    flex: 1;
    min-width: 7.56cqw;
    display: flex;
    align-items: center;
    gap: 0.76cqw;
    padding: 0.50cqw 1.13cqw;
    border-radius: 1.13cqw;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .mbd-searchbar:focus-within {
    border-color: rgba(255, 116, 72, 0.55);
    background: rgba(255, 255, 255, 0.09);
  }
  .mbd-searchbar_icon { font-size: 1.89cqw; color: rgba(240, 237, 230, 0.45); }
  .mbd-searchbar_input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    outline: none;
    color: #f0ede6;
    font: inherit;
    font-size: 1.57cqw;
  }
  .mbd-searchbar_input::placeholder { color: rgba(240, 237, 230, 0.35); }
  .mbd-searchbar_input::-webkit-search-cancel-button { display: none; }
  .mbd-searchbar_kbd {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 1.32cqw;
    color: rgba(240, 237, 230, 0.38);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.50cqw;
    padding: 0.10cqw 0.44cqw;
  }
  .mbd-sort {
    display: inline-flex;
    align-items: center;
    gap: 0.57cqw;
    padding: 0.53cqw 1.20cqw;
    border-radius: 1.13cqw;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(240, 237, 230, 0.72);
    font: inherit;
    font-size: 1.51cqw;
    cursor: pointer;
    white-space: nowrap;
  }
  .mbd-sort:hover { background: rgba(255, 255, 255, 0.1); }
  .mbd-sort_arrow { transition: transform 0.3s cubic-bezier(0.32, 0.72, 0.24, 1); }
  .mbd-sort[data-sort='oldest'] .mbd-sort_arrow { transform: rotate(180deg); }

  .mbd-deskwin_body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.02cqw;
    padding: 1.76cqw;
    overflow: hidden;
  }
  .mbd-deskwin_body[data-view='projects'] { grid-template-columns: 1fr; }
  .mbd-deskwin_body[data-view='projects'] [data-list='writing'] { display: none; }
  .mbd-deskwin_body[data-view='writing'] { grid-template-columns: 1fr; }
  .mbd-deskwin_body[data-view='writing'] [data-list='projects'] { display: none; }

  .mbd-col { min-width: 0; display: flex; flex-direction: column; }
  .mbd-col_head {
    display: flex;
    align-items: baseline;
    gap: 1.01cqw;
    padding-bottom: 0.88cqw;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 1.01cqw;
  }
  .mbd-col_index {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 1.32cqw;
    color: rgba(240, 237, 230, 0.3);
  }
  .mbd-col_title {
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 0.76cqw;
    font-size: 1.70cqw;
    font-weight: 600;
    color: #f0ede6;
    margin: 0;
  }
  .mbd-col_title-meta {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 1.32cqw;
    font-weight: 400;
    color: rgba(240, 237, 230, 0.3);
  }
  .mbd-col_all {
    font-size: 1.45cqw;
    color: rgba(255, 138, 96, 0.9);
    text-decoration: none;
    white-space: nowrap;
  }
  .mbd-col_all:hover { color: #ff7448; }

  .mbd-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.63cqw;
    min-height: 0;
    overflow: hidden;
  }
  .mbd-list li[hidden] { display: none; }
  .mbd-item {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 1.07cqw;
    padding: 0.82cqw 1.01cqw;
    border-radius: 1.26cqw;
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .mbd-item:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.09);
    transform: translateX(0.38cqw);
  }
  .mbd-item_index {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 1.26cqw;
    color: rgba(240, 237, 230, 0.28);
  }
  .mbd-item_thumb,
  .mbd-item_accent {
    width: 4.28cqw;
    height: 4.28cqw;
    border-radius: 0.95cqw;
    background-size: cover;
    background-position: center;
    background-color: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.09);
  }
  .mbd-item_text { min-width: 0; display: block; }
  .mbd-item_title {
    display: block;
    font-size: 1.64cqw;
    font-weight: 500;
    color: #f0ede6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mbd-item_meta {
    display: flex;
    align-items: center;
    gap: 0.69cqw;
    margin-top: 0.35cqw;
  }
  .mbd-pill {
    font-size: 1.23cqw;
    line-height: 1;
    padding: 0.38cqw 0.76cqw;
    border-radius: 999px;
    color: #fff;
    white-space: nowrap;
  }
  .mbd-pill--ghost {
    background: rgba(255, 255, 255, 0.09) !important;
    color: rgba(240, 237, 230, 0.7);
  }
  .mbd-item_status {
    font-size: 1.32cqw;
    color: rgba(240, 237, 230, 0.42);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mbd-item_arrow { color: rgba(240, 237, 230, 0.3); font-size: 1.51cqw; }
  .mbd-item:hover .mbd-item_arrow { color: #ff7448; }
  .mbd-empty {
    display: none;
    margin: 1.51cqw 0 0;
    font-size: 1.51cqw;
    color: rgba(240, 237, 230, 0.4);
  }
  .mbd-col.is-empty .mbd-empty { display: block; }

  /* ---------------------------------------------------------------------
   * Dock
   * ------------------------------------------------------------------ */
  .mbd-dock {
    --icon: 6.5cqw;
    --pad: 0.95cqw;
    position: absolute;
    left: 50%;
    bottom: 1.9cqw;
    transform: translateX(-50%);
    display: flex;
    align-items: flex-end;
    gap: 0.5cqw;
    height: calc(var(--icon) + var(--pad) * 2 + 0.85cqw);
    padding: var(--pad) 1.1cqw calc(var(--pad) + 0.85cqw);
    border-radius: 2.2cqw;
    background: rgba(30, 31, 38, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3),
      0 1.4cqw 3.6cqw rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2cqw) saturate(1.7);
    -webkit-backdrop-filter: blur(2cqw) saturate(1.7);
    pointer-events: auto;
    z-index: 20;
  }
  .mbd-dock_shine {
    position: absolute;
    inset: 1px 1px auto 1px;
    height: 45%;
    border-radius: 2.1cqw 2.1cqw 50% 50% / 2.1cqw 2.1cqw 1.2cqw 1.2cqw;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0));
    pointer-events: none;
  }
  .mbd-dock_sep {
    align-self: stretch;
    width: 1px;
    margin: 0.4cqw 0.5cqw;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0),
      rgba(255, 255, 255, 0.28),
      rgba(255, 255, 255, 0)
    );
  }

  .mbd-app {
    --s: 1;
    position: relative;
    flex: 0 0 auto;
    width: calc(var(--icon) * var(--s));
    height: calc(var(--icon) * var(--s));
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: block;
    /* no transition: the magnification is driven per-frame by the runtime */
  }
  .mbd-app_icon {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 50% 100%;
  }
  /* Blog: a proper app tile in the site's accent, with the one glyph that
     unambiguously reads "written posts" at dock size. */
  .mbd-blogicon {
    position: relative;
    display: grid;
    place-items: center;
    border-radius: 23%;
    background: linear-gradient(160deg, #ff9a63 0%, #ff7448 45%, #f0432f 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
    color: #fff;
  }
  .mbd-blogicon svg {
    width: 62%;
    height: 62%;
    display: block;
    filter: none;
  }

  .mbd-app img,
  .mbd-app .mbd-folder,
  .mbd-app .mbd-trash,
  .mbd-app .mbd-blogicon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0.4cqw 0.9cqw rgba(0, 0, 0, 0.45));
  }
  .mbd-app:active .mbd-app_icon { transform: scale(0.92); }

  /* folder + trash glyphs, drawn so no extra assets are needed */
  .mbd-folder { position: relative; }
  .mbd-folder_tab {
    position: absolute;
    left: 6%;
    top: 12%;
    width: 42%;
    height: 20%;
    border-radius: 18% 18% 0 0;
    background: linear-gradient(180deg, #6fa8ff, #4a86f0);
  }
  .mbd-folder_face {
    position: absolute;
    left: 4%;
    top: 24%;
    right: 4%;
    bottom: 14%;
    border-radius: 12%;
    background: linear-gradient(165deg, #8dbcff 0%, #3f7ae4 60%, #2f5fc0 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }
  .mbd-trash { position: relative; }
  .mbd-trash_lid {
    position: absolute;
    left: 16%;
    top: 14%;
    right: 16%;
    height: 9%;
    border-radius: 40%;
    background: linear-gradient(180deg, #dfe3ea, #a7adba);
    transform-origin: 10% 100%;
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .mbd-app--trash:hover .mbd-trash_lid { transform: translateY(-14%) rotate(-16deg); }
  .mbd-trash_can {
    position: absolute;
    left: 21%;
    top: 26%;
    right: 21%;
    bottom: 12%;
    border-radius: 8% 8% 16% 16%;
    background: linear-gradient(100deg, rgba(226, 230, 237, 0.9), rgba(150, 157, 170, 0.85));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
  }

  .mbd-badge {
    position: absolute;
    top: -2%;
    right: -6%;
    min-width: 1.85cqw;
    height: 1.85cqw;
    padding: 0 0.5cqw;
    border-radius: 999px;
    background: #ff453a;
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
    font-size: 1.2cqw;
    font-weight: 600;
    line-height: 1.85cqw;
    text-align: center;
    box-shadow: 0 0.2cqw 0.5cqw rgba(0, 0, 0, 0.45);
    pointer-events: none;
  }

  /* running-app indicator, like the dot under an open app on macOS */
  .mbd-runlight {
    position: absolute;
    left: 50%;
    bottom: -0.7cqw;
    width: 0.62cqw;
    height: 0.62cqw;
    border-radius: 50%;
    background: rgba(240, 237, 230, 0.92);
    box-shadow: 0 0 0.5cqw rgba(255, 255, 255, 0.5);
    transform: translate(-50%, 0) scale(0);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .mbd-app.is-running .mbd-runlight { transform: translate(-50%, 0) scale(1); }

  /* launch bounce */
  .mbd-app.is-bouncing .mbd-app_icon {
    animation: mbd-bounce 0.72s cubic-bezier(0.28, 0.62, 0.4, 1) 2;
  }
  @keyframes mbd-bounce {
    0%   { transform: translateY(0) scaleY(1); }
    12%  { transform: translateY(0) scaleY(0.88); }
    42%  { transform: translateY(-42%) scaleY(1.06); }
    72%  { transform: translateY(0) scaleY(0.94); }
    100% { transform: translateY(0) scaleY(1); }
  }

  .mbd-app::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 1.1cqw);
    left: 50%;
    translate: -50% 0;
    padding: 0.5cqw 1cqw;
    border-radius: 0.9cqw;
    background: rgba(24, 25, 31, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 0.6cqw 1.6cqw rgba(0, 0, 0, 0.5);
    color: #f0ede6;
    font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
    font-size: 1.3cqw;
    letter-spacing: 0.01em;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.35cqw);
    transition: opacity 0.16s ease, transform 0.16s ease;
    pointer-events: none;
  }
  .mbd-app:hover::after,
  .mbd-app.is-peaked::after {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------------------------------------------------------------------
   * Fake in-screen pointer — the cursor "enters" the laptop
   * ------------------------------------------------------------------ */
  .mbd-pointer {
    position: absolute;
    top: 0;
    left: 0;
    width: 2.6cqw;
    height: auto;
    opacity: 0;
    transition: opacity 0.2s ease;
    will-change: transform;
    pointer-events: none;
    z-index: 60;
    filter: drop-shadow(0 0.25cqw 0.5cqw rgba(0, 0, 0, 0.5));
  }
  .mbd-pointer svg { width: 100%; height: auto; display: block; }
  .mbd-screen-ui.is-pointer-in .mbd-pointer { opacity: 1; }

  /* ---------------------------------------------------------------------
   * Flight layer — the laptop travels through the whole projects section
   * ------------------------------------------------------------------ */
  /* Behind the grid and the scroll scene while it cruises — that is the whole
     point of the flight. Once the lid opens it becomes the subject, so it
     moves in front of both (but stays under the section heading at z-index 2
     and under the screen overlay at 4). */
  .mbd-flight {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .mbd-flight.is-front {
    z-index: 1;
  }
  .mbd-flight_sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .mbd-flight_sticky.is-ready { opacity: 1; }
  .mbd-flight_sticky .mbd-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mbd-canvas-wrap.is-detached { visibility: hidden; }

  .mbd-uilayer {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }
  .mbd-uilayer_sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .mbd-canvas-wrap {
      aspect-ratio: 3 / 2;
    }
  }

  /* -------------------------------------------------------------------
   * Compact display — the panel is too narrow for side-by-side panes.
   * Keyed to the projected surface, so it kicks in when the *screen* is
   * small, not when the browser window is.
   * ---------------------------------------------------------------- */
  @container (max-width: 620px) {
    .mbd-deskwin_body {
      grid-template-columns: 1fr;
      gap: 1cqw;
    }
    .mbd-list li:nth-child(n + 3) { display: none; }
    .mbd-menu:not(.mbd-menu--app) { display: none; }
    .mbd-search-glyph { display: none; }
    .mbd-searchbar_kbd { display: none; }
    .mbd-sort_label { display: none; }
    .mbd-tab { padding: 0.35cqw 0.7cqw; }
    .mbd-notif { width: 34cqw; }

    .xc-body,
    .as-body,
    .ws-body,
    .fg-body,
    .ob-body,
    .msg-body,
    .sk-body {
      grid-template-columns: 1fr;
    }
    .xc-nav,
    .xc-inspector,
    .as-nav,
    .as-preview,
    .ws-nav,
    .ws-side,
    .fg-layers,
    .fg-props,
    .ob-nav,
    .ob-graph,
    .msg-sidebar,
    .sk-stats {
      display: none;
    }
    .xc-status,
    .as-status,
    .ws-status {
      display: none;
    }
  }

    .mbd-windows {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 5;
  }

    .mbd-win {
    --gdx: 0px;
    --gdy: 220px;
    position: absolute;
    inset: 3.9cqw 2.6cqw 12.9cqw 2.6cqw;
    border-radius: 1.4cqw;
    overflow: hidden;
    background: #1a1a1a;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06),
      0 2.5cqw 6cqw rgba(0, 0, 0, 0.6),
      0 7cqw 14cqw rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    transform-origin: 50% 100%;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: #d8d6d2;
  }

    .mbd-screen-ui[data-open-window="xcode"]          .mbd-win--xcode,
  .mbd-screen-ui[data-open-window="android-studio"] .mbd-win--android,
  .mbd-screen-ui[data-open-window="webstorm"]       .mbd-win--webstorm,
  .mbd-screen-ui[data-open-window="figma"]          .mbd-win--figma,
  .mbd-screen-ui[data-open-window="obsidian"]       .mbd-win--obsidian,
  .mbd-screen-ui[data-open-window="messages"]       .mbd-win--messages,
  .mbd-screen-ui[data-open-window="snake"]          .mbd-win--snake {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }

  /* Genie — the window is sucked into (or spat out of) its dock icon.
     --gdx / --gdy are set per launch: the delta from the window's bottom
     centre to the centre of the icon that owns it. */
  .mbd-win.is-genie-in {
    animation: mbd-genie-in 0.46s cubic-bezier(0.22, 0.9, 0.28, 1) both;
  }
  .mbd-win.is-genie-out {
    opacity: 1;
    visibility: visible;
    pointer-events: none;
    animation: mbd-genie-out 0.42s cubic-bezier(0.6, 0.02, 0.86, 0.3) both;
  }
  @keyframes mbd-genie-out {
    0% {
      transform: translate(0, 0) scale(1, 1);
      border-radius: 1.4cqw;
      opacity: 1;
    }
    38% {
      transform: translate(calc(var(--gdx) * 0.2), calc(var(--gdy) * 0.16)) scale(0.74, 0.9);
      border-radius: 3.5cqw;
      opacity: 0.98;
    }
    74% {
      transform: translate(calc(var(--gdx) * 0.72), calc(var(--gdy) * 0.7)) scale(0.26, 0.44);
      border-radius: 7cqw;
      opacity: 0.8;
    }
    100% {
      transform: translate(var(--gdx), var(--gdy)) scale(0.05, 0.08);
      border-radius: 9cqw;
      opacity: 0;
    }
  }
  @keyframes mbd-genie-in {
    0% {
      transform: translate(var(--gdx), var(--gdy)) scale(0.05, 0.08);
      border-radius: 9cqw;
      opacity: 0;
    }
    30% {
      transform: translate(calc(var(--gdx) * 0.66), calc(var(--gdy) * 0.62)) scale(0.32, 0.5);
      border-radius: 6cqw;
      opacity: 0.85;
    }
    100% {
      transform: translate(0, 0) scale(1, 1);
      border-radius: 1.4cqw;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mbd-win.is-genie-in,
    .mbd-win.is-genie-out { animation-duration: 0.01s; }
    .mbd-app.is-bouncing .mbd-app_icon { animation: none; }
  }

    /* Shared window chrome: traffic lights bar */
  .mbd-win_chrome {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(0, 0, 0, 0.25);
  }

    .mbd-win_lights {
    display: inline-flex;
    gap: 7px;
    align-items: center;
  }

    .mbd-light {
    width: 11px; height: 11px;
    border-radius: 50%;
    display: inline-block;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.3);
  }

    .mbd-light--r { background: #ff5f57; cursor: pointer; transition: filter 0.2s ease; }

    .mbd-light--r:hover { filter: brightness(1.15); }

    .mbd-light--y { background: #ffbd2e; }

    .mbd-light--g { background: #28c840; }

    /* ============== XCODE 26 ============== */
  .mbd-win--xcode {
    background: linear-gradient(180deg, #1e1e1e 0%, #161616 100%);
    color: #e7e6e3;
  }

    .mbd-win_chrome--xcode {
    background: linear-gradient(180deg, #2c2c2e 0%, #232325 100%);
    border-bottom-color: rgba(0, 0, 0, 0.4);
  }

    /* ============== ANDROID STUDIO ============== */
  .mbd-win--android {
    background: linear-gradient(180deg, #2b2b2b 0%, #1f1f1f 100%);
    color: #e0e0e0;
  }

    .mbd-win_chrome--android {
    background: #3c3f41;
  }

    /* ============== WEBSTORM ============== */
  .mbd-win--webstorm {
    background: linear-gradient(180deg, #2b2b2b 0%, #1f1f1f 100%);
    color: #e0e0e0;
  }

    .mbd-win_chrome--webstorm {
    background:
      linear-gradient(180deg, #2f3133 0%, #25272a 100%);
    border-bottom: 1px solid #1a1a1a;
    position: relative;
  }

    .mbd-win_chrome--webstorm::after {
    /* WebStorm signature cyan→blue→yellow accent stripe */
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 2px;
    background: linear-gradient(90deg, #07C3F2 0%, #087CFA 55%, #FFF045 100%);
    opacity: 0.55;
  }

    /* ============== FIGMA ============== */
  .mbd-win--figma {
    background: #1e1e1e;
    color: #e6e6e6;
  }

    .mbd-win_chrome--figma { background: #2c2c2c; }

    /* ============== OBSIDIAN ============== */
  .mbd-win--obsidian {
    background: #1e1e2a;
    color: #d4d4d6;
  }

    .mbd-win_chrome--obsidian {
    background: #232434;
    border-bottom-color: rgba(124, 90, 255, 0.15);
  }

    /* ============== MESSAGES (iMessage) ============== */
  .mbd-win--messages {
    background: #0e0e0f;
    color: #e8e8eb;
  }

    .mbd-win_chrome--messages {
    background: linear-gradient(180deg, #1c1c1d 0%, #131314 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

    /* ============== SNAKE / BUG HUNT ============== */
  .mbd-win--snake {
    background:
      radial-gradient(120% 60% at 0% 0%, rgba(255, 116, 72, 0.10) 0%, transparent 55%),
      linear-gradient(180deg, #1a0f0a 0%, #0a0507 100%);
    color: #f0ede6;
    --sk-accent: #ff9b6e;
  }

    .mbd-win_chrome--snake {
    background: linear-gradient(180deg, #1f1410 0%, #14080a 100%);
    border-bottom: 1px solid rgba(255, 116, 72, 0.12);
  }

  /* The display surface is a fixed 800px container that the runtime projects
     onto the panel, so the window layouts never depend on the viewport —
     only the laptop as a whole gets smaller. */
  @media (prefers-reduced-motion: reduce) {
    .mbd-canvas-wrap {
      opacity: 1;
      transition: none;
    }
    .mbd-flight_sticky {
      transition: none;
    }
  }

  /* =================================================================
     APP WINDOW INTERNALS — ported from the iPad shell so the laptop has
     the same seven working apps.
     ================================================================= */
  /* ============== XCODE 26 ============== */
  .mbd-win--xcode {
    background: linear-gradient(180deg, #1e1e1e 0%, #161616 100%);
    color: #e7e6e3;
  }
  .mbd-win_chrome--xcode {
    background: linear-gradient(180deg, #2c2c2e 0%, #232325 100%);
    border-bottom-color: rgba(0, 0, 0, 0.4);
  }
  .xc-toolbar {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #d0cfcb;
    font-size: 11px;
  }
  .xc-btn {
    display: inline-grid;
    place-items: center;
    width: 22px; height: 22px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    color: #d0cfcb;
    font-size: 10px;
  }
  .xc-divider { width: 1px; height: 16px; background: rgba(255, 255, 255, 0.08); }
  .xc-scheme {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    font-size: 11px;
    color: #e7e6e3;
  }
  .xc-scheme_dot { width: 8px; height: 8px; border-radius: 50%; background: #0a84ff; box-shadow: 0 0 6px rgba(10, 132, 255, 0.6); }
  .xc-scheme_caret { opacity: 0.5; }
  .xc-status { margin-left: auto; font-size: 11px; color: rgba(231, 230, 227, 0.5); }

  .xc-body { flex: 1; display: grid; grid-template-columns: 180px 1fr 180px; min-height: 0; }
  .xc-nav, .xc-inspector {
    background: #1c1c1d;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    padding: 8px;
    overflow: auto;
    font-size: 11px;
  }
  .xc-inspector { border-right: 0; border-left: 1px solid rgba(255, 255, 255, 0.05); }
  .xc-nav_head, .xc-insp_head {
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: rgba(231, 230, 227, 0.45);
    padding: 4px 6px 8px;
  }
  .xc-tree, .xc-tree ul { list-style: none; padding: 0; margin: 0; }
  .xc-tree ul { padding-left: 14px; }
  .xc-tree_label { display: block; padding: 3px 6px; color: #d0cfcb; cursor: default; font-size: 11px; }
  .xc-file { display: inline-block; padding: 3px 6px; border-radius: 4px; color: #c8c7c4; font-size: 11px; }
  .xc-file.is-active { background: #0a84ff; color: #fff; }

  .xc-editor { display: flex; flex-direction: column; min-width: 0; background: #1e1e1e; }
  .xc-tabbar {
    display: flex;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: #232325;
    flex-shrink: 0;
  }
  .xc-tab {
    padding: 6px 12px;
    font-size: 11px;
    color: rgba(231, 230, 227, 0.5);
    border-right: 1px solid rgba(255, 255, 255, 0.05);
  }
  .xc-tab.is-active { color: #fff; background: #1e1e1e; }
  .xc-code {
    flex: 1;
    margin: 0;
    padding: 12px 14px;
    overflow: auto;
    font-size: 11.5px;
    line-height: 1.55;
    color: #e7e6e3;
    background: #1e1e1e;
    white-space: pre;
  }
  .xc-code code { font-family: inherit; }
  .xc-ln { display: inline-block; width: 22px; color: rgba(231, 230, 227, 0.28); user-select: none; }
  .xc-kw { color: #ff7ab2; }
  .xc-ty { color: #d0a8ff; }
  .xc-id { color: #e7e6e3; }
  .xc-s  { color: #fc6a5d; }
  .xc-c  { color: #6c7986; font-style: italic; }
  .xc-at { color: #ffa14f; }
  .xc-fn { color: #67b7a4; }
  .xc-note {
    padding: 10px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(10, 132, 255, 0.06);
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-size: 13px;
    line-height: 1.5;
    color: #e7e6e3;
  }
  .xc-note strong { font-weight: 500; color: #fff; font-style: normal; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; display: block; margin-bottom: 4px; color: #ff9b6e; }
  .xc-note p { margin: 0; }

  .xc-insp_grid {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    gap: 8px;
  }
  .xc-insp_grid dt { font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(231, 230, 227, 0.45); margin-bottom: 2px; }
  .xc-insp_grid dd { margin: 0; font-size: 11px; color: #e7e6e3; }

  /* ============== ANDROID STUDIO ============== */
  .mbd-win--android {
    background: linear-gradient(180deg, #2b2b2b 0%, #1f1f1f 100%);
    color: #e0e0e0;
  }
  .mbd-win_chrome--android {
    background: #3c3f41;
  }
  .as-toolbar { display: flex; align-items: center; gap: 10px; flex: 1; font-size: 11px; color: #d2d2d2; }
  .as-app { display: inline-flex; align-items: center; gap: 6px; }
  .as-app img { width: 16px; height: 16px; border-radius: 4px; }
  .as-app strong { font-weight: 500; }
  .as-divider { width: 1px; height: 14px; background: rgba(255, 255, 255, 0.1); }
  .as-scheme { padding: 3px 10px; border-radius: 4px; background: rgba(255, 255, 255, 0.06); }
  .as-spacer { flex: 1; }
  .as-run { color: #3DDC84; font-weight: 600; padding: 3px 10px; border-radius: 4px; background: rgba(61, 220, 132, 0.12); }
  .as-status { font-size: 11px; color: rgba(255, 255, 255, 0.45); }

  .as-body { flex: 1; display: grid; grid-template-columns: 180px 1fr 200px; min-height: 0; }
  .as-nav { background: #2b2b2b; border-right: 1px solid #1a1a1a; padding: 8px; overflow: auto; font-size: 11px; }
  .as-nav_head { color: #bbbbbb; padding: 4px 6px; margin-bottom: 4px; }
