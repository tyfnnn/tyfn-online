---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../../i18n/t';
import { getBlogPosts, postHref, formatDate } from '../../lib/blog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const portfolioHref = getRelativeLocaleUrl(lang, '/portfolio/');
const blogHref = getRelativeLocaleUrl(lang, '/blog/');

const apps = [
  { id: 'xcode', name: 'Xcode', icon: '/assets/xcode.svg', href: null, badge: null },
  { id: 'android-studio', name: 'Android Studio', icon: '/assets/android-studio.svg', href: null, badge: null },
  { id: 'webstorm', name: 'WebStorm', icon: '/assets/webstorm.svg', href: null, badge: null },
  { id: 'figma', name: 'Figma', icon: '/assets/figma.svg', href: null, badge: null },
  { id: 'obsidian', name: 'Obsidian', icon: '/assets/obsidian.svg', href: null, badge: null },
  {
    id: 'mail',
    name: 'Mail',
    icon: '/assets/mail.svg',
    href: `mailto:${t('common.email')}`,
    badge: '1',
  },
  { id: 'messages', name: 'Messages', icon: '/assets/messages.svg', href: null, badge: '3' },
  { id: 'snake', name: t('cto.win_snake_title'), icon: '/assets/snake.svg', href: null, badge: null },
];

/* Desktop lists — same content model the iPad shell used. */
const projects = [
  {
    href: getRelativeLocaleUrl(lang, '/portfolio/easyngo/'),
    title: t('portfolio.easyngo.card_title'),
    tag: t('portfolio.easyngo.tag_3'),
    status: t('portfolio.easyngo.status'),
    image:
      'https://res.cloudinary.com/dmokvj08w/image/upload/v1752658414/zentrik-accounting_hqbrnv.png',
    accent: 'linear-gradient(135deg, #6e8efb, #4f6df5)',
  },
  {
    href: getRelativeLocaleUrl(lang, '/portfolio/redact/'),
    title: t('portfolio.redact.card_title'),
    tag: t('portfolio.redact.tag_5'),
    status: t('portfolio.redact.status'),
    image: '/portfolio/redact/redact-logo.png',
    accent: 'linear-gradient(135deg, #E5906B, #9C4F2E)',
  },
  {
    href: getRelativeLocaleUrl(lang, '/portfolio/stellar-horizon/'),
    title: t('portfolio.stellar.card_title'),
    tag: t('portfolio.stellar.tag_1'),
    status: t('portfolio.stellar.status'),
    image:
      'https://res.cloudinary.com/dmokvj08w/image/upload/v1752659137/stellar-horizon-title_h0aah5.png',
    accent: 'linear-gradient(135deg, #ff7448, #ff4848)',
  },
].slice(0, 4);

const allPosts = await getBlogPosts(lang);
const posts = allPosts.slice(0, 4).map((entry) => ({
  href: postHref(lang, entry),
  title: entry.data.title,
  description: entry.data.description,
  date: formatDate(entry.data.pubDate, lang),
  tag: entry.data.tags?.[0] ?? '',
  image: entry.data.heroImage ?? '',
}));

const accents = [
  'linear-gradient(135deg, #ff7448, #ff4848)',
  'linear-gradient(135deg, #ffb86b, #ff7448)',
  'linear-gradient(135deg, #7ad0ff, #4f8df5)',
  'linear-gradient(135deg, #c69bff, #ff6bbd)',
];

const menus = [
  t('cto.menu_file'),
  t('cto.menu_edit'),
  t('cto.menu_view'),
  t('cto.menu_window'),
  t('cto.menu_help'),
];
---
<section class="cto-section mbd-section">
  <!-- Hoisted into #projects at runtime so the laptop can travel the whole
       section; the in-flow .mbd-canvas-wrap below stays as its landing box. -->
  <div class="mbd-flight" data-mbd-flight>
    <div class="mbd-flight_sticky" data-mbd-flight-sticky></div>
  </div>
  <!-- The canvas paints *behind* the section, but the screen UI has to be
       clickable, so it rides in its own layer above it. Same sticky geometry,
       so the projection matrix is identical in both. -->
  <div class="mbd-uilayer" data-mbd-uilayer>
    <div class="mbd-uilayer_sticky" data-mbd-ui-sticky></div>
  </div>
  <div class="padding-global-2">
    <div class="mbd-stage" data-mbd-stage>
      <header class="mbd-header">
        <div class="mbd-eyebrow">
          <span class="mbd-eyebrow_rule" aria-hidden="true"></span>
          <span class="mbd-eyebrow_text">{t('cto.badge')}</span>
          <span class="mbd-eyebrow_rule" aria-hidden="true"></span>
        </div>
        <h2 class="mbd-heading">{t('cto.heading')}</h2>
        <p class="mbd-subheading">{t('cto.subheading')}</p>
      </header>

      <div class="mbd-canvas-wrap" data-mbd-canvas-wrap>
        <canvas class="mbd-canvas" data-mbd-canvas aria-hidden="true"></canvas>
        <div class="mbd-shadow" aria-hidden="true"></div>

        <div class="mbd-screen-ui" data-mbd-screen-ui data-cursor="off" hidden>
          <div class="mbd-wallpaper" aria-hidden="true"></div>

          <!-- ========== MENU BAR ========== -->
          <div class="mbd-menubar">
            <div class="mbd-menubar_left">
              <span class="mbd-apple" aria-hidden="true">
                <svg viewBox="0 0 14 17" width="10" height="12" fill="currentColor">
                  <path d="M11.6 9c0-1.8 1.5-2.7 1.6-2.7-.9-1.3-2.2-1.4-2.7-1.5-1.2-.1-2.3.7-2.9.7-.6 0-1.5-.7-2.5-.7-1.3 0-2.5.7-3.1 1.9C.6 8.9 1.5 12.3 2.8 14.2c.6.9 1.4 1.9 2.4 1.9.9 0 1.3-.6 2.4-.6s1.4.6 2.4.6 1.7-.9 2.3-1.8c.7-1 1-2 1-2.1 0 0-2-.8-2-3.2zM9.8 3.4c.5-.6.9-1.5.8-2.4-.8 0-1.7.5-2.3 1.2-.5.6-.9 1.5-.8 2.4.9.1 1.8-.5 2.3-1.2z"/>
                </svg>
              </span>
              <span class="mbd-menu mbd-menu--app">tyfn.online</span>
              {menus.map((m) => <span class="mbd-menu">{m}</span>)}
            </div>
            <div class="mbd-menubar_right">
              <span class="mbd-tray-item" aria-hidden="true">
                <span class="mbd-battery" data-battery>
                  <span class="mbd-battery_level" data-battery-level></span>
                </span>
                <span class="mbd-battery_pct" data-battery-pct></span>
              </span>
              <span class="mbd-tray-item mbd-wifi" aria-hidden="true">
                <svg viewBox="0 0 16 12" width="13" height="10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                  <path d="M1 4.2a10 10 0 0 1 14 0" />
                  <path d="M3.6 6.9a6.4 6.4 0 0 1 8.8 0" />
                  <path d="M6.2 9.5a2.7 2.7 0 0 1 3.6 0" />
                </svg>
              </span>
              <span class="mbd-tray-item mbd-search-glyph" aria-hidden="true">⌕</span>
              <button
                type="button"
                class="mbd-tray-clock"
                data-toggle="notif"
                aria-label={t('cto.notif_title')}
              >
                <span class="mbd-date" data-clock-date></span>
                <span class="mbd-time" data-clock-time>9:41</span>
              </button>
            </div>
          </div>

          <!-- ========== NOTIFICATION CENTER ========== -->
          <div class="mbd-notif" data-mbd-notif aria-hidden="true">
            <div class="mbd-notif_head">
              <span class="mbd-notif_title">{t('cto.notif_title')}</span>
              <button type="button" class="mbd-notif_clear" data-notif-close>{t('cto.notif_clear')}</button>
            </div>
            <div class="mbd-notif_list">
              <a class="mbd-notif_card mbd-notif_card--accent" href={`mailto:${t('common.email')}`}>
                <span class="mbd-notif_icon" style="background:linear-gradient(135deg,#ff8e5c,#ff4848);">✉</span>
                <div class="mbd-notif_text">
                  <div class="mbd-notif_card_title">{t('cto.notif_hire_title')}</div>
                  <div class="mbd-notif_card_body">{t('cto.notif_hire_body')}</div>
                </div>
                <span class="mbd-notif_time">{t('cto.notif_now')}</span>
              </a>
              <div class="mbd-notif_card">
                <span class="mbd-notif_icon" style="background:linear-gradient(135deg,#a78bfa,#7c3aed);">●</span>
                <div class="mbd-notif_text">
                  <div class="mbd-notif_card_title">{t('cto.notif_inquiry_title')}</div>
                  <div class="mbd-notif_card_body">{t('cto.notif_inquiry_body')}</div>
                </div>
                <span class="mbd-notif_time">2m</span>
              </div>
              <div class="mbd-notif_card">
                <span class="mbd-notif_icon" style="background:linear-gradient(135deg,#86d9ff,#1f7af0);">◴</span>
                <div class="mbd-notif_text">
                  <div class="mbd-notif_card_title">{t('cto.notif_calendar_title')}</div>
                  <div class="mbd-notif_card_body">{t('cto.notif_calendar_body')}</div>
                </div>
                <span class="mbd-notif_time">5m</span>
              </div>
              <div class="mbd-notif_card">
                <span class="mbd-notif_icon" style="background:linear-gradient(180deg,#3a3a3a,#0a0a0a);">⌥</span>
                <div class="mbd-notif_text">
                  <div class="mbd-notif_card_title">{t('cto.notif_github_title')}</div>
                  <div class="mbd-notif_card_body">{t('cto.notif_github_body')}</div>
                </div>
                <span class="mbd-notif_time">1h</span>
              </div>
              <div class="mbd-notif_card">
                <span class="mbd-notif_icon" style="background:linear-gradient(135deg,#1ED760,#0d6e2c);">◉</span>
                <div class="mbd-notif_text">
                  <div class="mbd-notif_card_title">{t('cto.notif_calm_title')}</div>
                  <div class="mbd-notif_card_body">{t('cto.notif_calm_body')}</div>
                </div>
                <span class="mbd-notif_time">3h</span>
              </div>
            </div>
          </div>

          <!-- ========== DESKTOP WINDOW: tyfn.online ========== -->
          <section class="mbd-deskwin" data-deskwin>
            <header class="mbd-deskwin_chrome">
              <div class="mbd-win_lights mbd-win_lights--static" aria-hidden="true">
                <span class="mbd-light mbd-light--r"></span>
                <span class="mbd-light mbd-light--y"></span>
                <span class="mbd-light mbd-light--g"></span>
              </div>
              <div class="mbd-deskwin_title">
                <span class="mbd-dot mbd-dot--orange" aria-hidden="true"></span>
                <span>tyfn.online</span>
              </div>
              <div class="mbd-tabs" role="tablist">
                <button type="button" class="mbd-tab is-active" role="tab" aria-selected="true" data-tab="all">{t('cto.tab_all')}</button>
                <button type="button" class="mbd-tab" role="tab" aria-selected="false" data-tab="projects">{t('cto.tab_projects')}</button>
                <button type="button" class="mbd-tab" role="tab" aria-selected="false" data-tab="writing">{t('cto.tab_writing')}</button>
                <span class="mbd-tab_pill" aria-hidden="true"></span>
              </div>
              <label class="mbd-searchbar">
                <span class="mbd-searchbar_icon" aria-hidden="true">⌕</span>
                <input
                  type="search"
                  class="mbd-searchbar_input"
                  placeholder={t('cto.search_placeholder')}
                  aria-label={t('cto.search_placeholder')}
                  data-search
                />
                <kbd class="mbd-searchbar_kbd" aria-hidden="true">⌘K</kbd>
              </label>
              <button type="button" class="mbd-sort" data-sort="newest" aria-label={t('cto.sort_newest')}>
                <span class="mbd-sort_arrow" aria-hidden="true">↓</span>
                <span class="mbd-sort_label" data-sort-label>{t('cto.sort_newest')}</span>
              </button>
            </header>

            <div class="mbd-deskwin_body" data-deskwin-body>
              <section class="mbd-col" data-list="projects">
                <header class="mbd-col_head">
                  <span class="mbd-col_index">A</span>
                  <h3 class="mbd-col_title">
                    <span class="mbd-col_title-main">{t('cto.list_projects')}</span>
                    <span class="mbd-col_title-meta" data-count>{projects.length}/04</span>
                  </h3>
                  <a class="mbd-col_all" href={portfolioHref}>
                    {t('cto.view_all')} <span aria-hidden="true">→</span>
                  </a>
                </header>
                <ul class="mbd-list" data-sortable>
                  {projects.map((p, i) => (
                    <li data-search={`${p.title} ${p.tag} ${p.status}`.toLowerCase()}>
                      <a class="mbd-item" href={p.href}>
                        <span class="mbd-item_index" aria-hidden="true">0{i + 1}</span>
                        <span
                          class="mbd-item_thumb"
                          style={`background-image:url('${p.image}'); --thumb-accent:${p.accent};`}
                          aria-hidden="true"
                        ></span>
                        <span class="mbd-item_text">
                          <span class="mbd-item_title">{p.title}</span>
                          <span class="mbd-item_meta">
                            <span class="mbd-pill" style={`background:${p.accent};`}>{p.tag}</span>
                            <span class="mbd-item_status">{p.status}</span>
                          </span>
                        </span>
                        <span class="mbd-item_arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <p class="mbd-empty" data-empty>{t('cto.empty')}</p>
              </section>

              <section class="mbd-col" data-list="writing">
                <header class="mbd-col_head">
                  <span class="mbd-col_index">B</span>
                  <h3 class="mbd-col_title">
                    <span class="mbd-col_title-main">{t('cto.list_blog')}</span>
                    <span class="mbd-col_title-meta" data-count>{posts.length}/04</span>
                  </h3>
                  <a class="mbd-col_all" href={blogHref}>
                    {t('cto.view_all')} <span aria-hidden="true">→</span>
                  </a>
                </header>
                <ul class="mbd-list" data-sortable>
                  {posts.map((post, i) => (
                    <li data-search={`${post.title} ${post.tag} ${post.description}`.toLowerCase()}>
                      <a class="mbd-item" href={post.href}>
                        <span class="mbd-item_index" aria-hidden="true">0{i + 1}</span>
                        {post.image ? (
                          <span
                            class="mbd-item_thumb"
                            style={`background-image:url('${post.image}');`}
                            aria-hidden="true"
                          ></span>
                        ) : (
                          <span
                            class="mbd-item_accent"
                            style={`background:${accents[i % accents.length]};`}
                            aria-hidden="true"
                          ></span>
                        )}
                        <span class="mbd-item_text">
                          <span class="mbd-item_title">{post.title}</span>
                          <span class="mbd-item_meta">
                            {post.tag && <span class="mbd-pill mbd-pill--ghost">#{post.tag}</span>}
                            <span class="mbd-item_status">{post.date}</span>
                          </span>
                        </span>
                        <span class="mbd-item_arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <p class="mbd-empty" data-empty>{t('cto.empty')}</p>
              </section>
            </div>
          </section>

          <!-- ========== DOCK ========== -->
          <nav class="mbd-dock" data-mbd-dock aria-label={t('cto.heading')}>
            <span class="mbd-dock_shine" aria-hidden="true"></span>
            {
              apps.map((app) =>
                app.href ? (
                  <a
                    class="mbd-app"
                    href={app.href}
                    data-app={app.id}
                    data-tooltip={app.name}
                    aria-label={app.name}
                  >
                    <span class="mbd-app_icon">
                      <img src={app.icon} alt="" width="44" height="44" loading="lazy" />
                    </span>
                    {app.badge && <span class="mbd-badge">{app.badge}</span>}
                    <span class="mbd-runlight" aria-hidden="true"></span>
                  </a>
                ) : (
                  <button
                    type="button"
                    class="mbd-app"
                    data-open={app.id}
                    data-app={app.id}
                    data-tooltip={app.name}
                    aria-label={app.name}
                  >
                    <span class="mbd-app_icon">
                      <img src={app.icon} alt="" width="44" height="44" loading="lazy" />
                    </span>
                    {app.badge && <span class="mbd-badge">{app.badge}</span>}
                    <span class="mbd-runlight" aria-hidden="true"></span>
                  </button>
                )
              )
            }
            <a
              class="mbd-app"
              href={blogHref}
              data-app="blog"
              data-tooltip={t('cto.dock_blog')}
              aria-label={t('cto.dock_blog')}
            >
              <span class="mbd-app_icon">
                <span class="mbd-blogicon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
                    <path d="M4.5 11.5a8 8 0 0 1 8 8" />
                    <path d="M4.5 4.5a15 15 0 0 1 15 15" />
                    <circle cx="5.6" cy="18.4" r="1.9" fill="currentColor" stroke="none" />
                  </svg>
                </span>
              </span>
              <span class="mbd-runlight" aria-hidden="true"></span>
            </a>
            <span class="mbd-dock_sep" aria-hidden="true"></span>
            <a
              class="mbd-app mbd-app--stack"
              href={portfolioHref}
              data-app="portfolio"
              data-tooltip={t('cto.dock_portfolio')}
              aria-label={t('cto.dock_portfolio')}
            >
              <span class="mbd-app_icon">
                <span class="mbd-folder" aria-hidden="true">
                  <span class="mbd-folder_tab"></span>
                  <span class="mbd-folder_face"></span>
                </span>
              </span>
              <span class="mbd-runlight" aria-hidden="true"></span>
            </a>
            <button
              type="button"
              class="mbd-app mbd-app--trash"
              data-trash
              data-tooltip={t('cto.dock_trash')}
              aria-label={t('cto.dock_trash')}
            >
              <span class="mbd-app_icon">
                <span class="mbd-trash" aria-hidden="true">
                  <span class="mbd-trash_lid"></span>
                  <span class="mbd-trash_can"></span>
                </span>
              </span>
              <span class="mbd-runlight" aria-hidden="true"></span>
            </button>
          </nav>

          <div class="mbd-pointer" data-mbd-pointer aria-hidden="true">
            <svg viewBox="0 0 20 26" width="20" height="26">
              <path
                d="M1 1.4 1 22.2l5-4.9 3.1 7.1 3.5-1.5-3-6.9 6.9-.4z"
                fill="#fff"
                stroke="#111"
                stroke-width="1.1"
                stroke-linejoin="round"
              />
            </svg>
          </div>

              <div class="mbd-windows" data-windows>

                <!-- ========== XCODE 26 ========== -->
                <section class="mbd-win mbd-win--xcode" data-window="xcode" aria-hidden="true">
                  <header class="mbd-win_chrome mbd-win_chrome--xcode">
                    <div class="mbd-win_lights" aria-hidden="true">
                      <span class="mbd-light mbd-light--r" data-close></span>
                      <span class="mbd-light mbd-light--y" data-minimize></span>
                      <span class="mbd-light mbd-light--g"></span>
                    </div>
                    <div class="xc-toolbar">
                      <span class="xc-btn">▶</span>
                      <span class="xc-btn">■</span>
                      <span class="xc-divider"></span>
                      <span class="xc-scheme">
                        <span class="xc-scheme_dot"></span>
                        tyfn.app <span class="xc-scheme_caret">›</span> iPhone 16 Pro
                      </span>
                    </div>
                    <div class="xc-status">{t('cto.win_xcode_subtitle')}</div>
                  </header>
                  <div class="xc-body">
                    <aside class="xc-nav">
                      <div class="xc-nav_head">PROJECT</div>
                      <ul class="xc-tree">
                        <li class="xc-tree_group is-open">
                          <span class="xc-tree_label">▾ tyfn.app</span>
                          <ul>
                            <li class="xc-tree_group is-open">
                              <span class="xc-tree_label">▾ iOS</span>
                              <ul>
                                <li><span class="xc-file is-active">􀐘 tyfnApp.swift</span></li>
                                <li><span class="xc-file">􀐘 ContentView.swift</span></li>
                              </ul>
                            </li>
                            <li class="xc-tree_group">
                              <span class="xc-tree_label">▸ macOS</span>
                            </li>
                            <li class="xc-tree_group">
                              <span class="xc-tree_label">▸ watchOS</span>
                            </li>
                            <li class="xc-tree_group">
                              <span class="xc-tree_label">▸ iPadOS</span>
                            </li>
                            <li class="xc-tree_group">
                              <span class="xc-tree_label">▸ Assets.xcassets</span>
                            </li>
                          </ul>
                        </li>
                      </ul>
                    </aside>
                    <main class="xc-editor">
                      <div class="xc-tabbar">
                        <span class="xc-tab is-active">tyfnApp.swift</span>
                        <span class="xc-tab">ContentView.swift</span>
                      </div>
                      <pre class="xc-code"><code><span class="xc-ln">1</span>  <span class="xc-c">// {t('cto.win_xcode_lede')}</span>
<span class="xc-ln">2</span>  <span class="xc-kw">import</span> <span class="xc-id">SwiftUI</span>
<span class="xc-ln">3</span>
<span class="xc-ln">4</span>  <span class="xc-at">@main</span>
<span class="xc-ln">5</span>  <span class="xc-kw">struct</span> <span class="xc-ty">tyfnApp</span>: <span class="xc-ty">App</span> {'{'}
<span class="xc-ln">6</span>    <span class="xc-kw">var</span> body: <span class="xc-kw">some</span> <span class="xc-ty">Scene</span> {'{'}
<span class="xc-ln">7</span>      <span class="xc-ty">WindowGroup</span> {'{'} <span class="xc-ty">ContentView</span>() {'}'}
<span class="xc-ln">8</span>    {'}'}
<span class="xc-ln">9</span>  {'}'}
<span class="xc-ln">10</span>
<span class="xc-ln">11</span>  <span class="xc-kw">struct</span> <span class="xc-ty">ContentView</span>: <span class="xc-ty">View</span> {'{'}
<span class="xc-ln">12</span>    <span class="xc-kw">let</span> platforms = [<span class="xc-s">"iOS"</span>, <span class="xc-s">"macOS"</span>, <span class="xc-s">"watchOS"</span>, <span class="xc-s">"iPadOS"</span>]
<span class="xc-ln">13</span>
<span class="xc-ln">14</span>    <span class="xc-kw">var</span> body: <span class="xc-kw">some</span> <span class="xc-ty">View</span> {'{'}
