</style>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { MeshoptDecoder } from 'three/examples/jsm/libs/meshopt_decoder.module.js';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

  const stage = document.querySelector<HTMLElement>('[data-mbd-stage]');
  const wrap = document.querySelector<HTMLElement>('[data-mbd-canvas-wrap]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-mbd-canvas]');
  const screenUi = document.querySelector<HTMLElement>('[data-mbd-screen-ui]');

  const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
  const mix = (a: number, b: number, t: number) => a + (b - a) * t;
  const smoothstep = (edge0: number, edge1: number, x: number) => {
    const t = clamp01((x - edge0) / (edge1 - edge0));
    return t * t * (3 - 2 * t);
  };

  function init() {
    if (!stage || !wrap || !canvas || !screenUi) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    } catch {
      document.querySelector('[data-mbd-flight]')?.remove();
      wrap.style.display = 'none';
      return;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 0.94;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    /* ------------------------------------------------------------------
     * Flight layer — the laptop is lifted out of its in-flow box and into a
     * sticky viewport-sized layer that spans the whole #projects section, so
     * it can drift behind the scroll scene and only land in its box at the
     * end. The in-flow box stays as an invisible placeholder and is read
     * every frame as the landing target.
     * ---------------------------------------------------------------- */
    const section = stage.closest<HTMLElement>('#projects');
    const flight = document.querySelector<HTMLElement>('[data-mbd-flight]');
    const uiLayer = document.querySelector<HTMLElement>('[data-mbd-uilayer]');
    let sticky = flight?.querySelector<HTMLElement>('[data-mbd-flight-sticky]') ?? null;
    const uiSticky = uiLayer?.querySelector<HTMLElement>('[data-mbd-ui-sticky]') ?? null;
    if (section && flight && sticky && uiLayer && uiSticky) {
      section.insertBefore(flight, section.firstChild);
      section.appendChild(uiLayer);
      sticky.appendChild(canvas);
      uiSticky.appendChild(screenUi);
      wrap.classList.add('is-detached');
    } else {
      flight?.remove();
      uiLayer?.remove();
      sticky = null;
    }
    const host: HTMLElement = sticky ?? wrap;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 1, 0.01, 40);

    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;

    const key = new THREE.DirectionalLight(0xfff4e5, 1.3);
    key.position.set(1.2, 2.2, 1.6);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0x88aaff, 0.45);
    rim.position.set(-1.6, 0.8, -1.2);
    scene.add(rim);

    const pivot = new THREE.Group();
    scene.add(pivot);

    let screenCorners: THREE.Vector3[] | null = null;
    let lcdMeshRef: THREE.Mesh | null = null;
    let lidNode: THREE.Object3D | null = null;
    let lidOpenX = 0;
    const lidClosedX = Math.PI / 2;
    let lidHingeY = 0;
    let lidLift = 0;
    /* pivot X that puts the shut lid square to the camera (the framing axis is
       tilted back by the extra opening angle, so 90deg alone would miss) */
    let lidFacingX = Math.PI / 2;

    /* ---------- finish: Space Black in dark mode, Silver in light ---------- */
    const caseMats = new Set<THREE.MeshStandardMaterial>();
    const badgeMats = new Set<THREE.MeshStandardMaterial>();
    const padMats = new Set<THREE.MeshStandardMaterial>();

    const FINISH = {
      dark: {
        case: 0x2c2c30, caseRough: 0.42,
        badge: 0x9aa0a8, badgeRough: 0.08,
        pad: 0x25252a,
        key: 2.1, rim: 1.5, exposure: 1.12,
      },
      light: {
        case: 0xd6d8db, caseRough: 0.34,
        badge: 0x6b7078, badgeRough: 0.1,
        pad: 0xc9ccd1,
        key: 1.3, rim: 0.45, exposure: 0.94,
      },
    } as const;

    function isLightTheme() {
      return document.documentElement.getAttribute('data-theme') === 'light';
    }

    function applyFinish() {
      const f = isLightTheme() ? FINISH.light : FINISH.dark;
      for (const m of caseMats) {
        m.color?.setHex(f.case);
        if ('roughness' in m) m.roughness = f.caseRough;
        if ('metalness' in m) m.metalness = 0.9;
        m.needsUpdate = true;
      }
      for (const m of badgeMats) {
        m.color?.setHex(f.badge);
        if ('roughness' in m) m.roughness = f.badgeRough;
        if ('metalness' in m) m.metalness = 1;
        m.needsUpdate = true;
      }
      for (const m of padMats) {
        m.color?.setHex(f.pad);
        if ('roughness' in m) m.roughness = 0.16;
        if ('metalness' in m) m.metalness = 0.5;
        m.needsUpdate = true;
      }
      /* A near-black chassis on a near-black page needs its edges lit, or the
         whole thing dissolves while it cruises; silver needs the opposite. */
      key.intensity = f.key;
      rim.intensity = f.rim;
      renderer.toneMappingExposure = f.exposure;
    }

    new MutationObserver(applyFinish).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    const modelCorners: THREE.Vector3[] = [];

    const surface = { w: 800, h: 500 };
    let ready = false;
    let raf = 0;
    let running = false;
    const clock = new THREE.Clock();

    /* framing state, solved once the model is in */
    const fit = {
      nrm: new THREE.Vector3(0, 0, 1),
      up: new THREE.Vector3(0, 1, 0),
      target: new THREE.Vector3(),
      dist: 1,
      aspect: 1.6,
    };

    const pointer = { cx: 0, cy: 0, lx: 0, ly: 0, inside: false, moved: false };
    const tilt = { x: 0, y: 0, z: 0 };
    let landT = 0;
    let openT = 0;

    function hostSize() {
      return { w: host.clientWidth || 1, h: host.clientHeight || 1 };
    }

    function sizeRenderer() {
      const { w, h } = hostSize();
      renderer.setSize(w, h, false);
    }
    sizeRenderer();
    new ResizeObserver(() => {
      sizeRenderer();
      solveFraming();
    }).observe(host);

    /* ---------- projection helpers ---------- */
    const tmpV = new THREE.Vector3();
    function projectToPx(v: THREE.Vector3, w: number, h: number): number[] {
      tmpV.copy(v).project(camera);
      return [(tmpV.x * 0.5 + 0.5) * w, (-tmpV.y * 0.5 + 0.5) * h];
    }

    /**
     * Place the camera dead-on the screen normal and pull it back until the
     * whole laptop fits the framing rect. Dead-on is the point: the lid is
     * then exactly parallel to the viewer, so the display reads as a true
     * rectangle instead of a trapezoid.
     */
    function solveFraming() {
      if (!ready) return;
      const wr = wrap.getBoundingClientRect();
      fit.aspect = Math.max(0.2, (wr.width || 16) / (wr.height || 10));

      const savedRot = pivot.rotation.clone();
      const savedLid = lidNode ? lidNode.rotation.x : 0;
      const savedLidY = lidNode ? lidNode.position.y : 0;
      pivot.rotation.set(0, 0, 0);
      if (lidNode) {
        lidNode.rotation.x = lidOpenX;
        lidNode.position.y = lidHingeY + lidLift * (1 - Math.cos(lidOpenX));
      }
      pivot.updateWorldMatrix(true, true);

      camera.clearViewOffset();
      camera.aspect = fit.aspect;
      camera.up.copy(fit.up);

      const right = new THREE.Vector3();
      const camUp = new THREE.Vector3();
      const pad = 0.985; // fraction of the frame the model may occupy

      for (let iter = 0; iter < 14; iter++) {
        camera.position.copy(fit.target).addScaledVector(fit.nrm, fit.dist);
        camera.lookAt(fit.target);
        camera.updateMatrixWorld();
        camera.updateProjectionMatrix();
        camera.matrixWorld.extractBasis(right, camUp, new THREE.Vector3());

        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
        for (const c of modelCorners) {
          tmpV.copy(c).project(camera);
          if (tmpV.x < minX) minX = tmpV.x;
          if (tmpV.x > maxX) maxX = tmpV.x;
          if (tmpV.y < minY) minY = tmpV.y;
          if (tmpV.y > maxY) maxY = tmpV.y;
        }
        const cx = (minX + maxX) / 2;
        const cy = (minY + maxY) / 2;
        const halfH = Math.tan(THREE.MathUtils.degToRad(camera.fov) / 2) * fit.dist;
        const halfW = halfH * fit.aspect;
        fit.target.addScaledVector(right, cx * halfW).addScaledVector(camUp, cy * halfH);
        fit.dist *= Math.max((maxX - minX) / 2, (maxY - minY) / 2) / pad;
      }

      camera.position.copy(fit.target).addScaledVector(fit.nrm, fit.dist);
      camera.lookAt(fit.target);
      camera.updateMatrixWorld();

      pivot.rotation.copy(savedRot);
      if (lidNode) {
        lidNode.rotation.x = savedLid;
        lidNode.position.y = savedLidY;
      }
      pivot.updateWorldMatrix(true, true);

      /* size the DOM overlay to the screen's projected aspect */
      if (screenCorners && lcdMeshRef) {
        camera.updateProjectionMatrix();
        const quad = screenCorners
          .map((c) => c.clone().applyMatrix4(lcdMeshRef!.matrixWorld))
          .map((p) => projectToPx(p, 1000, Math.round(1000 / fit.aspect)));
        const xs = quad.map((p) => p[0]);
        const ys = quad.map((p) => p[1]);
        const aspect =
          (Math.max(...xs) - Math.min(...xs)) /
          Math.max(1e-4, Math.max(...ys) - Math.min(...ys));
        /* A narrow viewport shrinks the laptop, not the pixels: using a
           smaller design surface keeps the UI legible once it is projected
           onto a phone-sized panel. The compact layout below is driven by
           container queries on this surface, never by the viewport. */
        surface.w = window.innerWidth < 768 ? 520 : 700;
        surface.h = Math.round(surface.w / aspect);
        screenUi.style.width = surface.w + 'px';
        screenUi.style.height = surface.h + 'px';
        screenUi.style.borderRadius = (surface.w * 0.042).toFixed(1) + 'px';
        laidOut = false;
      }
    }

    /**
     * Render the framed image into an arbitrary rectangle of the canvas.
     * `setViewOffset` treats (rw, rh) as the full image and renders the
     * sub-window that the canvas covers — so the laptop lands wherever the
     * rect is, without ever moving the camera.
     */
    function applyRect(rx: number, ry: number, rw: number, rh: number) {
      const { w, h } = hostSize();
      camera.aspect = fit.aspect;
      camera.setViewOffset(rw, rh, -rx, -ry, w, h);
    }

    /* ---------- model ---------- */
    const loader = new GLTFLoader();
    loader.setMeshoptDecoder(MeshoptDecoder);

    loader.load(
      '/models/macbook-ultra.glb',
      (gltf) => {
        const model = gltf.scene;

        const bbox = new THREE.Box3().setFromObject(model);
        const center = bbox.getCenter(new THREE.Vector3());
        model.position.sub(center);
        pivot.add(model);
        pivot.position.copy(center);
        pivot.updateWorldMatrix(true, true);

        /* The Lid node pivots around the panel's own centre, so rotating it
           makes the lid hover instead of shut. Re-parent it under a group
           placed on the actual hinge line -- the bottom-back edge of the panel
           while it stands upright -- and drive that instead.
           The open angle also goes a little past 90deg: real laptops do, and
           with the camera dead-on the display a 90deg lid would render the
           chassis perfectly edge-on. */
        const rawLid = model.getObjectByName('Lid') ?? null;
        if (rawLid) {
          pivot.updateWorldMatrix(true, true);
          const lidBox = new THREE.Box3().setFromObject(rawLid);
          const parent = rawLid.parent!;
          const hinge = new THREE.Group();
          /* pivot sits at the model centre and the model is offset by -centre,
             so world space and the lid's parent space coincide here. */
          hinge.position.set(
            rawLid.position.x,
            lidBox.min.y,
            (lidBox.min.z + lidBox.max.z) / 2,
          );
          parent.add(hinge);
          rawLid.position.sub(hinge.position);
          hinge.add(rawLid);
          lidNode = hinge;
          lidHingeY = hinge.position.y;

          /* The hinge line sits inside the chassis, so a straight 90deg swing
             buries the shut lid under the keyboard. Measure how far short it
             lands and lift the hinge by that much as it closes — the travel is
             a few millimetres and reads as the lid simply settling shut. */
          let baseTop = -Infinity;
          for (const n of ['Bottom case', 'Keyboard', 'Top case', 'Trackpad']) {
            const m = model.getObjectByName(n);
            if (m) baseTop = Math.max(baseTop, new THREE.Box3().setFromObject(m).max.y);
          }
          hinge.rotation.x = lidClosedX;
          pivot.updateWorldMatrix(true, true);
          const shutBottom = new THREE.Box3().setFromObject(hinge).min.y;
          if (isFinite(baseTop)) lidLift = Math.max(0, baseTop - shutBottom + 0.0003);

          lidOpenX = -THREE.MathUtils.degToRad(13);
          hinge.rotation.x = lidOpenX;
          pivot.updateWorldMatrix(true, true);
        }

        /* corners of the whole laptop, in pivot-local space, for the fit */
        const lb = new THREE.Box3().setFromObject(pivot);
        for (let i = 0; i < 8; i++) {
          modelCorners.push(
            new THREE.Vector3(
              i & 1 ? lb.max.x : lb.min.x,
              i & 2 ? lb.max.y : lb.min.y,
              i & 4 ? lb.max.z : lb.min.z,
            ),
          );
        }

        /* find the display mesh by its LCD material */
        let lcd: THREE.Mesh | null = null;
        model.traverse((obj) => {
          if (!(obj instanceof THREE.Mesh)) return;
          const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
          for (const m of mats) {
            /* The chassis and the badge follow the page theme: Space Black in
               the dark palette, Silver in the light one. The badge ships the
               exact colour of the case, which makes it vanish, so it always
               gets its own polished tone. */
            if (m && /^anodized aluminum/i.test(m.name ?? '')) {
              caseMats.add(m as THREE.MeshStandardMaterial);
            }
            /* the trackpad is its own glass, and it has to follow the case —
               a Space Black machine with a white pad looks wrong */
            if (m && /touchpad/i.test(m.name ?? '')) {
              padMats.add(m as THREE.MeshStandardMaterial);
            }
            if (m && /apple\s*logo/i.test(m.name ?? '')) {
              badgeMats.add(m as THREE.MeshStandardMaterial);
            }
            if (!m || !/lcd/i.test(m.name ?? '')) continue;
            if (!lcd) lcd = obj;
            /* the DOM overlay is the display, so the panel underneath is
               just a dark, slightly reflective sheet */
            const mm = m as THREE.MeshStandardMaterial;
            if (mm.color) mm.color.setHex(0x08080b);
            if ('roughness' in mm) mm.roughness = 0.28;
            if ('metalness' in mm) mm.metalness = 0.1;
            if (mm.emissive) mm.emissive.setHex(0x05060a);
            if (mm.map) mm.map = null;
            mm.needsUpdate = true;
          }
        });

        const size = bbox.getSize(new THREE.Vector3());
        fit.dist = size.length();
        fit.target.copy(center);

        if (lcd) {
          lcdMeshRef = lcd as THREE.Mesh;
          const mesh = lcdMeshRef;

          // Bbox of only the LCD-material primitives (the Lid mesh also contains
          // the aluminum lid back, so the whole-mesh bbox is far too large).
          const geo = mesh.geometry;
          const pos = geo.getAttribute('position');
          const sb = new THREE.Box3();
          const vTmp = new THREE.Vector3();
          const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
          const groups = geo.groups.length
            ? geo.groups
            : [{ start: 0, count: geo.index ? geo.index.count : pos.count, materialIndex: 0 }];
          let found = false;
          for (const g of groups) {
            const m = mats[g.materialIndex];
            if (!m || !/lcd/i.test(m.name ?? '')) continue;
            found = true;
            for (let i = g.start; i < g.start + g.count; i++) {
              const idx = geo.index ? geo.index.getX(i) : i;
              vTmp.fromBufferAttribute(pos, idx);
              sb.expandByPoint(vTmp);
            }
          }
          if (!found) sb.setFromBufferAttribute(pos);
          const ls = new THREE.Vector3().subVectors(sb.max, sb.min);

          // Thinnest bbox axis = screen normal axis.
          const axes = ['x', 'y', 'z'] as const;
          const thin = axes.reduce((a, b) => (ls[a] < ls[b] ? a : b));
          const others = axes.filter((a) => a !== thin);

          const worldQ = mesh.getWorldQuaternion(new THREE.Quaternion());
          const faceCenter = (side: 0 | 1) => {
            const c = new THREE.Vector3();
            c[thin] = side === 0 ? sb.min[thin] : sb.max[thin];
            for (const a of others) c[a] = (sb.min[a] + sb.max[a]) / 2;
            return c.applyMatrix4(mesh.matrixWorld);
          };
          /* the face that points away from the keyboard is the one we watch */
          const probe = center.clone().add(new THREE.Vector3(0, 0, fit.dist));
          const bestSide: 0 | 1 =
            faceCenter(1).distanceTo(probe) < faceCenter(0).distanceTo(probe) ? 1 : 0;

          const nrmLocal = new THREE.Vector3();
          nrmLocal[thin] = bestSide === 0 ? -1 : 1;
          fit.nrm.copy(nrmLocal).applyQuaternion(worldQ).normalize();
          lidFacingX = Math.PI / 2 - Math.atan2(fit.nrm.y, fit.nrm.z);

          /* the taller in-plane axis is "up" on the display */
          const upAxis = ls[others[0]] < ls[others[1]] ? others[0] : others[1];
          const upLocal = new THREE.Vector3();
          upLocal[upAxis] = 1;
          fit.up.copy(upLocal).applyQuaternion(worldQ).normalize();
          if (fit.up.y < 0) fit.up.negate();

          const corners: THREE.Vector3[] = [];
          for (let i = 0; i < 4; i++) {
            const p = new THREE.Vector3();
            p[thin] = bestSide === 0 ? sb.min[thin] : sb.max[thin];
            p[others[0]] = i & 1 ? sb.max[others[0]] : sb.min[others[0]];
            p[others[1]] = i & 2 ? sb.max[others[1]] : sb.min[others[1]];
            corners.push(p);
          }
          screenCorners = corners;
        }

        applyFinish();

        ready = true;
        clock.getDelta();
        solveFraming();
        measureDock();
        host.classList.add('is-ready');
        wrap.classList.add('is-ready');
      },
      undefined,
      () => {
        host.classList.add('is-failed');
        wrap.style.display = 'none';
      },
    );

    /* ---------- homography: overlay rect -> projected screen quad ---------- */
    function solve8(A: number[][], b: number[]): number[] {
      const M = A.map((row, i) => [...row, b[i]]);
      for (let col = 0; col < 8; col++) {
        let piv = col;
        for (let r = col + 1; r < 8; r++) if (Math.abs(M[r][col]) > Math.abs(M[piv][col])) piv = r;
        [M[col], M[piv]] = [M[piv], M[col]];
        const d = M[col][col] || 1e-12;
        for (let r = 0; r < 8; r++) {
          if (r === col) continue;
          const f = M[r][col] / d;
          for (let c = col; c <= 8; c++) M[r][c] -= f * M[col][c];
        }
      }
      return Array.from({ length: 8 }, (_, i) => M[i][8] / (M[i][i] || 1e-12));
    }

    /* inverse of the current surface -> host-pixel homography */
    let homInv: number[] | null = null;
    function invertHomography(m: number[]) {
      const a = m[0], b = m[1], c = m[2], d = m[3], e = m[4], f = m[5], g = m[6], h = m[7];
      const A = e - f * h, B = c * h - b, C = b * f - c * e;
      const D = f * g - d, E = a - c * g, F = c * d - a * f;
      const G = d * h - e * g, H = b * g - a * h, I = a * e - b * d;
      const det = a * A + b * D + c * G;
      if (!det || !isFinite(det)) return null;
      return [A, B, C, D, E, F, G, H, I].map((v) => v / det);
    }
    function hostToSurface(px: number, py: number): number[] | null {
      if (!homInv) return null;
      const [a, b, c, d, e, f, g, h, i] = homInv;
      const w = g * px + h * py + i;
      if (Math.abs(w) < 1e-9) return null;
      return [(a * px + b * py + c) / w, (d * px + e * py + f) / w];
    }

    function updateScreenUi(w: number, h: number) {
      if (!screenCorners || !lcdMeshRef) return;
      const quad = screenCorners
        .map((c) => c.clone().applyMatrix4(lcdMeshRef!.matrixWorld))
        .map((p) => projectToPx(p, w, h));

      // Order TL, TR, BR, BL in projected space.
      quad.sort((p, q) => p[1] - q[1]);
      const top = quad.slice(0, 2).sort((p, q) => p[0] - q[0]);
      const bottom = quad.slice(2, 4).sort((p, q) => p[0] - q[0]);
      const ordered = [top[0], top[1], bottom[1], bottom[0]];

      const src = [
        [0, 0],
        [surface.w, 0],
        [surface.w, surface.h],
        [0, surface.h],
      ];
      const A: number[][] = [];
      const b: number[] = [];
      for (let i = 0; i < 4; i++) {
        const [x, y] = src[i];
        const [X, Y] = ordered[i];
        A.push([x, y, 1, 0, 0, 0, -x * X, -y * X]);
        b.push(X);
        A.push([0, 0, 0, x, y, 1, -x * Y, -y * Y]);
        b.push(Y);
      }
      const m = solve8(A, b); // a b c d e f g h
      homInv = invertHomography(m);
      screenUi.style.transform = `matrix3d(${m[0]},${m[3]},0,${m[6]},${m[1]},${m[4]},0,${m[7]},0,0,1,0,${m[2]},${m[5]},0,1)`;
      screenUi.hidden = false;
    }

    /* ------------------------------------------------------------------
     * Dock — magnification, launch bounce, running lights
     * ---------------------------------------------------------------- */
    const dock = screenUi.querySelector<HTMLElement>('[data-mbd-dock]');
    const dockApps = dock ? Array.from(dock.querySelectorAll<HTMLElement>('.mbd-app')) : [];
    const rest: { c: number; w: number }[] = [];
    let dockBox = { top: 0, bottom: 0, left: 0, right: 0 };

    const MAG = 0.85;   // peak growth — macOS tops out near 2x
    const SPREAD = 1.55; // gaussian width, in rest icon widths

    /** Capture the dock's resting layout; every scale is measured against it. */
    function measureDock() {
      if (!dock || !dockApps.length || !dock.offsetWidth) return false;
      dockApps.forEach((el) => el.style.setProperty('--s', '1'));
      rest.length = 0;
      for (const el of dockApps) {
        rest.push({ c: el.offsetLeft + el.offsetWidth / 2, w: el.offsetWidth || 1 });
      }
      const half = dock.offsetWidth / 2;
      dockBox = {
        left: dock.offsetLeft - half,
        right: dock.offsetLeft + half,
        top: dock.offsetTop,
        bottom: dock.offsetTop + dock.offsetHeight,
      };
      return true;
    }

    function updateDock(active: boolean) {
      if (!dock || !rest.length) return;
      const unit = rest[0].w;
      const sigma = unit * SPREAD;
      /* the dock reacts while the cursor is over it or just above it */
      const near =
        active &&
        pointer.ly > dockBox.top - unit * 1.9 &&
        pointer.ly < dockBox.bottom + unit * 0.6 &&
        pointer.lx > dockBox.left - unit &&
        pointer.lx < dockBox.right + unit;

      dockApps.forEach((el, i) => {
        const prev = parseFloat(el.style.getPropertyValue('--s')) || 1;
        let target = 1;
        if (near) {
          const dx = pointer.lx - (dockBox.left + rest[i].c);
          target = 1 + MAG * Math.exp(-(dx * dx) / (2 * sigma * sigma));
        }
        /* a touch of smoothing so the icons settle instead of snapping */
        const s = prev + (target - prev) * (near ? 0.5 : 0.22);
        el.style.setProperty('--s', s.toFixed(3));
      });
    }

    /* ------------------------------------------------------------------
     * Window system — genie in and out of the owning dock icon
     * ---------------------------------------------------------------- */
    const lang = document.documentElement.lang === 'de' ? 'de' : 'en';
    let relayoutTabs: () => void = () => {};

    function iconFor(name: string) {
      return dock?.querySelector<HTMLElement>(`.mbd-app[data-app="${name}"]`) ?? null;
    }
    function winFor(name: string) {
      return screenUi.querySelector<HTMLElement>(`.mbd-win[data-window="${name}"]`) ?? null;
    }

    /** Point the genie at the dock icon that owns the window. */
    function setGenieVars(win: HTMLElement, icon: HTMLElement | null) {
      if (!icon || !dock) return;
      const bx = win.offsetLeft + win.offsetWidth / 2;
      const by = win.offsetTop + win.offsetHeight;
      const ix = dock.offsetLeft + icon.offsetLeft + icon.offsetWidth / 2;
      const iy = dock.offsetTop + icon.offsetTop + icon.offsetHeight / 2;
      win.style.setProperty('--gdx', `${(ix - bx).toFixed(1)}px`);
      win.style.setProperty('--gdy', `${(iy - by).toFixed(1)}px`);
    }

    function bounce(icon: HTMLElement | null) {
      if (!icon || reducedMotion) return;
      icon.classList.remove('is-bouncing');
      void icon.offsetWidth;
      icon.classList.add('is-bouncing');
      icon.addEventListener(
        'animationend',
        () => icon.classList.remove('is-bouncing'),
        { once: true },
      );
    }

    function openWindow(name: string) {
      const win = winFor(name);
      const icon = iconFor(name);
      if (!win) return;
      if (screenUi.getAttribute('data-open-window') === name) return;
      closeWindow(true, true);
      setGenieVars(win, icon);
      screenUi.setAttribute('data-open-window', name);
      win.classList.remove('is-genie-out');
      void win.offsetWidth;
      win.classList.add('is-genie-in');
      win.addEventListener(
        'animationend',
        () => win.classList.remove('is-genie-in'),
        { once: true },
      );
      icon?.classList.add('is-running');
      bounce(icon);
      setNotifOpen(false);
    }

    function closeWindow(minimize = false, instant = false) {
      const name = screenUi.getAttribute('data-open-window');
      if (!name) return;
      const win = winFor(name);
      const icon = iconFor(name);
      screenUi.removeAttribute('data-open-window');
      if (!minimize) icon?.classList.remove('is-running');
      if (!win) return;
      win.classList.remove('is-genie-in');
      if (instant) return;
      setGenieVars(win, icon);
      win.classList.add('is-genie-out');
      win.addEventListener(
        'animationend',
        () => win.classList.remove('is-genie-out'),
        { once: true },
      );
    }

    screenUi.addEventListener('click', (e) => {
      const target = e.target as Element;

      const opener = target.closest<HTMLElement>('[data-open]');
      if (opener) {
        e.preventDefault();
        openWindow(opener.getAttribute('data-open')!);
        return;
      }
      if (target.closest('[data-close]')) {
        closeWindow(false);
        return;
      }
      if (target.closest('[data-minimize]')) {
        closeWindow(true);
        return;
      }
      const trash = target.closest<HTMLElement>('[data-trash]');
      if (trash) {
        bounce(trash);
        return;
      }
      /* links out of the laptop still bounce their icon before leaving */
      const link = target.closest<HTMLElement>('.mbd-app[href]');
      if (link) {
        bounce(link);
        return;
      }
      if (screenUi.hasAttribute('data-open-window') && !target.closest('.mbd-win')) {
        closeWindow(false);
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (screenUi.classList.contains('is-notif-open')) setNotifOpen(false);
      else if (screenUi.hasAttribute('data-open-window')) closeWindow(false);
    });

    /* ------------------------------------------------------------------
     * Menu bar: live clock, battery, notification centre
     * ---------------------------------------------------------------- */
    function initClock() {
      const timeEl = screenUi.querySelector<HTMLElement>('[data-clock-time]');
      const dateEl = screenUi.querySelector<HTMLElement>('[data-clock-date]');
      if (!timeEl || !dateEl) return;
      const locale = lang === 'de' ? 'de-DE' : 'en-US';
      const dateOpts: Intl.DateTimeFormatOptions = { weekday: 'short', day: '2-digit', month: 'short' };
      const tick = () => {
        const now = new Date();
        timeEl.textContent =
          String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
        dateEl.textContent = now.toLocaleDateString(locale, dateOpts);
      };
      tick();
      setTimeout(() => {
        tick();
        setInterval(tick, 60000);
      }, (60 - new Date().getSeconds()) * 1000);
    }

    function initBattery() {
      const box = screenUi.querySelector<HTMLElement>('[data-battery]');
      const level = screenUi.querySelector<HTMLElement>('[data-battery-level]');
      const pct = screenUi.querySelector<HTMLElement>('[data-battery-pct]');
      if (!box || !level || !pct) return;
      const paint = (value: number, charging: boolean) => {
        const p = Math.round(clamp01(value) * 100);
        level.style.width = Math.max(6, p) + '%';
        pct.textContent = p + '%';
        box.classList.toggle('is-low', p <= 20 && !charging);
        box.classList.toggle('is-charging', charging);
      };
      const nav = navigator as Navigator & { getBattery?: () => Promise<any> };
      if (typeof nav.getBattery === 'function') {
        nav
          .getBattery()
          .then((b: any) => {
            paint(b.level, b.charging);
            b.addEventListener('levelchange', () => paint(b.level, b.charging));
            b.addEventListener('chargingchange', () => paint(b.level, b.charging));
          })
          .catch(() => paint(0.82, false));
      } else {
        paint(0.82, false);
      }
    }

    function setNotifOpen(open: boolean) {
      screenUi.classList.toggle('is-notif-open', open);
      const panel = screenUi.querySelector('[data-mbd-notif]');
      panel?.setAttribute('aria-hidden', open ? 'false' : 'true');
    }

    function initNotif() {
      const toggle = screenUi.querySelector<HTMLElement>('[data-toggle="notif"]');
      const close = screenUi.querySelector<HTMLElement>('[data-notif-close]');
      if (!toggle) return;
      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        setNotifOpen(!screenUi.classList.contains('is-notif-open'));
      });
      close?.addEventListener('click', () => setNotifOpen(false));
      screenUi.addEventListener('click', (e) => {
        if (!screenUi.classList.contains('is-notif-open')) return;
        const t = e.target as Element;
        if (t.closest('[data-mbd-notif]') || t.closest('[data-toggle="notif"]')) return;
        setNotifOpen(false);
      });
    }

    /* ------------------------------------------------------------------
     * Desktop window: tabs, search, sort
     * ---------------------------------------------------------------- */
    function initTabs() {
      const tabs = Array.from(screenUi.querySelectorAll<HTMLElement>('.mbd-tab'));
      const pill = screenUi.querySelector<HTMLElement>('.mbd-tab_pill');
      const body = screenUi.querySelector<HTMLElement>('[data-deskwin-body]');
      if (!tabs.length || !body) return;

      const movePill = (el: HTMLElement) => {
        if (!pill) return;
        pill.style.width = el.offsetWidth + 'px';
        pill.style.transform = `translateX(${el.offsetLeft}px)`;
      };

      const select = (el: HTMLElement) => {
        tabs.forEach((t) => {
          const on = t === el;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        const view = el.getAttribute('data-tab') || 'all';
        if (view === 'all') body.removeAttribute('data-view');
        else body.setAttribute('data-view', view);
        movePill(el);
      };

      tabs.forEach((t) => t.addEventListener('click', () => select(t)));
      relayoutTabs = () => {
        const active = tabs.find((t) => t.classList.contains('is-active')) ?? tabs[0];
        if (active && active.offsetWidth) movePill(active);
      };
      relayoutTabs();
    }

    function initSearch() {
      const input = screenUi.querySelector<HTMLInputElement>('[data-search]');
      if (!input) return;
      const cols = Array.from(screenUi.querySelectorAll<HTMLElement>('.mbd-col'));

      const apply = () => {
        const q = input.value.trim().toLowerCase();
        cols.forEach((col) => {
          let visible = 0;
          col.querySelectorAll<HTMLElement>('li[data-search]').forEach((li) => {
            const hit = !q || (li.getAttribute('data-search') || '').includes(q);
            li.hidden = !hit;
            if (hit) visible++;
          });
          col.classList.toggle('is-empty', visible === 0);
          const count = col.querySelector<HTMLElement>('[data-count]');
          if (count) count.textContent = `${visible}/04`;
        });
      };
      input.addEventListener('input', apply);
      input.addEventListener('search', apply);

      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k' && screenUi.classList.contains('is-live')) {
          e.preventDefault();
          input.focus();
          input.select();
        }
      });
    }

    function initSort() {
      const btn = screenUi.querySelector<HTMLElement>('[data-sort]');
      const label = screenUi.querySelector<HTMLElement>('[data-sort-label]');
      if (!btn) return;
      const labels = {
        en: { newest: 'Newest', oldest: 'Oldest' },
        de: { newest: 'Neueste', oldest: 'Älteste' },
      } as const;
      btn.addEventListener('click', () => {
        const next = (btn.getAttribute('data-sort') || 'newest') === 'newest' ? 'oldest' : 'newest';
        btn.setAttribute('data-sort', next);
        if (label) label.textContent = labels[lang as 'en' | 'de'][next];
        screenUi.querySelectorAll<HTMLElement>('.mbd-list[data-sortable]').forEach((list) => {
          Array.from(list.children)
            .reverse()
            .forEach((li, i) => {
              list.appendChild(li);
              const idx = li.querySelector('.mbd-item_index');
              if (idx) idx.textContent = '0' + (i + 1);
            });
        });
      });
    }

    initClock();
    initBattery();
    initNotif();
    initTabs();
    initSearch();
    initSort();
    /* ---------- Snake / Bug Hunt ---------- */
    function initSnake() {
      const win = screenUi.querySelector<HTMLElement>('.mbd-win--snake');
      if (!win) return;
      const canvasEl = win.querySelector<HTMLCanvasElement>('[data-snake-canvas]');
      const snakeStage = win.querySelector<HTMLElement>('[data-snake-stage]');
      const statusEl = win.querySelector<HTMLElement>('[data-snake-status]');
      const scoreEl = win.querySelector<HTMLElement>('[data-snake-score]');
      const bestEl = win.querySelector<HTMLElement>('[data-snake-best]');
      const restartBtn = win.querySelector<HTMLElement>('[data-snake-restart]');
      const restartLabel = win.querySelector<HTMLElement>('[data-snake-restart-label]');
      if (!canvasEl || !snakeStage || !statusEl || !scoreEl || !bestEl || !restartBtn || !restartLabel)
        return;

      const COLS = 24, ROWS = 16, CELL = 24;
      canvasEl.width = COLS * CELL;
      canvasEl.height = ROWS * CELL;
      const ctx = canvasEl.getContext('2d');
      if (!ctx) return;

      const i18n = {
        idle: statusEl.textContent || '',
        play: lang === 'de' ? 'Los' : 'Play',
        restart: lang === 'de' ? 'Neu starten' : 'Restart',
      };

      const STORE_KEY = 'tyfn-snake-best';
      let best = 0;
      try {
        best = parseInt(sessionStorage.getItem(STORE_KEY) || '0', 10) || 0;
      } catch {}
      bestEl.textContent = String(best).padStart(2, '0');

      let snake: { x: number; y: number }[] = [];
      let dir = { x: 1, y: 0 };
      let nextDir = { x: 1, y: 0 };
      let bug = { x: 0, y: 0 };
      let score = 0;
      let state: 'idle' | 'running' | 'paused' | 'over' = 'idle';
      let lastStep = 0;
      let stepInterval = 130;

      function spawnBug() {
        for (let attempts = 0; attempts < 200; attempts++) {
          const x = Math.floor(Math.random() * COLS);
          const y = Math.floor(Math.random() * ROWS);
          if (!snake.some((s) => s.x === x && s.y === y)) {
            bug = { x, y };
            return;
          }
        }
        bug = { x: 0, y: 0 };
      }

      function updateScore() {
        scoreEl.textContent = String(score).padStart(2, '0');
        if (score > best) {
          best = score;
          bestEl.textContent = String(best).padStart(2, '0');
          try {
            sessionStorage.setItem(STORE_KEY, String(best));
          } catch {}
        }
      }

      function draw() {
        ctx!.fillStyle = '#101012';
        ctx!.fillRect(0, 0, canvasEl!.width, canvasEl!.height);
        ctx!.fillStyle = '#e8e5de';
        for (const s of snake) ctx!.fillRect(s.x * CELL + 2, s.y * CELL + 2, CELL - 4, CELL - 4);
        const cx = bug.x * CELL + CELL / 2;
        const cy = bug.y * CELL + CELL / 2;
        ctx!.fillStyle = '#ff3b30';
        ctx!.beginPath();
        ctx!.arc(cx, cy, CELL * 0.32, 0, Math.PI * 2);
        ctx!.fill();
        ctx!.fillStyle = '#0a0508';
        ctx!.beginPath();
        ctx!.arc(cx - CELL * 0.1, cy - CELL * 0.1, CELL * 0.1, 0, Math.PI * 2);
        ctx!.fill();
      }

      function loop(t: number) {
        raf = requestAnimationFrame(loop);
        if (state !== 'running') return;
        if (t - lastStep < stepInterval) return;
        lastStep = t;
        dir = nextDir;
        const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };
        if (
          head.x < 0 ||
          head.x >= COLS ||
          head.y < 0 ||
          head.y >= ROWS ||
          snake.some((s) => s.x === head.x && s.y === head.y)
        ) {
          state = 'over';
          snakeStage.classList.remove('is-running');
          statusEl.textContent = (lang === 'de'
            ? 'Game Over · {n} Bugs gefangen'
            : 'Game over · ate {n} bugs'
          ).replace('{n}', String(score));
          restartLabel.textContent = i18n.restart;
          return;
        }
        snake.unshift(head);
        if (head.x === bug.x && head.y === bug.y) {
          score++;
          updateScore();
          stepInterval = Math.max(60, stepInterval - 4);
          spawnBug();
        } else {
          snake.pop();
        }
        draw();
      }

      function reset() {
        snake = [{ x: 6, y: 8 }, { x: 5, y: 8 }, { x: 4, y: 8 }];
        dir = { x: 1, y: 0 };
        nextDir = { x: 1, y: 0 };
        score = 0;
        stepInterval = 130;
        spawnBug();
        updateScore();
        state = 'idle';
        statusEl.textContent = i18n.idle;
        restartLabel.textContent = i18n.play;
        snakeStage.classList.remove('is-running');
        draw();
      }

      function startGame() {
        if (state === 'over') reset();
        if (state === 'running') return;
        state = 'running';
        snakeStage.classList.add('is-running');
      }
      function pauseGame() {
        if (state !== 'running') return;
        state = 'paused';
        statusEl.textContent =
          lang === 'de' ? 'Pause — Leertaste zum Weitermachen' : 'Paused — press space to resume';
      }

      function setDir(d: { x: number; y: number }) {
        if (d.x === -dir.x && d.y === -dir.y) return;
        nextDir = d;
        if (state === 'idle' || state === 'paused') startGame();
      }

      function onKey(e: KeyboardEvent) {
        if (screenUi.getAttribute('data-open-window') !== 'snake') return;
        const k = e.key.toLowerCase();
        if (k === 'arrowup' || k === 'w') {
          e.preventDefault();
          setDir({ x: 0, y: -1 });
        } else if (k === 'arrowdown' || k === 's') {
          e.preventDefault();
          setDir({ x: 0, y: 1 });
        } else if (k === 'arrowleft' || k === 'a') {
          e.preventDefault();
          setDir({ x: -1, y: 0 });
        } else if (k === 'arrowright' || k === 'd') {
          e.preventDefault();
          setDir({ x: 1, y: 0 });
        } else if (k === ' ') {
          e.preventDefault();
          if (state === 'running') pauseGame();
          else startGame();
        }
      }
      window.addEventListener('keydown', onKey);

      snakeStage.addEventListener('click', (e) => {
        if ((e.target as Element).closest('.sk-dpad_btn')) return;
        if (state === 'running') pauseGame();
        else startGame();
      });

      restartBtn.addEventListener('click', () => {
        if (state === 'over') reset();
        startGame();
      });

      win.querySelectorAll<HTMLElement>('[data-snake-dir]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const d = btn.getAttribute('data-snake-dir');
          if (d === 'up') setDir({ x: 0, y: -1 });
          if (d === 'down') setDir({ x: 0, y: 1 });
          if (d === 'left') setDir({ x: -1, y: 0 });
          if (d === 'right') setDir({ x: 1, y: 0 });
        });
      });

      new MutationObserver(() => {
        if (
          screenUi.getAttribute('data-open-window') !== 'snake' &&
          state === 'running'
        )
          pauseGame();
      }).observe(screenUi, { attributes: true, attributeFilter: ['data-open-window'] });

      reset();
      requestAnimationFrame(loop);
    }
    initSnake();


    /* ---------- Messages → n8n chatbot bridge ---------- */
    const msgContinue = screenUi.querySelector<HTMLElement>('[data-msg-continue]');
    if (msgContinue) {
      msgContinue.addEventListener('click', () => {
        closeWindow(false);
        setTimeout(() => {
          const t = document.querySelector('#n8n-chat .chat-window-toggle');
          if (t) (t as HTMLElement).click();
        }, 260);
      });
    }

    /* ------------------------------------------------------------------
     * Pointer — mapped through the inverse homography so the dock reacts in
     * the display's own coordinates, not in screen pixels. That also lets us
     * draw a cursor that lives *inside* the laptop.
     * ---------------------------------------------------------------- */
    const fakePointer = screenUi.querySelector<HTMLElement>('[data-mbd-pointer]');

    window.addEventListener(
      'pointermove',
      (e) => {
        pointer.cx = e.clientX;
        pointer.cy = e.clientY;
        pointer.moved = true;
      },
      { passive: true },
    );

    function updatePointer(interactive: boolean) {
      const r = host.getBoundingClientRect();
      const local = interactive ? hostToSurface(pointer.cx - r.left, pointer.cy - r.top) : null;
      const inside =
        !!local &&
        local[0] >= 0 &&
        local[0] <= surface.w &&
        local[1] >= 0 &&
        local[1] <= surface.h &&
        pointer.cx >= r.left &&
        pointer.cx <= r.right &&
        pointer.cy >= r.top &&
        pointer.cy <= r.bottom;

      if (local) {
        pointer.lx = local[0];
        pointer.ly = local[1];
      }
      pointer.inside = inside;

      if (fakePointer && finePointer) {
        screenUi.classList.toggle('is-pointer-in', inside);
        if (inside) {
          fakePointer.style.transform = `translate3d(${pointer.lx.toFixed(1)}px, ${pointer.ly.toFixed(1)}px, 0)`;
        }
      }
      return inside;
    }

    /* ------------------------------------------------------------------
     * Scroll choreography
     *
     *   • through the scene the laptop is small, shut, drifting behind the
     *     other animations
     *   • as its in-flow box comes up it flies into place, squares up to the
     *     viewer and the lid swings open
     * ---------------------------------------------------------------- */
    const flightRect = { x: 0, y: 0, w: 0, h: 0 };
    let laidOut = false;

    /* How big the laptop is while it cruises, as a fraction of its landed
       size. It has to stay readable behind the scroll scene's panels. */
    const CRUISE_SCALE = 0.72;

    const stories = section ? Array.from(section.querySelectorAll<HTMLElement>('.ps-story')) : [];
    const marquee = section?.querySelector<HTMLElement>('.scroll-section') ?? null;
    const header = section?.querySelector<HTMLElement>('.mbd-header') ?? null;
    const cruise = { x: 0, y: 0, seeded: false };

    /**
     * The block of copy the laptop should be sitting behind right now. The
     * scroll scene fades its story columns in and out a pair at a time; we
     * pick one side, and swap sides a few times down the section so the
     * laptop drifts across instead of parking.
     */
    function currentAnchor(progress: number): HTMLElement | null {
      const shown = stories.filter((s) => s.classList.contains('visible'));
      if (shown.length) {
        const front = Math.sin(progress * Math.PI * 3) >= 0;
        return front ? shown[0] : shown[shown.length - 1];
      }
      const onScreen = (el: HTMLElement | null) => {
        if (!el) return false;
        const r = el.getBoundingClientRect();
        return r.bottom > 0 && r.top < window.innerHeight;
      };
      if (onScreen(header)) return header;
      if (onScreen(marquee)) return marquee;
      return null;
    }

    function updateFlight(dt: number) {
      const { w: hw, h: hh } = hostSize();
      const hostRect = host.getBoundingClientRect();
      const box = wrap.getBoundingClientRect();

      /* Landing target: the in-flow placeholder, opened up a little. The
         placeholder is kept short so the section heading stays on screen, but
         the canvas spans the viewport, so the laptop may spill past it. */
      const GROW = 1.2;
      let tw = (box.width || hw) * GROW;
      let th = (box.height || hh) * GROW;
      const maxW = hw * 0.985;
      if (tw > maxW) {
        th *= maxW / tw;
        tw = maxW;
      }
      const tx = box.left - hostRect.left + ((box.width || hw) - tw) / 2;
      const ty = box.top - hostRect.top + ((box.height || hh) - th) / 2;

      let progress = 0;
      if (section) {
        const sr = section.getBoundingClientRect();
        const span = Math.max(1, sr.height - window.innerHeight);
        progress = clamp01(-sr.top / span);
        landT = smoothstep(0, 0.62, clamp01((window.innerHeight - box.top) / (window.innerHeight * 0.62)));
      } else {
        landT = 1;
      }
      /* Reduced motion: skip the whole journey — the laptop simply sits in its
         box, open, the way it would without any choreography. */
      if (reducedMotion) landT = 1;

      /* Cruise: shadow whichever block of copy is currently on screen, so the
         laptop is always drifting behind the thing being read. */
      const amp = reducedMotion ? 0 : 1;
      const fw = tw * CRUISE_SCALE;
      const fh = th * CRUISE_SCALE;

      let ax = hw * 0.5;
      let ay = hh * 0.5;
      const anchor = currentAnchor(progress);
      if (anchor) {
        const ar = anchor.getBoundingClientRect();
        if (ar.width && ar.height) {
          ax = ar.left + ar.width / 2 - hostRect.left;
          ay = ar.top + ar.height / 2 - hostRect.top;
        }
      }
      ax += Math.sin(progress * Math.PI * 3.4 + 0.6) * hw * 0.09 * amp;
      ay += Math.sin(progress * Math.PI * 2.2 + 1.1) * hh * 0.05 * amp;
      /* it may hang off an edge, but never by more than about a fifth */
      ax = Math.min(Math.max(ax, fw * 0.3), hw - fw * 0.3);
      ay = Math.min(Math.max(ay, fh * 0.3), hh - fh * 0.3);

      if (!cruise.seeded) {
        cruise.x = ax;
        cruise.y = ay;
        cruise.seeded = true;
      }
      const follow = Math.min(1, dt * (reducedMotion ? 20 : 1.9));
      cruise.x += (ax - cruise.x) * follow;
      cruise.y += (ay - cruise.y) * follow;

      flightRect.w = fw;
      flightRect.h = fh;
      flightRect.x = cruise.x - fw / 2;
      flightRect.y = cruise.y - fh / 2;

      const e = landT * landT * (3 - 2 * landT);
      applyRect(
        mix(flightRect.x, tx, e),
        mix(flightRect.y, ty, e),
        mix(flightRect.w, tw, e),
        mix(flightRect.h, th, e),
      );

      /* the lid only swings open on the final approach */
      openT = smoothstep(0.45, 0.98, landT);
      flight?.classList.toggle('is-front', openT > 0.2);
      if (lidNode) {
        const a = mix(lidClosedX, lidOpenX, openT);
        lidNode.rotation.x = a;
        lidNode.position.y = lidHingeY + lidLift * (1 - Math.cos(a));
      }

      /* Orientation: while it is shut it floats lid-up, squared to the reader
         so the badge on the back of the display faces them; it then rolls down
         into the open, screen-on pose as the lid swings. The roll is mostly
         around Z, which keeps that face pointed at the camera. */
      const cruiseY = Math.sin(progress * Math.PI * 2.6) * 0.3 * amp;
      const cruiseX =
        mix(lidFacingX, 0, openT) + Math.sin(progress * Math.PI * 1.7 + 2.2) * 0.15 * amp;
      const cruiseZ = Math.sin(progress * Math.PI * 2.0 + 0.4) * 0.34 * amp;

      const parallax = finePointer && !reducedMotion && landT > 0.9;
      let hoverY = 0;
      let hoverX = 0;
      if (parallax) {
        const r = host.getBoundingClientRect();
        const nx = ((pointer.cx - r.left) / Math.max(1, r.width)) * 2 - 1;
        const ny = ((pointer.cy - r.top) / Math.max(1, r.height)) * 2 - 1;
        hoverY = clamp01(Math.abs(nx)) * Math.sign(nx) * 0.075;
        hoverX = clamp01(Math.abs(ny)) * Math.sign(ny) * 0.03;
      }

      const k = Math.min(1, dt * 5);
      tilt.y += (mix(cruiseY, hoverY, e) - tilt.y) * k;
      tilt.x += (mix(cruiseX, hoverX, openT) - tilt.x) * k;
      tilt.z += (mix(cruiseZ, 0, e) - tilt.z) * k;
      pivot.rotation.set(tilt.x, tilt.y, tilt.z);
    }

    /* ---------- render loop ---------- */
    function render() {
      const dt = Math.min(clock.getDelta(), 0.05);

      if (ready) {
        updateFlight(dt);
        pivot.updateWorldMatrix(true, true);
        camera.updateProjectionMatrix();

        const { w, h } = hostSize();
        const live = landT > 0.55;
        if (live) {
          const wasHidden = screenUi.hidden;
          updateScreenUi(w, h);
          if (wasHidden || !laidOut) {
            laidOut = measureDock();
            relayoutTabs();
          }
          const interactive = landT > 0.92;
          const inside = updatePointer(interactive);
          updateDock(interactive && inside);
          screenUi.style.opacity = smoothstep(0.55, 0.85, landT).toFixed(3);
          screenUi.classList.toggle('is-live', interactive);
          screenUi.inert = !interactive;
        } else if (!screenUi.hidden) {
          screenUi.hidden = true;
          screenUi.classList.remove('is-pointer-in', 'is-live');
        }

        renderer.render(scene, camera);
      }
      if (running) raf = requestAnimationFrame(render);
    }

    function start() {
      if (running) return;
      running = true;
      clock.getDelta();
      raf = requestAnimationFrame(render);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    sizeRenderer();
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop()), {
      threshold: 0,
    }).observe(section ?? stage);

    window.addEventListener('resize', () => {
      laidOut = false;
      relayoutTabs();
    });
  }

  init();
</script>
