---
import { useTranslations, type Lang } from '../../i18n/t';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  {
    num: '01',
    heading: t('process.step_1_heading'),
    body: t('process.step_1_body'),
    bg: '#c96442',
    fg: '#f4efe6',
    accent: '#1a1a1a',
  },
  {
    num: '02',
    heading: t('process.step_2_heading'),
    body: t('process.step_2_body'),
    bg: '#2b2b2b',
    fg: '#e6e6dd',
    accent: '#c96442',
  },
  {
    num: '03',
    heading: t('process.step_3_heading'),
    body: t('process.step_3_body'),
    bg: '#e6e6dd',
    fg: '#1a1a1a',
    accent: '#c96442',
  },
  {
    num: '04',
    heading: t('process.step_4_heading'),
    body: t('process.step_4_body'),
    bg: '#161616',
    fg: '#e6e6dd',
    accent: '#c96442',
  },
];
---
<section id="process" class="section_home-process">
  <div class="spacer-xhuge process-flow_spacer"></div>
  <div class="padding-global-5">
    <div class="process_grid-title process-flow_title-row-grid">
      <h2
        letters-slide-up=""
        text-split=""
        id="w-node-_9dedbd5f-509d-cec8-b521-beb8d357c516-0c146dc5"
        style="opacity:1"
        class="unaybv"
      >{t('process.title')}</h2>
      <div id="w-node-_9e13dbc4-bcc0-19bf-8324-5d1aa94d32d4-0c146dc5" class="process_text-wrapper">
        <div id="w-node-_59709a6b-63a7-de7e-a256-e776132d61fb-0c146dc5" class="max-width-xlarge-2">
          <div
            line-animation=""
            text-split=""
            id="w-node-_010fd501-ff9b-588e-b16e-487dcb84fcfe-0c146dc5"
            style="opacity:1"
            class="text-size-medium-2"
          >/ {t('process.subtitle')}</div>
        </div>
      </div>
    </div>
    <div class="line-divider"></div>
  </div>

  <div class="process-flow" data-process-flow>
    {steps.map((step, i) => (
      <article
        class="process-flow_panel"
        data-flow-section
        data-index={i}
        style={`--card-bg:${step.bg};--card-fg:${step.fg};--card-accent:${step.accent};`}
      >
        <div class="process-flow_inner" data-flow-inner>
          <div class="process-flow_top">
            <span class="process-flow_kicker">/ Step {step.num}</span>
            <span class="process-flow_count">{step.num} &mdash; 04</span>
          </div>

          <div class="process-flow_body">
            <h3 class="process-flow_title">{step.heading}</h3>
            <p class="process-flow_copy">{step.body}</p>
          </div>

          <div class="process-flow_bottom">
            <div class="process-flow_bignum" aria-hidden="true">{step.num}</div>
            <div class="process-flow_progress" aria-hidden="true">
              {steps.map((_, j) => (
                <span class:list={['process-flow_dot', j <= i && 'is-on']}></span>
              ))}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .process-flow_spacer {
    padding-top: 5rem !important;
  }

  .process-flow_title-row-grid {
    grid-template-columns: auto 1fr !important;
    align-items: baseline !important;
    column-gap: 1.5rem !important;
    margin-bottom: 1rem !important;
  }
  .process-flow_title-row-grid .process_text-wrapper {
    place-self: baseline start !important;
  }
  .process-flow_title-row-grid .text-size-medium-2 {
    font-size: 0.95rem !important;
    opacity: 0.55 !important;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }
  .section_home-process .line-divider {
    background-color: rgba(255, 255, 255, 0.1);
    height: 1px;
    margin-top: 1.25rem;
  }

  .process-flow {
    position: relative;
    width: 100%;
    margin-top: 2rem;
    overflow-x: clip;
  }

  .process-flow_panel {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    background-color: transparent;
  }

  .process-flow_inner {
    min-height: 100vh;
    min-height: 100svh;
    width: 100%;
    padding: clamp(2rem, 6vw, 5rem) clamp(1.5rem, 4vw, 4rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 4rem);
    background-color: var(--card-bg, #2b2b2b);
    color: var(--card-fg, #e6e6dd);
    transform-origin: bottom left;
    will-change: transform;
    box-shadow: 0 -1px 0 0 rgba(0, 0, 0, 0.18), 0 -24px 60px -24px rgba(0, 0, 0, 0.35);
  }

  .process-flow_top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--card-fg, #e6e6dd) 65%, transparent);
  }
  .process-flow_kicker {
    color: var(--card-accent, #c96442);
  }

  .process-flow_body {
    max-width: 64rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .process-flow_title {
    font-size: clamp(2.25rem, 6.5vw, 5.5rem);
    line-height: 0.95;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--card-fg, #e6e6dd);
  }

  .process-flow_copy {
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.6;
    color: color-mix(in srgb, var(--card-fg, #e6e6dd) 82%, transparent);
    max-width: 48rem;
    margin: 0;
  }

  .process-flow_bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }

  .process-flow_bignum {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(6rem, 18vw, 16rem);
    line-height: 0.8;
    font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--card-fg, #e6e6dd) 28%, transparent);
    letter-spacing: -0.05em;
    user-select: none;
  }

  .process-flow_progress {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .process-flow_dot {
    display: block;
    width: 28px;
    height: 1px;
    background: color-mix(in srgb, var(--card-fg, #e6e6dd) 22%, transparent);
    transition: background 0.4s ease;
  }
  .process-flow_dot.is-on {
    background: var(--card-accent, #c96442);
  }

  @media (max-width: 720px) {
    .process-flow_inner {
      padding: clamp(1.5rem, 6vw, 3rem) clamp(1.25rem, 4vw, 2rem);
    }
    .process-flow_top {
      font-size: 0.72rem;
    }
    .process-flow_title {
      font-size: clamp(2rem, 9vw, 3.5rem);
    }
    .process-flow_copy {
      font-size: 0.98rem;
    }
    .process-flow_bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-flow_inner {
      transform: none !important;
    }
  }
</style>

<script>
  type GsapLike = {
    set: (target: unknown, vars: Record<string, unknown>) => void;
    to: (target: unknown, vars: Record<string, unknown>) => void;
    registerPlugin: (...plugins: unknown[]) => void;
  };
  type ScrollTriggerLike = {
    create: (vars: Record<string, unknown>) => unknown;
    refresh: () => void;
  };
  const w = window as unknown as { gsap?: GsapLike; ScrollTrigger?: ScrollTriggerLike };
  const gsap = w.gsap;
  const ScrollTrigger = w.ScrollTrigger;
  const root = document.querySelector<HTMLElement>('[data-process-flow]');

  if (root && gsap && ScrollTrigger) {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    gsap.registerPlugin(ScrollTrigger);
    (ScrollTrigger as unknown as { config: (vars: Record<string, unknown>) => void }).config({
      ignoreMobileResize: true,
    });

    const panels = Array.from(root.querySelectorAll<HTMLElement>('.process-flow_panel'));

    panels.forEach((panel, i) => {
      gsap.set(panel, { zIndex: i + 1 });
      const inner = panel.querySelector<HTMLElement>('.process-flow_inner');
      if (!inner) return;

      if (!prefersReduced) {
        gsap.set(inner, { rotation: 30, transformOrigin: 'bottom left' });
        gsap.to(inner, {
          rotation: 0,
          ease: 'none',
          scrollTrigger: {
            trigger: panel,
            start: 'top bottom',
            end: 'top 25%',
            scrub: true,
          },
        });
      }

      if (i < panels.length - 1) {
        ScrollTrigger.create({
          trigger: panel,
          start: 'bottom bottom',
          end: 'bottom top',
          pin: true,
          pinSpacing: false,
        });
      }
    });

    ScrollTrigger.refresh();
  }
</script>
