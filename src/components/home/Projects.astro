---
import { useTranslations, type Lang } from '../../i18n/t';
import ProjectsScene from './ProjectsScene.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const scrollText = t('projects.scroll_text');
---
<section id="projects" data-w-id="9715c71e-33d9-4647-34bd-a0512d2456dd" class="section_home-work">
  <div class="home-work_bg-grid-wrapper">
    <div data-w-id="9715c71e-33d9-4647-34bd-a0512d2456df" class="bg-grid-trigger"></div>
    <div class="bg-grid_sticky">
      <div class="bg-grid_abs-one">
        <div class="line-vertical hide-tablet"></div>
        <div class="line-vertical hide-tablet"></div>
        <div class="line-vertical hide-mobile-landscape"></div>
        <div class="line-vertical hide-mobile-landscape"></div>
        <div class="line-vertical hide-mobile-portrait"></div>
        <div class="line-vertical hide-mobile-portrait"></div>
        <div class="line-vertical"></div>
        <div class="line-vertical"></div>
        <div class="line-vertical"></div>
        <div class="line-vertical"></div>
        <div class="line-vertical"></div>
        <div class="line-vertical"></div>
        <div class="line-vertical"></div>
      </div>
      <div class="bg-grid_abs-two">
        <div class="bg-grid_horizontal-wrapper">
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
          <div class="line-horizontal"></div>
        </div>
      </div>
    </div>
  </div>
  <div data-w-id="8e87a613-3997-2528-6522-e1c8549438e7" class="scroll-section">
    <div class="super-text one"><strong>{scrollText}</strong> - {scrollText} - <strong>{scrollText}</strong> -</div>
  </div>
  <div class="spacer-xxhuge-2"></div>
  <ProjectsScene lang={lang} />
  <div class="scene-outro">
    <div class="scene-outro_eye">{t('projects.scene.outro.eye')}</div>
    <div class="scene-outro_head">{t('projects.scene.outro.head')}</div>
  </div>
  <slot />
  <div class="spacer-xxhuge-3"></div>
</section>

<style>
  .scene-outro {
    text-align: center;
    padding: 0 32px;
    margin: -40px auto 48px;
    max-width: 720px;
    position: relative;
    z-index: 2;
  }
  .scene-outro_eye {
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(240, 237, 230, 0.42);
    margin-bottom: 14px;
  }
  .scene-outro_head {
    font-size: 44px;
    line-height: 1.15;
    color: #F0EDE6;
    font-weight: 500;
  }
</style>
