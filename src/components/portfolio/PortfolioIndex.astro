---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../../i18n/t';
import PortfolioNav from './PortfolioNav.astro';
import CrossLinkCard from './CrossLinkCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const easyngoHref = getRelativeLocaleUrl(lang, '/portfolio/easyngo/');
const stellarHref = getRelativeLocaleUrl(lang, '/portfolio/stellar-horizon/');
const redactHref = getRelativeLocaleUrl(lang, '/portfolio/redact/');
const blogHref = getRelativeLocaleUrl(lang, '/blog/');
---
<PortfolioNav lang={lang} pathname="/portfolio/" back="home" />

<section class="portfolio-section">
  <div class="container">
    <div class="portfolio-header">
      <h2 class="portfolio-title" data-scramble>{t('portfolio.index.title')}</h2>
      <p class="portfolio-subtitle" data-scramble>
        {t('portfolio.index.subtitle')}
      </p>
    </div>

    <div class="portfolio-grid">
      <a href={easyngoHref} class="project-card">
        <div class="project-image easyngo-preview" aria-hidden="true">
          <div class="easyngo-preview__grid"></div>
          <div class="easyngo-preview__wordmark">easy<span class="accent">NGO</span></div>
        </div>
        <div class="project-content">
          <h3 class="project-title" data-scramble>{t('portfolio.easyngo.card_title')}</h3>
          <p class="project-description" data-scramble>
            {t('portfolio.easyngo.card_description')}
          </p>
          <div class="project-tags">
            <span class="project-tag">{t('portfolio.easyngo.tag_1')}</span>
            <span class="project-tag">{t('portfolio.easyngo.tag_2')}</span>
            <span class="project-tag">{t('portfolio.easyngo.tag_3')}</span>
            <span class="project-tag">{t('portfolio.easyngo.tag_4')}</span>
            <span class="project-tag">{t('portfolio.easyngo.tag_5')}</span>
          </div>
          <div class="project-link" data-scramble>
            {t('portfolio.index.view_project')}
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </div>
      </a>

      <a href={redactHref} class="project-card">
        <div class="project-image redact-preview" aria-hidden="true">
          <div class="redact-preview__grid"></div>
          <div class="redact-preview__pixels">
            {Array.from({ length: 96 }).map(() => <span></span>)}
          </div>
          <div class="redact-preview__plate">
            <img src="/portfolio/redact/app-icon.png" alt="" class="redact-preview__logo" />
            <div class="redact-preview__wordmark">Faces <span class="accent">off.</span></div>
          </div>
          <span class="redact-preview__corner redact-preview__corner--tl">YOLOv11m · ANE</span>
          <span class="redact-preview__corner redact-preview__corner--br">0 BYTES SENT</span>
        </div>
        <div class="project-content">
          <h3 class="project-title" data-scramble>{t('portfolio.redact.card_title')}</h3>
          <p class="project-description" data-scramble>
            {t('portfolio.redact.card_description')}
          </p>
          <div class="project-tags">
            <span class="project-tag">{t('portfolio.redact.tag_1')}</span>
            <span class="project-tag">{t('portfolio.redact.tag_2')}</span>
            <span class="project-tag">{t('portfolio.redact.tag_3')}</span>
            <span class="project-tag">{t('portfolio.redact.tag_4')}</span>
            <span class="project-tag">{t('portfolio.redact.tag_5')}</span>
            <span class="project-tag">{t('portfolio.redact.tag_6')}</span>
            <span class="project-tag">{t('portfolio.redact.tag_7')}</span>
          </div>
          <div class="project-link" data-scramble>
            {t('portfolio.index.view_project')}
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </div>
      </a>

      <a href={stellarHref} class="project-card">
        <div
          class="project-image app-dev"
          style="background-image: url('https://res.cloudinary.com/dmokvj08w/image/upload/v1752659137/stellar-horizon-title_h0aah5.png'); background-size: cover; background-position: center;"
        ></div>
        <div class="project-content">
          <h3 class="project-title" data-scramble>{t('portfolio.stellar.card_title')}</h3>
          <p class="project-description" data-scramble>
            {t('portfolio.stellar.card_description')}
          </p>
          <div class="project-tags">
            <span class="project-tag">{t('portfolio.stellar.tag_1')}</span>
            <span class="project-tag">{t('portfolio.stellar.tag_2')}</span>
            <span class="project-tag">{t('portfolio.stellar.tag_3')}</span>
            <span class="project-tag">{t('portfolio.stellar.tag_4')}</span>
            <span class="project-tag">{t('portfolio.stellar.tag_5')}</span>
            <span class="project-tag">{t('portfolio.stellar.tag_6')}</span>
          </div>
          <div class="project-link" data-scramble>
            {t('portfolio.index.view_project')}
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </div>
      </a>
    </div>

    <CrossLinkCard
      href={blogHref}
      kicker={t('portfolio.index.cross_link_kicker')}
      title={t('portfolio.index.cross_link_title')}
      body={t('portfolio.index.cross_link_body')}
      cta={t('portfolio.index.cross_link_cta')}
    />
  </div>
</section>

<style is:global>
  /* ── easyNGO preview card (light, easyngo.de style) ──────────── */
  .project-image.easyngo-preview {
    position: relative;
    background:
      radial-gradient(22rem 14rem at 50% 50%, rgba(13, 148, 136, 0.16), transparent 65%),
      linear-gradient(180deg, #FFFFFF 0%, #F1F5F9 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .easyngo-preview__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(15, 23, 42, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(15, 23, 42, 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(ellipse at center, black 45%, transparent 90%);
    mask-image: radial-gradient(ellipse at center, black 45%, transparent 90%);
  }

  .easyngo-preview__wordmark {
    position: relative;
    z-index: 2;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 3.25rem);
    letter-spacing: -0.04em;
    line-height: 1;
    color: #0F172A;
    text-align: center;
  }
  .easyngo-preview__wordmark .accent { color: #0D9488; }

  /* ── Redact preview card (warm cream, matching the app's theme) ── */
  .project-image.redact-preview {
    background:
      radial-gradient(20rem 12rem at 75% 25%, rgba(201, 111, 74, 0.16), transparent 70%),
      linear-gradient(180deg, #FBF5EE 0%, #F3E4DC 100%);
    overflow: hidden;
  }

  .redact-preview__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(51, 36, 28, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(51, 36, 28, 0.05) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 85%);
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 85%);
  }

  .redact-preview__pixels {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(8, 1fr);
    gap: 3px;
    padding: 14px;
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(ellipse 45% 75% at 88% 50%, black 30%, transparent 80%);
    mask-image: radial-gradient(ellipse 45% 75% at 88% 50%, black 30%, transparent 80%);
  }

  .redact-preview__pixels span {
    background: rgba(201, 111, 74, 0.10);
    border-radius: 2px;
  }
  .redact-preview__pixels span:nth-child(3n)   { background: rgba(201, 111, 74, 0.22); }
  .redact-preview__pixels span:nth-child(5n)   { background: rgba(51, 36, 28, 0.06); }
  .redact-preview__pixels span:nth-child(7n+1) { background: rgba(229, 144, 107, 0.42); }
  .redact-preview__pixels span:nth-child(11n)  { background: rgba(51, 36, 28, 0.10); }
  .redact-preview__pixels span:nth-child(13n)  { background: rgba(201, 111, 74, 0.55); }

  .redact-preview__plate {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    z-index: 2;
  }

  .redact-preview__logo {
    width: 58px;
    height: auto;
    border-radius: 13px;
    filter: drop-shadow(0 10px 24px rgba(51, 36, 28, 0.28));
  }

  .redact-preview__wordmark {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -0.04em;
    color: #241811;
  }
  .redact-preview__wordmark .accent { color: #C96F4A; }

  .redact-preview__corner {
    position: absolute;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(51, 36, 28, 0.42);
    z-index: 2;
  }
  .redact-preview__corner--tl { top: 10px; left: 14px; }
  .redact-preview__corner--br { bottom: 10px; right: 14px; }
</style>
