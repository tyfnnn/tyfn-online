---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../../i18n/t';

interface Props {
  lang: Lang;
  pathname: string;
  back: 'home' | 'portfolio' | 'blog';
}

const { lang, pathname, back } = Astro.props;
const t = useTranslations(lang);

const backTargets = {
  home: { path: '/', label: t('portfolio.back_to_home') },
  portfolio: { path: '/portfolio/', label: t('portfolio.back_to_portfolio') },
  blog: { path: '/blog/', label: t('blog.back_to_blog') },
} as const;
const backHref = getRelativeLocaleUrl(lang, backTargets[back].path);
const backLabel = backTargets[back].label;
const homeHref = getRelativeLocaleUrl(lang, '/');

const otherLocale: Lang = lang === 'en' ? 'de' : 'en';
const otherLocaleHref = getRelativeLocaleUrl(otherLocale, pathname);
---
<nav class="pnav">
  <span class="pnav-glass" aria-hidden="true"></span>
  <div class="pnav-grid">
    <a href={backHref} class="pnav-back">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span data-scramble>{backLabel}</span>
    </a>
    <a href={homeHref} class="pnav-logo">TAYFUN ILKER</a>
    <div class="pnav-right">
      <a href={otherLocaleHref} class="pnav-lang" aria-label="Switch language" data-lang-switch>EN | DE</a>
    </div>
  </div>
</nav>

<style>
  .pnav {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1.5rem 0;
    background: transparent;
  }

  /* Glass layer — fades in once the page is scrolled. */
  .pnav-glass {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: color-mix(in srgb, var(--bg-primary, #1A1A1A) 62%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),   /* top edge highlight */
      inset 0 -1px 0 rgba(0, 0, 0, 0.10),         /* bottom hairline */
      0 10px 30px -18px rgba(0, 0, 0, 0.30);      /* soft drop */
    transition: opacity 0.28s ease;
  }

  /* Faint diagonal sheen — gives the surface a "glass" highlight band. */
  .pnav-glass::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      transparent 0%,
      rgba(255, 255, 255, 0.06) 38%,
      rgba(255, 255, 255, 0.10) 50%,
      rgba(255, 255, 255, 0.04) 62%,
      transparent 100%
    );
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .pnav.scrolled .pnav-glass { opacity: 1; }

  .pnav-grid { position: relative; }

  .pnav-grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .pnav-back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    color: var(--accent-color, #DB4A2B);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .pnav-back:hover {
    color: var(--text-light, #E6E6DD);
  }

  .pnav-back svg {
    margin-right: 0.5rem;
    width: 16px;
    height: 16px;
  }

  .pnav-logo {
    justify-self: center;
    color: var(--text-light, #E6E6DD);
    text-decoration: none;
    font-family: 'Archivo Black', sans-serif;
    font-size: 0.95rem;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    padding-left: 0.5em;
    transition: color 0.3s ease;
  }

  .pnav-logo:hover {
    color: var(--accent-color, #DB4A2B);
  }

  .pnav-right {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }

  .pnav-lang {
    color: var(--accent-color, #DB4A2B);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    transition: color 0.3s ease;
  }

  .pnav-lang:hover {
    color: var(--text-light, #E6E6DD);
  }

  @media (max-width: 768px) {
    .pnav-grid {
      padding: 0 1rem;
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "back logo right";
    }
    .pnav-back { grid-area: back; }
    .pnav-right { grid-area: right; }
    .pnav-logo {
      grid-area: logo;
      justify-self: center;
      font-size: 0.8rem;
      letter-spacing: 0.35em;
      word-spacing: 100vw;
      text-align: center;
      line-height: 1.4;
    }
    .pnav-back span { display: none; }
    .pnav-back svg { margin-right: 0; width: 20px; height: 20px; }
  }
</style>

<script is:inline>
  (() => {
    const nav = document.querySelector('.pnav');
    if (!nav) return;
    const sync = () => nav.classList.toggle('scrolled', window.scrollY > 8);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  })();
</script>
