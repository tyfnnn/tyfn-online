---
import { useTranslations, type Lang } from '../../i18n/t';
import PortfolioNav from './PortfolioNav.astro';
import bodyEn from '../../snippets/portfolio/stellar-detail-en.html?raw';
import bodyDe from '../../snippets/portfolio/stellar-detail-de.html?raw';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const body = lang === 'de' ? bodyDe : bodyEn;
---
<PortfolioNav lang={lang} pathname="/portfolio/stellar-horizon/" back="portfolio" status={t('portfolio.stellar.status')} />
<Fragment set:html={body} />
