---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Seo from '../components/Seo.astro';
import LocalePreference from '../components/LocalePreference.astro';
import CustomCursor from '../components/CustomCursor.astro';
import LangScramble from '../components/LangScramble.astro';
import FabMenu from '../components/FabMenu.astro';
import Chatbot from '../components/Chatbot.astro';
import LiquidGlass from '../components/ui/LiquidGlass.astro';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'de';
  /** Logischer Pfad ohne Locale-Präfix, z. B. "/" oder "/portfolio/" */
  pathname: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: unknown;
  /** data-wf-page aus Original-HTML */
  wfPage?: string;
  /** data-wf-site aus Original-HTML */
  wfSite?: string;
  /** Zusätzliche body-Klasse wie im Original (z. B. "body-change") */
  bodyClass?: string;
}

const {
  title,
  description,
  lang,
  pathname,
  image,
  imageAlt,
  jsonLd,
  wfPage = '675f1f0e41c3cbd6e18005b8',
  wfSite = '675f1f0e41c3cbd6e1800581',
  bodyClass,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const enHref = new URL(getRelativeLocaleUrl('en', pathname), Astro.site).toString();
const deHref = new URL(getRelativeLocaleUrl('de', pathname), Astro.site).toString();
const otherLocale = lang === 'en' ? 'de' : 'en';
const otherLocaleUrl = getRelativeLocaleUrl(otherLocale, pathname);
---
<!DOCTYPE html>
<html
  lang={lang}
  data-wf-domain="www.tyfn.online"
  data-wf-page={wfPage}
  data-wf-site={wfSite}
>
<head>
  <LocalePreference lang={lang} enHref={enHref} deHref={deHref} />
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <Seo
    title={title}
    description={description}
    lang={lang}
    image={image}
    imageAlt={imageAlt}
    jsonLd={jsonLd}
  />

  <link rel="dns-prefetch" href="https://use.typekit.net" />
  <link
    rel="preload"
    as="image"
    href="/assets/tyfn-ilkr-profile-500w.jpeg"
    imagesrcset="/assets/tyfn-ilkr-profile-500w.jpeg 500w, /assets/tyfn-ilkr-profile-700w.jpeg 724w"
    imagesizes="(max-width: 767px) 35vw, (max-width: 991px) 21vw, 18vw"
    fetchpriority="high"
  />

  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={enHref} />
  <link rel="alternate" hreflang="de" href={deHref} />
  <link rel="alternate" hreflang="x-default" href={enHref} />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={lang === 'de' ? 'Tayfun Ilker — Blog (DE)' : 'Tayfun Ilker — Blog (EN)'}
    href={getRelativeLocaleUrl(lang, '/rss.xml')}
  />

  <link href="/style.css" rel="stylesheet" type="text/css" />
  <link href="/assets/t-icon.png" rel="shortcut icon" type="image/x-icon" />
  <link href="/assets/tyfn-code&design-Logo.png" rel="apple-touch-icon" />

  <script is:inline>
    !function (o, c) {
      var n = c.documentElement, t = " w-mod-";
      n.className += t + "js";
      ("ontouchstart" in o || (o.DocumentTouch && c instanceof DocumentTouch)) && (n.className += t + "touch");
    }(window, document);
  </script>

  <script is:inline define:vars={{ otherLocaleUrl }}>
    window.__i18nOtherHref = otherLocaleUrl;
  </script>

  <style is:inline>
    @media (pointer: fine) {
      html, body, *, *::before, *::after { cursor: none !important; }
    }
  </style>

  <slot name="head-extra" />
</head>
<body class={bodyClass}>
  <CustomCursor />
  <FabMenu lang={lang} />
  <LiquidGlass />
  <slot />

  <script
    is:inline
    src="/javascript/jquery-3.5.1.min.dc5e7f18c8.js"
    type="text/javascript"
    integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
    crossorigin="anonymous"
  ></script>
  <script
    is:inline
    src="/javascript/webflow.afcc14f7b15c722fc9b2d65f191699dc.js"
    type="text/javascript"
  ></script>
  <script is:inline src="/javascript/gsap.js"></script>
  <script is:inline src="/javascript/scroll-trigger.min.js"></script>
  <script is:inline src="/javascript/split-type.js"></script>
  <script is:inline src="/javascript/lenis.js"></script>

  <slot name="scripts-after" />
  <LangScramble />
  <Chatbot lang={lang} />
</body>
</html>
