---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Seo from '../components/Seo.astro';
import CustomCursor from '../components/CustomCursor.astro';
import LangScramble from '../components/LangScramble.astro';
import FabMenu from '../components/FabMenu.astro';

interface Props {
  title: string;
  description?: string;
  lang: 'en' | 'de';
  /** Logischer Pfad ohne Locale-Präfix, z. B. "/portfolio/" oder "/portfolio/zentrik/" */
  pathname: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: unknown;
}

const { title, description = '', lang, pathname, image, imageAlt, jsonLd } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const enHref = new URL(getRelativeLocaleUrl('en', pathname), Astro.site).toString();
const deHref = new URL(getRelativeLocaleUrl('de', pathname), Astro.site).toString();
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}

  <Seo
    title={title}
    description={description}
    lang={lang}
    image={image}
    imageAlt={imageAlt}
    jsonLd={jsonLd}
  />

  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={enHref} />
  <link rel="alternate" hreflang="de" href={deHref} />
  <link rel="alternate" hreflang="x-default" href={enHref} />

  <link href="/assets/t-icon.png" rel="shortcut icon" type="image/x-icon" />

  <style is:inline>
    @media (pointer: fine) {
      html, body, *, *::before, *::after { cursor: none !important; }
    }
  </style>

  <slot name="head-extra" />
</head>
<body>
  <CustomCursor />
  <FabMenu lang={lang} />
  <slot />
  <slot name="scripts-after" />
  <LangScramble />
</body>
</html>
