---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import NotFound from '../components/NotFound.astro';
import head from '../snippets/portfolio/index-head.html?raw';
import { useTranslations } from '../i18n/t';

const lang = 'en' as const;
const t = useTranslations(lang);
---
<PortfolioLayout
  lang={lang}
  pathname="/404/"
  title={t('notfound.page_title')}
  description={t('notfound.page_description')}
>
  <Fragment slot="head-extra">
    <script is:inline>
      if (location.pathname.startsWith('/de/') && location.pathname !== '/de/404/') {
        location.replace('/de/404/');
      }
    </script>
    <Fragment set:html={head} />
  </Fragment>
  <NotFound lang={lang} />
</PortfolioLayout>
