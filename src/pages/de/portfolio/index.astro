---
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import PortfolioIndex from '../../../components/portfolio/PortfolioIndex.astro';
import head from '../../../snippets/de/portfolio-index-head.html?raw';
import { useTranslations } from '../../../i18n/t';

const lang = 'de' as const;
const t = useTranslations(lang);
---
<PortfolioLayout
  lang={lang}
  pathname="/portfolio/"
  title={t('portfolio.index.page_title')}
  description={t('portfolio.index.page_description')}
>
  <Fragment slot="head-extra" set:html={head} />
  <PortfolioIndex lang={lang} />
</PortfolioLayout>
