---
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import StellarDetail from '../../../components/portfolio/StellarDetail.astro';
import head from '../../../snippets/portfolio/stellar-head.html?raw';
import scripts from '../../../snippets/portfolio/stellar-scripts.html?raw';

const lang = 'de' as const;
---
<PortfolioLayout
  lang={lang}
  pathname="/portfolio/stellar-horizon/"
  title="Stellar Horizon - Explore the Universe - TAYFUN ILKER"
  description="Interaktive iOS-App für Weltraum-Exploration mit 3D-Erde, ISS-Live-Tracker, Astronomie-Galerie und Space-News."
>
  <Fragment slot="head-extra" set:html={head} />
  <StellarDetail lang={lang} />
  <Fragment slot="scripts-after" set:html={scripts} />
</PortfolioLayout>
