---
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import head from '../../../snippets/de/portfolio-zentrik-head.html?raw';
import body from '../../../snippets/de/portfolio-zentrik-body.html?raw';
import scripts from '../../../snippets/de/portfolio-zentrik-scripts.html?raw';
---
<PortfolioLayout
  lang="de"
  pathname="/portfolio/zentrik/"
  title="Zentrik NGO Management App - TAYFUN ILKER"
