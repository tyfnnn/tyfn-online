---
import BaseLayout from '../layouts/BaseLayout.astro';
import homeHead from '../snippets/en/home-head.html?raw';
import homeScripts from '../snippets/en/home-scripts.html?raw';
import Navbar from '../components/home/Navbar.astro';
import Hero from '../components/home/Hero.astro';
import Footer from '../components/home/Footer.astro';

const lang = (Astro.url.searchParams.get('lang') === 'de' ? 'de' : 'en') as 'en' | 'de';
---
<BaseLayout
  lang={lang}
  pathname="/"
  title="Phase B test"
  description="Temporary smoke-test for Navbar + Footer components"
  bodyClass="body-change"
>
  <Fragment slot="head-extra" set:html={homeHead} />
  <Navbar lang={lang} pathname="/" />
  <div class="wrapper">
    <Hero lang={lang} />
    <Footer lang={lang} />
  </div>
  <Fragment slot="scripts-after" set:html={homeScripts} />
</BaseLayout>
