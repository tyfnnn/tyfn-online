---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import EasyngoDetail from '../../components/portfolio/EasyngoDetail.astro';
import { useTranslations } from '../../i18n/t';
import { SITE_URL, PERSON_NAME } from '../../i18n/site';
import head from '../../snippets/portfolio/easyngo-head.html?raw';

const lang = 'en' as const;
const t = useTranslations(lang);
const pathname = '/portfolio/easyngo/';
const image = 'https://res.cloudinary.com/dmokvj08w/image/upload/v1752658414/zentrik-accounting_hqbrnv.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: t('portfolio.easyngo.card_title'),
  description: t('portfolio.easyngo.card_description'),
  url: `${SITE_URL}${pathname}`,
  image,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'iOS, Android, macOS, Windows, Linux',
  author: { '@type': 'Person', name: PERSON_NAME, url: `${SITE_URL}/` },
};
---
<PortfolioLayout
  lang={lang}
  pathname={pathname}
  title={t('portfolio.easyngo.page_title')}
  description={t('portfolio.easyngo.page_description')}
  image={image}
  imageAlt={t('portfolio.easyngo.card_title')}
  jsonLd={jsonLd}
>
  <Fragment slot="head-extra" set:html={head} />
  <EasyngoDetail lang={lang} />
</PortfolioLayout>
